PUBLIC_SUPABASE_URL=

# Mendukung kunci publik baru atau lama (Anon Key)
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Never expose this value with a PUBLIC_ prefix.
# Mendukung kunci rahasia baru atau lama (Service Role Key)
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
