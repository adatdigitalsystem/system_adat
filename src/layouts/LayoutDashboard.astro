---
import '../styles/global.css';

const { title, role = 'KRAMA' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-100 min-h-screen font-sans antialiased text-slate-800">
    
    <!-- Navbar Utama -->
    <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        
        <!-- Logo & Judul Banjar -->
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500 flex items-center justify-center font-black text-slate-950 text-lg shadow">
            🕉️️
          </div>
          <div>
            <span class="text-xs font-bold tracking-wider text-amber-400 uppercase">Banjar Adat</span>
            <h1 class="text-sm font-extrabold text-white leading-none">Dharma Sadhu Dukuh</h1>
          </div>
        </div>

        <!-- Menu Navigasi Dinamis Berdasarkan Role -->
        <nav class="hidden md:flex items-center gap-1">
          {role === 'ADMIN' && (
            <a href="/admin/dashboard" class={`px-3 py-2 rounded-xl text-xs font-bold transition ${currentPath.startsWith('/admin') ? 'bg-amber-500 text-slate-950' : 'text-slate-300 hover:bg-slate-800'}`}>
              Panel Admin
            </a>
          )}
          {(role === 'ADMIN' || role === 'BENDAHARA') && (
            <a href="/bendahara/verifikasi" class={`px-3 py-2 rounded-xl text-xs font-bold transition ${currentPath.startsWith('/bendahara') ? 'bg-amber-500 text-slate-950' : 'text-slate-300 hover:bg-slate-800'}`}>
              Portal Bendahara
            </a>
          )}
          {(role === 'ADMIN' || role === 'PENGURUS') && (
            <a href="/pengurus/dashboard" class={`px-3 py-2 rounded-xl text-xs font-bold transition ${currentPath.startsWith('/pengurus') ? 'bg-amber-500 text-slate-950' : 'text-slate-300 hover:bg-slate-800'}`}>
              Dashboard Pengurus
            </a>
          )}
          {(role === 'ADMIN' || role === 'KEPALA_REGU') && (
            <a href="/kepalaregu" class={`px-3 py-2 rounded-xl text-xs font-bold transition ${currentPath.startsWith('/kepalaregu') ? 'bg-amber-500 text-slate-950' : 'text-slate-300 hover:bg-slate-800'}`}>
              Portal Kepala Regu
            </a>
          )}

        </nav>

        <!-- Tombol Keluar Tunggal -->
        <form action="/api/auth/logout" method="POST" class="m-0">
          <button type="submit" class="px-3.5 py-2 bg-red-500/20 hover:bg-red-600 text-red-400 hover:text-white text-xs font-bold rounded-xl border border-red-500/30 transition">
            Keluar
          </button>
        </form>
      </div>
    </header>

    <!-- Konten Utama -->
    <main class="py-6">
      <slot />
    </main>

    <footer class="text-center py-6 text-xs text-slate-400 border-t border-slate-200 mt-12">
      &copy; 2026 Banjar Adat Dharma Sadhu Dukuh. All Rights Reserved.
    </footer>
  </body>
</html>