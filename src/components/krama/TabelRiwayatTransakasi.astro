---
interface Transaksi {
  tanggal_kejadian: string;
  tanggal_bayar: string;
  keterangan: string;
  nominal: number;
  status: string;
  status_label: string;
}

const { items } = Astro.props as { items: Transaksi[] };
---

<div class="overflow-x-auto">
  <table class="w-full text-sm text-left text-slate-600">
    <thead class="text-xs uppercase bg-slate-100 text-slate-700">
      <tr>
        <th class="px-4 py-3">Tanggal Acara / Kejadian</th>
        <th class="px-4 py-3">Keterangan / Detail</th>
        <th class="px-4 py-3 text-right">Nominal</th>
        <th class="px-4 py-3">Tanggal Bayar</th>
        <th class="px-4 py-3 text-center">Status</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200">
      {items.map((item) => (
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-3 whitespace-nowrap font-medium text-slate-800">
            {item.tanggal_kejadian}
          </td>
          <td class="px-4 py-3">{item.keterangan}</td>
          <td class="px-4 py-3 text-right font-semibold text-slate-900">
            Rp {item.nominal.toLocaleString('id-ID')}
          </td>
          <td class="px-4 py-3 whitespace-nowrap text-xs text-slate-500">
            {item.tanggal_bayar}
          </td>
          <td class="px-4 py-3 text-center">
            <span class={`inline-block px-2.5 py-1 text-xs font-semibold rounded-full ${
              item.status === 'PAID_TO_TREASURER' ? 'bg-emerald-100 text-emerald-800' :
              item.status === 'COLLECTED_BY_REGU' ? 'bg-blue-100 text-blue-800' :
              'bg-amber-100 text-amber-800'
            }`}>
              {item.status_label}
            </span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>