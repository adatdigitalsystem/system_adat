---
interface Anggota {
  id: string;
  nama: string;
}

const { anggotaList } = Astro.props as { anggotaList: Anggota[] };
---

<div class="bg-white p-5 rounded-xl shadow-md border border-slate-100 space-y-4">
  <h3 class="text-lg font-bold text-slate-800">Input Denda Adat (Dosa)</h3>
  <form action="/api/denda" method="POST" class="space-y-3">
    <div>
      <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Pilih Krama</label>
      <select name="anggota_id" class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-red-500">
        <option value="">-- Pilih Anggota --</option>
        {anggotaList.map((a) => (
          <option value={a.id}>{a.nama}</option>
        ))}
      </select>
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Jenis Pelanggaran / Ketidakhadiran</label>
      <input type="text" name="jenis_pelanggaran" placeholder="Contoh: Absen Kerja Bakti Pura Desa" class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-red-500" required />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <div>
        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Tanggal Kejadian</label>
        <input type="date" name="tanggal_kejadian" class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-red-500" required />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Nominal Denda (Rp)</label>
        <input type="number" name="nominal_denda" placeholder="10000" class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-red-500" required />
      </div>
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Keterangan Tambahan</label>
      <textarea name="keterangan" rows="2" placeholder="Alasan ketidakhadiran / Catatan tambahan" class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-red-500"></textarea>
    </div>

    <button type="submit" class="w-full bg-red-700 hover:bg-red-800 text-white font-bold py-2 rounded-lg text-sm shadow transition">
      Simpan Catatan Denda
    </button>
  </form>
</div>