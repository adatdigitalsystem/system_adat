---
interface Props {
  targetId: string;
  title: string;
  label?: string;
}

const { targetId, title, label = 'Cetak Laporan' } = Astro.props;
---

<button
  type="button"
  class="no-print inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 transition hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-blue-600"
  data-print-report
  data-print-target={targetId}
  data-print-title={title}
>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
    <path stroke-linecap="round" stroke-linejoin="round" d="M7 8V3h10v5M7 17H5a2 2 0 0 1-2-2v-4a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v4a2 2 0 0 1-2 2h-2M7 14h10v7H7z" />
    <path stroke-linecap="round" d="M18 11h.01" />
  </svg>
  {label}
</button>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-print-report]');
    if (!button) return;

    const target = document.getElementById(button.dataset.printTarget || '');
    if (!target) return;

    const reportWindow = window.open('', '_blank');
    if (!reportWindow) {
      window.print();
      return;
    }

    const report = target.cloneNode(true) as HTMLElement;
    report.classList.remove('hidden', 'no-print');
    report.querySelectorAll<HTMLElement>('[data-report-page-hidden]').forEach((element) => {
      element.classList.remove('hidden');
      element.removeAttribute('data-report-page-hidden');
    });
    report.querySelectorAll('.no-print, .print-hide, form, input, select, textarea').forEach((element) => element.remove());
    report.querySelectorAll('button').forEach((button) => {
      button.replaceWith(report.ownerDocument.createTextNode(button.textContent?.trim() || ''));
    });
    report.querySelectorAll('.hidden').forEach((element) => element.remove());

    const stylesheetLinks = Array.from(document.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]'))
      .map((link) => `<link rel="stylesheet" href="${link.href}">`)
      .join('');
    const inlineStyles = Array.from(document.querySelectorAll<HTMLStyleElement>('style'))
      .map((style) => `<style>${style.textContent || ''}</style>`)
      .join('');
    const reportTitle = button.dataset.printTitle || 'Laporan Banjar Adat';
    const escapedTitle = reportTitle.replace(/[&<>"']/g, (character) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    })[character] || character);
    const printedAt = new Intl.DateTimeFormat('id-ID', { dateStyle: 'long', timeStyle: 'short' }).format(new Date());

    reportWindow.document.open();
    reportWindow.document.write(`<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${escapedTitle}</title>${stylesheetLinks}${inlineStyles}<style>
      @page { size: A4 portrait; margin: 14mm; }
      body { padding: 0; color: #111827; background: white; font: 11px/1.45 Arial, sans-serif; }
      h1 { margin: 0 0 4px; font-size: 18px; }
      .print-meta { margin: 0 0 14px; color: #4b5563; font-size: 10px; }
      table { width: 100%; border-collapse: collapse; }
      th, td { border: 1px solid #cbd5e1; padding: 6px; color: #111827 !important; text-align: left; vertical-align: top; }
      thead { display: table-header-group; }
      tr { break-inside: avoid; }
      img { max-width: 60px; max-height: 60px; }
      .overflow-x-auto, .overflow-hidden { overflow: visible !important; }
      .rounded-xl, .rounded-2xl { border-radius: 0 !important; }
      .shadow, .shadow-sm, .shadow-lg, .shadow-2xl { box-shadow: none !important; }
      .bg-slate-900, .bg-white, .bg-amber-50, .bg-emerald-50, .bg-red-50 { background: white !important; }
      .text-white, .text-slate-100, .text-slate-200 { color: #111827 !important; }
    </style></head><body><header><h1>${escapedTitle}</h1><p class="print-meta">Banjar Adat Dharma Sadhu Dukuh · Dicetak ${printedAt}</p></header><main>${report.outerHTML}</main></body></html>`);
    reportWindow.document.close();

    const printWhenReady = () => {
      const images = Array.from(reportWindow.document.images);
      Promise.all(images.map((image) => image.decode().catch(() => undefined))).then(() => {
        reportWindow.focus();
        reportWindow.print();
      });
    };
    reportWindow.addEventListener('load', printWhenReady, { once: true });
    window.setTimeout(printWhenReady, 1200);
  });
</script>