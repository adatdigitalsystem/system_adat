---
import LayoutDashboard from '../../layouts/LayoutDashboard.astro';
import { supabase } from '../../lib/supabase';
import { createSupabaseAdminClient } from '../../lib/supabaseAdmin';
import { labelStatusKeanggotaan } from '../../lib/utils';
import PrintReportButton from '../../components/common/PrintReportButton.astro';

let errorMessage = '';
let successMessage = '';
const formatRupiah = (val: number) =>
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val || 0);
const isValidDate = (value: string) => /^\d{4}-\d{2}-\d{2}$/.test(value) && !Number.isNaN(Date.parse(`${value}T00:00:00`));

if (Astro.request.method === 'POST') {
  try {
    const accessToken = Astro.cookies.get('sb-access-token')?.value;
    if (!accessToken) throw new Error('Sesi login tidak ditemukan. Silakan login kembali.');

    const { data: { user }, error: userError } = await supabase.auth.getUser(accessToken);
    if (userError || !user) throw new Error('Sesi login tidak valid. Silakan login kembali.');

    const { data: actor, error: actorError } = await supabase
      .from('anggota')
      .select('id, role')
      .eq('user_id', user.id)
      .maybeSingle();
    if (actorError) throw actorError;
    if (!actor) throw new Error('Profil petugas tidak ditemukan.');

    const actorRole = (actor?.role || '').toUpperCase().replace(/[\s_-]/g, '');
    if (!['ADMIN', 'BENDAHARA'].includes(actorRole)) {
      throw new Error('Aksi ini hanya dapat dilakukan oleh Admin atau Bendahara.');
    }

    const privilegedSupabase = createSupabaseAdminClient();
    const formData = await Astro.request.formData();
    const action = formData.get('action');

    if (action === 'posting_saldo_awal') {
      const anggotaId = formData.get('anggota_id')?.toString();
      const nominal = Number(formData.get('nominal'));
      const tanggal = formData.get('tanggal')?.toString();
      const keterangan = formData.get('keterangan')?.toString().trim() || 'Saldo awal kewajiban';
      if (!anggotaId || !tanggal || !isValidDate(tanggal) || !Number.isFinite(nominal) || nominal <= 0) {
        throw new Error('Pilih krama, tanggal saldo awal, dan nominal yang valid.');
      }

      const { data: existingBills, error: existingBillsError } = await privilegedSupabase
        .from('tagihan_krama')
        .select('id, keterangan')
        .eq('anggota_id', anggotaId);
      if (existingBillsError) throw existingBillsError;
      if ((existingBills || []).some((bill) => (bill.keterangan || '').startsWith('[SALDO AWAL]'))) {
        throw new Error('Saldo awal untuk krama ini sudah pernah diposting. Gunakan catatan koreksi jika perlu penyesuaian.');
      }

      const { data: member, error: memberError } = await privilegedSupabase
        .from('anggota')
        .select('nama_lengkap')
        .eq('id', anggotaId)
        .maybeSingle();
      if (memberError) throw memberError;
      if (!member) throw new Error('Data krama tidak ditemukan.');

      const { error } = await privilegedSupabase.from('tagihan_krama').insert({
        anggota_id: anggotaId,
        total_nominal: nominal,
        nominal,
        jumlah_dibayar: 0,
        status_bayar: 'BELUM_LUNAS',
        tanggal_kejadian: tanggal,
        keterangan: `[SALDO AWAL] ${keterangan}`,
      });
      if (error) throw error;
      successMessage = `Saldo awal ${formatRupiah(nominal)} untuk ${member.nama_lengkap} berhasil diposting sebagai debet kewajiban.`;
    }
    else if (action === 'catat_pengeluaran_kas') {
      const tanggal = formData.get('tanggal')?.toString();
      const kategori = formData.get('kategori')?.toString() || '';
      const penerima = formData.get('penerima')?.toString().trim() || '';
      const keterangan = formData.get('keterangan')?.toString().trim() || '';
      const nominal = Number(formData.get('nominal'));
      const metode = formData.get('metode_pembayaran')?.toString() || 'TUNAI';
      const buktiUrl = formData.get('bukti_url')?.toString().trim() || null;
      const kategoriValid = ['BANTUAN_DUKA', 'BANTUAN_PERNIKAHAN', 'OPERASIONAL', 'LAINNYA'].includes(kategori);
      if (!tanggal || !isValidDate(tanggal) || !kategoriValid || !penerima || !keterangan || !Number.isFinite(nominal) || nominal <= 0) {
        throw new Error('Lengkapi tanggal, kategori, penerima, keterangan, dan nominal pengeluaran yang valid.');
      }
      if (buktiUrl) {
        let parsedBukti: URL;
        try {
          parsedBukti = new URL(buktiUrl);
        } catch {
          throw new Error('Link bukti harus berupa URL yang valid.');
        }
        if (!['http:', 'https:'].includes(parsedBukti.protocol)) throw new Error('Link bukti harus menggunakan HTTP atau HTTPS.');
      }

      const { error } = await privilegedSupabase.from('transaksi_kas').insert({
        tanggal,
        arah: 'KELUAR',
        kategori,
        penerima,
        keterangan,
        nominal,
        metode_pembayaran: metode,
        bukti_url: buktiUrl,
        created_by: actor.id,
      });
      if (error) throw error;
      successMessage = `Pengeluaran ${formatRupiah(nominal)} untuk ${penerima} berhasil dicatat.`;
    }
    else if (action === 'catat_pemasukan_kas' || action === 'posting_saldo_awal_kas') {
      const isOpeningBalance = action === 'posting_saldo_awal_kas';
      const tanggal = formData.get('tanggal')?.toString() || '';
      const penerima = formData.get('sumber')?.toString().trim() || '';
      const keterangan = formData.get('keterangan')?.toString().trim() || '';
      const nominal = Number(formData.get('nominal'));
      const metode = formData.get('metode_pembayaran')?.toString() || 'TUNAI';
      const buktiUrl = formData.get('bukti_url')?.toString().trim() || null;
      const requestedCategory = formData.get('kategori')?.toString() || 'PEMASUKAN_LAIN';
      const kategori = isOpeningBalance ? 'SALDO_AWAL_KAS' : requestedCategory;
      const incomeCategories = ['PEMASUKAN_LAIN', 'SUMBANGAN', 'PENGEMBALIAN_DANA'];

      if (!tanggal || !isValidDate(tanggal) || !penerima || !keterangan || !Number.isFinite(nominal) || nominal < 0 || (!isOpeningBalance && nominal === 0)) {
        throw new Error('Lengkapi tanggal, sumber dana, keterangan, dan nominal kas masuk yang valid.');
      }
      if (isOpeningBalance) {
        const { data: existingOpening, error: openingError } = await privilegedSupabase
          .from('transaksi_kas')
          .select('id')
          .eq('arah', 'SALDO_AWAL')
          .eq('kategori', 'SALDO_AWAL_KAS')
          .limit(1)
          .maybeSingle();
        if (openingError) throw openingError;
        if (existingOpening) throw new Error('Saldo awal kas sudah pernah diposting. Gunakan catatan koreksi untuk penyesuaian.');
      } else if (!incomeCategories.includes(kategori)) {
        throw new Error('Pilih kategori pemasukan kas yang valid.');
      }
      if (buktiUrl) {
        let parsedBukti: URL;
        try {
          parsedBukti = new URL(buktiUrl);
        } catch {
          throw new Error('Link bukti harus berupa URL yang valid.');
        }
        if (!['http:', 'https:'].includes(parsedBukti.protocol)) throw new Error('Link bukti harus menggunakan HTTP atau HTTPS.');
      }

      const { error } = await privilegedSupabase.from('transaksi_kas').insert({
        tanggal,
        arah: isOpeningBalance ? 'SALDO_AWAL' : 'MASUK',
        kategori,
        penerima,
        keterangan,
        nominal,
        metode_pembayaran: metode,
        bukti_url: buktiUrl,
        created_by: actor.id,
      });
      if (error) throw error;
      successMessage = isOpeningBalance
        ? `Saldo awal kas ${formatRupiah(nominal)} per ${tanggal} berhasil diposting.`
        : `Pemasukan kas ${formatRupiah(nominal)} dari ${penerima} berhasil dicatat.`;
    }
    else if (action === 'verifikasi_setoran') {
      const setoranId = formData.get('setoran_id')?.toString();
      const status = formData.get('status')?.toString();
      if (!setoranId || !['VERIFIED', 'REJECTED'].includes(status || '')) {
        throw new Error('Setoran atau status verifikasi tidak valid.');
      }

      const { error } = await privilegedSupabase
        .from('setoran_regu')
        .update({
          status_verifikasi: status,
          tanggal_verifikasi: new Date().toISOString(),
        })
        .eq('id', setoranId);

      if (error) throw error;

      const { data: setoranPayments, error: setoranPaymentsError } = await privilegedSupabase
        .from('riwayat_pembayaran_cicilan')
        .select('tagihan_krama_id')
        .eq('setoran_regu_id', setoranId);
      if (setoranPaymentsError) throw setoranPaymentsError;

      const affectedTagihanIds = [...new Set((setoranPayments || [])
        .map((payment) => payment.tagihan_krama_id)
        .filter((id): id is string => Boolean(id)))];

      if (status === 'REJECTED') {
        const { error: releasePaymentsError } = await privilegedSupabase
          .from('riwayat_pembayaran_cicilan')
          .update({ setoran_regu_id: null })
          .eq('setoran_regu_id', setoranId);
        if (releasePaymentsError) throw releasePaymentsError;
      }

      for (const tagihanId of affectedTagihanIds) {
        const { data: tagihan, error: tagihanError } = await privilegedSupabase
          .from('tagihan_krama')
          .select('total_nominal, nominal, jumlah_dibayar')
          .eq('id', tagihanId)
          .maybeSingle();
        if (tagihanError) throw tagihanError;
        if (!tagihan) continue;

        const total = Number(tagihan.total_nominal ?? tagihan.nominal ?? 0);
        const collected = Number(tagihan.jumlah_dibayar || 0);
        let nextStatus: string | null = null;
        if (status === 'VERIFIED' && collected >= total) nextStatus = 'LUNAS';
        if (status === 'REJECTED') {
          nextStatus = collected >= total ? 'COLLECTED_BY_REGU' : collected > 0 ? 'PARTIAL' : 'BELUM_LUNAS';
        }
        if (nextStatus) {
          const { error: statusError } = await privilegedSupabase
            .from('tagihan_krama')
            .update({ status_bayar: nextStatus, updated_at: new Date().toISOString() })
            .eq('id', tagihanId);
          if (statusError) throw statusError;
        }
      }

      successMessage = `Setoran berhasil diverifikasi menjadi ${status}!`;
    }
    else if (action === 'simpan_denda_cicilan') {
      const anggota_id = formData.get('anggota_id');
      const total_nominal = formData.get('nominal');
      const jenis = formData.get('jenis');
      const keterangan = formData.get('keterangan');
      const tanggal_kejadian = formData.get('tanggal_kejadian') || new Date().toISOString().split('T')[0];

      const keteranganLengkap = `[${jenis}] ${keterangan}`;
      const duplicateSince = new Date(Date.now() - 10 * 60 * 1000).toISOString();
      const { data: existingDuplicate, error: duplicateError } = await privilegedSupabase
        .from('tagihan_krama')
        .select('id')
        .eq('anggota_id', anggota_id)
        .eq('total_nominal', total_nominal)
        .eq('keterangan', keteranganLengkap)
        .eq('tanggal_kejadian', tanggal_kejadian)
        .gte('created_at', duplicateSince)
        .limit(1);
      if (duplicateError) throw duplicateError;
      if (existingDuplicate && existingDuplicate.length > 0) {
        throw new Error('Denda yang sama untuk anggota ini baru saja dicatat. Pengiriman ganda diabaikan.');
      }

      const { error } = await privilegedSupabase.from('tagihan_krama').insert([
        { 
          anggota_id, 
          total_nominal, 
          status_bayar: 'BELUM_LUNAS', 
          keterangan: keteranganLengkap,
          tanggal_kejadian 
        }
      ]);
      if (error) throw error;
      successMessage = 'Data denda / cicilan Numbas Ayahan berhasil dicatat!';
    }
    else if (action === 'bayar_numbas_ayahan') {
      const tagihanId = formData.get('tagihan_id')?.toString();
      const nominalBayar = Number(formData.get('nominal_bayar'));
      const tanggalBayar = formData.get('tanggal_bayar')?.toString() || new Date().toISOString().slice(0, 10);
      const keteranganBayar = formData.get('keterangan')?.toString().trim() || 'Pembayaran Numbas Ayahan';

      if (!tagihanId || !Number.isFinite(nominalBayar) || nominalBayar <= 0) {
        throw new Error('Pilih tagihan tahunan dan masukkan nominal pembayaran yang valid.');
      }

      const { data: tagihan, error: tagihanError } = await privilegedSupabase
        .from('tagihan_krama')
        .select('id, anggota_id, total_nominal, nominal, jumlah_dibayar, status_bayar, event_adat_id, event:event_adat!tagihan_krama_event_adat_id_fkey(nama_event, jenis_event), anggota!tagihan_krama_anggota_id_fkey(nama_lengkap, status_aktif)')
        .eq('id', tagihanId)
        .maybeSingle();
      if (tagihanError) throw tagihanError;
      if (!tagihan) throw new Error('Tagihan tidak ditemukan.');
      const eventTahunan = Array.isArray(tagihan.event) ? tagihan.event[0] : tagihan.event;
      const anggotaPasif = Array.isArray(tagihan.anggota) ? tagihan.anggota[0] : tagihan.anggota;
      if (eventTahunan?.jenis_event !== 'TAHUNAN' || anggotaPasif?.status_aktif !== 'TIDAK_AKTIF') {
        throw new Error('Pembayaran Numbas Ayahan hanya untuk tagihan tahunan anggota Numbas Ayahan.');
      }
      if (['LUNAS', 'VERIFIED'].includes((tagihan.status_bayar || '').toUpperCase())) {
        throw new Error('Tagihan tahunan ini sudah lunas.');
      }

      const totalTagihan = Number(tagihan.total_nominal ?? tagihan.nominal ?? 0);
      const totalDibayar = Number(tagihan.jumlah_dibayar || 0);
      const sisa = Math.max(0, totalTagihan - totalDibayar);
      if (nominalBayar > sisa) throw new Error('Nominal pembayaran melebihi sisa iuran tahunan.');

      const { data: receipt, error: receiptError } = await privilegedSupabase
        .from('riwayat_pembayaran_cicilan')
        .insert({
          tagihan_krama_id: tagihan.id,
          anggota_id: tagihan.anggota_id,
          diterima_oleh: actor.id,
          nominal_bayar: nominalBayar,
          tanggal_bayar: new Date(`${tanggalBayar}T12:00:00`).toISOString(),
          metode_pembayaran: 'CASH_BENDAHARA',
          keterangan: keteranganBayar,
        })
        .select('id')
        .single();
      if (receiptError) throw receiptError;

      const totalBaru = totalDibayar + nominalBayar;
      const statusBaru = totalBaru >= totalTagihan ? 'LUNAS' : 'PARTIAL';
      const { error: updateTagihanError } = await privilegedSupabase
        .from('tagihan_krama')
        .update({ jumlah_dibayar: totalBaru, status_bayar: statusBaru, updated_at: new Date().toISOString() })
        .eq('id', tagihan.id);
      if (updateTagihanError) {
        await privilegedSupabase.from('riwayat_pembayaran_cicilan').delete().eq('id', receipt.id);
        throw updateTagihanError;
      }

      successMessage = `Pembayaran Numbas Ayahan ${formatRupiah(nominalBayar)} untuk ${anggotaPasif?.nama_lengkap || 'anggota'} berhasil dicatat.`;
    }
    else if (action === 'edit_tagihan') {
      const tagihanId = formData.get('tagihan_id')?.toString();
      const tanggal = formData.get('tanggal')?.toString() || '';
      const nominal = Number(formData.get('nominal'));
      const keterangan = formData.get('keterangan')?.toString().trim() || '';
      if (!tagihanId || !isValidDate(tanggal) || !Number.isFinite(nominal) || nominal <= 0 || !keterangan) {
        throw new Error('Lengkapi tanggal, nominal, dan keterangan tagihan dengan nilai yang valid.');
      }

      const { data: bill, error: billError } = await privilegedSupabase
        .from('tagihan_krama')
        .select('id, total_nominal, nominal, jumlah_dibayar, status_bayar')
        .eq('id', tagihanId)
        .maybeSingle();
      if (billError) throw billError;
      if (!bill) throw new Error('Tagihan tidak ditemukan atau sudah dihapus.');

      const { data: billPayments, error: billPaymentsError } = await privilegedSupabase
        .from('riwayat_pembayaran_cicilan')
        .select('id, nominal_bayar, setoran_regu_id')
        .eq('tagihan_krama_id', tagihanId);
      if (billPaymentsError) throw billPaymentsError;
      if ((billPayments || []).some((payment) => payment.setoran_regu_id)) {
        throw new Error('Tagihan memiliki pembayaran yang tertaut ke setoran. Tolak setoran PENDING atau balikkan setoran VERIFIED sebelum mengedit.');
      }

      const paidRecorded = Number(bill.jumlah_dibayar || 0);
      if (nominal < paidRecorded) throw new Error(`Nominal tagihan tidak boleh lebih kecil dari jumlah yang telah dibayar (${formatRupiah(paidRecorded)}).`);
      const statusAfter = paidRecorded >= nominal ? 'LUNAS' : paidRecorded > 0 ? 'PARTIAL' : 'BELUM_LUNAS';
      const { error: updateBillError } = await privilegedSupabase
        .from('tagihan_krama')
        .update({
          total_nominal: nominal,
          nominal,
          tanggal_kejadian: tanggal,
          keterangan,
          status_bayar: statusAfter,
          updated_at: new Date().toISOString(),
        })
        .eq('id', tagihanId);
      if (updateBillError) throw updateBillError;
      successMessage = 'Tagihan berhasil diperbarui; saldo buku besar dihitung ulang dari data terbaru.';
    }
    else if (action === 'edit_pembayaran') {
      const paymentId = formData.get('payment_id')?.toString();
      const tanggal = formData.get('tanggal')?.toString() || '';
      const nominal = Number(formData.get('nominal'));
      const keterangan = formData.get('keterangan')?.toString().trim() || '';
      if (!paymentId || !isValidDate(tanggal) || !Number.isFinite(nominal) || nominal <= 0 || !keterangan) {
        throw new Error('Lengkapi tanggal, nominal, dan keterangan pembayaran dengan nilai yang valid.');
      }

      const { data: payment, error: paymentError } = await privilegedSupabase
        .from('riwayat_pembayaran_cicilan')
        .select('id, tagihan_krama_id, nominal_bayar, setoran_regu_id')
        .eq('id', paymentId)
        .maybeSingle();
      if (paymentError) throw paymentError;
      if (!payment) throw new Error('Transaksi pembayaran tidak ditemukan.');
      if (payment.setoran_regu_id) {
        throw new Error('Pembayaran masih tertaut ke setoran. Tolak setoran PENDING atau balikkan setoran VERIFIED sebelum mengedit.');
      }

      let bill: { id: string; total_nominal: number; nominal: number | null; jumlah_dibayar: number | null } | null = null;
      let previousPaymentRows: Array<{ id: string; nominal_bayar: number }> = [];
      let updatedBillValues: { jumlah_dibayar: number; status_bayar: string } | null = null;
      if (payment.tagihan_krama_id) {
        const { data: billData, error: billError } = await privilegedSupabase
          .from('tagihan_krama')
          .select('id, total_nominal, nominal, jumlah_dibayar, status_bayar')
          .eq('id', payment.tagihan_krama_id)
          .maybeSingle();
        if (billError) throw billError;
        bill = billData;

        if (bill) {
          const { data: allPayments, error: allPaymentsError } = await privilegedSupabase
            .from('riwayat_pembayaran_cicilan')
            .select('id, nominal_bayar, setoran_regu_id')
            .eq('tagihan_krama_id', bill.id);
          if (allPaymentsError) throw allPaymentsError;
          if ((allPayments || []).some((item) => item.setoran_regu_id)) {
            throw new Error('Tagihan memiliki pembayaran lain yang tertaut ke setoran. Setoran harus diselesaikan atau dibalik terlebih dahulu.');
          }

          previousPaymentRows = (allPayments || []).map((item) => ({ id: item.id, nominal_bayar: Number(item.nominal_bayar || 0) }));
          const detailedPaidBefore = previousPaymentRows.reduce((total, item) => total + item.nominal_bayar, 0);
          const legacyCredit = Math.max(0, Number(bill.jumlah_dibayar || 0) - detailedPaidBefore);
          const paidAfter = legacyCredit + detailedPaidBefore - Number(payment.nominal_bayar || 0) + nominal;
          const billTotal = Number(bill.total_nominal ?? bill.nominal ?? 0);
          if (paidAfter > billTotal) throw new Error(`Pembayaran baru membuat total dibayar melebihi nilai tagihan (${formatRupiah(billTotal)}).`);

          updatedBillValues = {
            jumlah_dibayar: paidAfter,
            status_bayar: paidAfter >= billTotal ? 'LUNAS' : paidAfter > 0 ? 'PARTIAL' : 'BELUM_LUNAS',
          };
          const { error: updateBillError } = await privilegedSupabase
            .from('tagihan_krama')
            .update({ ...updatedBillValues, updated_at: new Date().toISOString() })
            .eq('id', bill.id);
          if (updateBillError) throw updateBillError;
        }
      }

      const { error: updatePaymentError } = await privilegedSupabase
        .from('riwayat_pembayaran_cicilan')
        .update({
          nominal_bayar: nominal,
          tanggal_bayar: new Date(`${tanggal}T12:00:00`).toISOString(),
          keterangan,
        })
        .eq('id', paymentId);
      if (updatePaymentError) {
        if (bill && updatedBillValues) {
          const oldPaid = Number(bill.jumlah_dibayar || 0);
          const oldTotal = Number(bill.total_nominal ?? bill.nominal ?? 0);
          await privilegedSupabase.from('tagihan_krama').update({
            jumlah_dibayar: oldPaid,
            status_bayar: oldPaid >= oldTotal ? 'LUNAS' : oldPaid > 0 ? 'PARTIAL' : 'BELUM_LUNAS',
            updated_at: new Date().toISOString(),
          }).eq('id', bill.id);
        }
        throw updatePaymentError;
      }
      successMessage = 'Pembayaran berhasil diperbarui dan saldo kewajiban direkonsiliasi.';
    }
    else if (action === 'buat_event') {
      const nama_event = formData.get('nama_event');
      const jenis_event = formData.get('jenis_event')?.toString() || '';
      const tarif_default = formData.get('tarif_default');
      const tanggal_event = formData.get('tanggal_event');
      const requestedTarget = formData.get('target_status_keanggotaan')?.toString() || 'SEMUA';
      const target_status_keanggotaan = jenis_event === 'TAHUNAN'
        ? 'TIDAK_AKTIF'
        : ['AKTIF', 'SEMUA'].includes(requestedTarget) ? requestedTarget : 'SEMUA';

      const { data: event, error: eventError } = await privilegedSupabase.from('event_adat').insert([
        { nama_event, jenis_event, tarif_default, tanggal_event, target_status_keanggotaan }
      ]).select('id').single();
      if (eventError) throw eventError;

      const { data: anggotaList, error: anggotaError } = await privilegedSupabase
        .from('anggota')
        .select('id, status_aktif');
      if (anggotaError) {
        await privilegedSupabase.from('event_adat').delete().eq('id', event.id);
        throw anggotaError;
      }

      const anggotaTertagih = (anggotaList || []).filter((anggota) => {
        const statusAktif = anggota.status_aktif || 'AKTIF';
        if (target_status_keanggotaan === 'TIDAK_AKTIF') return statusAktif === 'TIDAK_AKTIF';
        if (target_status_keanggotaan === 'AKTIF') return statusAktif === 'AKTIF';
        return statusAktif === 'AKTIF' || statusAktif === 'TIDAK_AKTIF';
      });

      if (!anggotaTertagih.length) {
        await privilegedSupabase.from('event_adat').delete().eq('id', event.id);
        throw new Error('Tidak ada anggota dengan status yang dipilih untuk menerima tagihan. Event tidak disimpan.');
      }

      const tagihanEvent = anggotaTertagih.map((anggota) => ({
        event_adat_id: event.id,
        anggota_id: anggota.id,
        total_nominal: Number(tarif_default),
        nominal: Number(tarif_default),
        jumlah_dibayar: 0,
        status_bayar: 'BELUM_LUNAS',
        tanggal_kejadian: tanggal_event,
        keterangan: nama_event,
      }));
      const { error: tagihanError } = await privilegedSupabase.from('tagihan_krama').insert(tagihanEvent);
      if (tagihanError) {
        await privilegedSupabase.from('event_adat').delete().eq('id', event.id);
        throw tagihanError;
      }

      successMessage = `Event dan ${anggotaTertagih.length} tagihan berhasil dibuat.`;
    }
  } catch (err: any) {
    errorMessage = 'Terjadi kesalahan: ' + err.message;
  }
}

// Ambil data untuk Bendahara
const privilegedSupabase = createSupabaseAdminClient();
const { data: listSetoran, error: listSetoranError } = await privilegedSupabase
  .from('setoran_regu')
  .select('*, anggota!setoran_regu_kepala_regu_id_fkey(nama_lengkap), regu(nama_regu)')
  .order('created_at', { ascending: false });
if (listSetoranError) {
  errorMessage = `Gagal memuat pengajuan setoran: ${listSetoranError.message}`;
}

const { data: listAnggota } = await privilegedSupabase
  .from('anggota')
  .select('*')
  .order('nama_lengkap', { ascending: true });

const { data: listRegu } = await privilegedSupabase
  .from('regu')
  .select('id, nama_regu')
  .order('nama_regu', { ascending: true });

const { data: listEvent } = await privilegedSupabase
  .from('event_adat')
  .select('*')
  .order('tanggal_event', { ascending: false });

// Ambil riwayat transaksi / tagihan krama secara aman
const { data: listHistory } = await privilegedSupabase
  .from('tagihan_krama')
  .select('*')
  .order('created_at', { ascending: false });

const { data: listPayments } = await privilegedSupabase
  .from('riwayat_pembayaran_cicilan')
  .select('id, anggota_id, tagihan_krama_id, setoran_regu_id, nominal_bayar, tanggal_bayar, metode_pembayaran, keterangan, created_at')
  .order('tanggal_bayar', { ascending: false });

const { data: listTransaksiKas, error: listTransaksiKasError } = await privilegedSupabase
  .from('transaksi_kas')
  .select('*')
  .order('tanggal', { ascending: false })
  .order('created_at', { ascending: false });
if (listTransaksiKasError) errorMessage = `Gagal memuat buku kas: ${listTransaksiKasError.message}`;

const { data: tagihanTahunan } = await privilegedSupabase
  .from('tagihan_krama')
  .select('id, anggota_id, total_nominal, nominal, jumlah_dibayar, status_bayar, event_adat_id, event:event_adat!tagihan_krama_event_adat_id_fkey(nama_event, jenis_event), anggota!tagihan_krama_anggota_id_fkey(nama_lengkap, no_hp, status_aktif)')
  .in('status_bayar', ['BELUM_LUNAS', 'BELUM_BAYAR', 'UNPAID', 'PARTIAL']);
const listTagihanTahunanPasif = (tagihanTahunan || []).filter((tagihan) =>
  (Array.isArray(tagihan.event) ? tagihan.event[0] : tagihan.event)?.jenis_event === 'TAHUNAN'
  && (Array.isArray(tagihan.anggota) ? tagihan.anggota[0] : tagihan.anggota)?.status_aktif === 'TIDAK_AKTIF'
);

const anggotaById = new Map((listAnggota || []).map((anggota) => [anggota.id, anggota]));
const totalPembayaranByTagihan = new Map<string, number>();
for (const payment of listPayments || []) {
  if (!payment.tagihan_krama_id) continue;
  totalPembayaranByTagihan.set(
    payment.tagihan_krama_id,
    (totalPembayaranByTagihan.get(payment.tagihan_krama_id) || 0) + Number(payment.nominal_bayar || 0),
  );
}

const getLedgerTimestamp = (date: string, fallback?: string | null) => {
  const value = date || fallback?.split('T')[0] || '';
  const timestamp = Date.parse(`${value}T12:00:00`);
  return Number.isNaN(timestamp) ? 0 : timestamp;
};
const ledgerEntries: any[] = [];

for (const bill of listHistory || []) {
  const anggotaId = bill.anggota_id || bill.krama_id;
  const member = anggotaById.get(anggotaId);
  const date = bill.tanggal_kejadian || bill.created_at?.split('T')[0] || '';
  const timestamp = getLedgerTimestamp(date, bill.created_at);
  const nominal = Number(bill.total_nominal ?? bill.nominal ?? 0);
  const paidRecorded = Number(bill.jumlah_dibayar || 0);
  const paidDetailed = totalPembayaranByTagihan.get(bill.id) || 0;

  ledgerEntries.push({
    id: `tagihan-${bill.id}`,
    billId: bill.id,
    key: bill.id,
    anggotaId,
    tipe: 'TAGIHAN',
    tanggalSort: date,
    timestamp,
    urutanTanggal: 0,
    noBukti: `TAG-${bill.id.slice(0, 8).toUpperCase()}`,
    namaAnggota: member?.nama_lengkap || 'Anggota tidak ditemukan',
    statusKrama: member?.status_aktif || 'BELUM_DILENGKAPI',
    keteranganRiwayat: bill.keterangan || bill.jenis_tagihan || 'Tagihan kewajiban',
    status_bayar: bill.status_bayar || 'BELUM_LUNAS',
    debit: nominal,
    kredit: 0,
  });

  const unitemizedCredit = Math.max(0, paidRecorded - paidDetailed);
  if (unitemizedCredit > 0) {
    ledgerEntries.push({
      id: `rekonsiliasi-${bill.id}`,
      key: bill.id,
      anggotaId,
      tipe: 'REKONSILIASI',
      tanggalSort: date,
      timestamp,
      urutanTanggal: 1,
      noBukti: `SALDO-${bill.id.slice(0, 8).toUpperCase()}`,
      namaAnggota: member?.nama_lengkap || 'Anggota tidak ditemukan',
      statusKrama: member?.status_aktif || 'BELUM_DILENGKAPI',
      keteranganRiwayat: `Saldo pembayaran lama; tanggal/rincian transaksi tidak tersedia (${bill.keterangan || 'tagihan'})`,
      status_bayar: 'REKONSILIASI',
      debit: 0,
      kredit: unitemizedCredit,
    });
  }
}

for (const payment of listPayments || []) {
  const member = anggotaById.get(payment.anggota_id);
  const date = payment.tanggal_bayar?.split('T')[0] || payment.created_at?.split('T')[0] || '';
  const timestamp = payment.tanggal_bayar ? Date.parse(payment.tanggal_bayar) : getLedgerTimestamp(date);
  ledgerEntries.push({
    ...payment,
    id: `pembayaran-${payment.id}`,
    key: payment.id,
    paymentId: payment.id,
    anggotaId: payment.anggota_id,
    tipe: 'PEMBAYARAN',
    tanggalSort: date,
    timestamp: Number.isNaN(timestamp) ? 0 : timestamp,
    urutanTanggal: 2,
    noBukti: `BYR-${payment.id.slice(0, 8).toUpperCase()}`,
    namaAnggota: member?.nama_lengkap || 'Anggota tidak ditemukan',
    statusKrama: member?.status_aktif || 'BELUM_DILENGKAPI',
    keteranganRiwayat: payment.keterangan || `Pembayaran ${payment.metode_pembayaran || 'diterima'}`,
    status_bayar: 'PEMBAYARAN DICATAT',
    debit: 0,
    kredit: Number(payment.nominal_bayar || 0),
  });
}

const riwayatKronologis = ledgerEntries.sort((left, right) =>
  left.timestamp - right.timestamp
  || left.urutanTanggal - right.urutanTanggal
  || left.id.localeCompare(right.id),
);
const saldoBerjalanByAnggota = new Map<string, number>();
for (const entry of riwayatKronologis) {
  const saldo = (saldoBerjalanByAnggota.get(entry.anggotaId) || 0) + entry.debit - entry.kredit;
  entry.saldoBerjalan = saldo;
  saldoBerjalanByAnggota.set(entry.anggotaId, saldo);
}
const riwayatDenganNama = [...riwayatKronologis].sort((left, right) =>
  right.timestamp - left.timestamp
  || right.urutanTanggal - left.urutanTanggal
  || right.id.localeCompare(left.id),
);
const selisihSaldoLegacy = riwayatDenganNama
  .filter((entry) => entry.tipe === 'REKONSILIASI')
  .reduce((total, entry) => total + entry.kredit, 0);
const totalDebetLedger = riwayatDenganNama.reduce((total, entry) => total + entry.debit, 0);
const totalKreditLedger = riwayatDenganNama.reduce((total, entry) => total + entry.kredit, 0);
const totalSaldoLedger = [...saldoBerjalanByAnggota.values()].reduce((total, saldo) => total + saldo, 0);

const cashMovements: any[] = [];
for (const setoran of listSetoran || []) {
  const reversedByAdmin = (setoran.keterangan || '').includes('[PEMBALIKAN ADMIN]');
  if (setoran.status_verifikasi !== 'VERIFIED' && !reversedByAdmin) continue;
  const setoranDate = (setoran.status_verifikasi === 'VERIFIED' ? setoran.tanggal_verifikasi : setoran.created_at)?.split('T')[0] || '';
  const setoranAmount = Number(setoran.total_nominal || 0);
  const cashDescription = `Setoran ${setoran.regu?.nama_regu || 'regu'} - ${setoran.anggota?.nama_lengkap || 'Kepala Regu'}`;
  const depositTimestamp = getLedgerTimestamp(setoranDate, setoran.created_at);
  cashMovements.push({
    id: `kas-setoran-${setoran.id}`,
    tanggal: setoranDate,
    timestamp: depositTimestamp,
    sourceOrder: 0,
    referensi: `STR-${setoran.id.slice(0, 8).toUpperCase()}`,
    jenis: 'MASUK',
    kategori: 'Setoran Regu',
    pihak: setoran.anggota?.nama_lengkap || setoran.regu?.nama_regu || 'Regu',
    keterangan: cashDescription,
    debit: setoranAmount,
    kredit: 0,
  });

  if (reversedByAdmin) {
    const reversalDate = setoran.tanggal_verifikasi?.split('T')[0] || setoranDate;
    cashMovements.push({
      id: `kas-balik-setoran-${setoran.id}`,
      tanggal: reversalDate,
      timestamp: getLedgerTimestamp(reversalDate, setoran.tanggal_verifikasi),
      sourceOrder: 2,
      referensi: `REV-${setoran.id.slice(0, 8).toUpperCase()}`,
      jenis: 'PEMBALIKAN',
      kategori: 'Pembalikan Setoran',
      pihak: setoran.anggota?.nama_lengkap || setoran.regu?.nama_regu || 'Regu',
      keterangan: 'Pembalikan setoran terverifikasi',
      debit: 0,
      kredit: setoranAmount,
    });
  }
}

for (const payment of listPayments || []) {
  if (payment.metode_pembayaran !== 'CASH_BENDAHARA' || payment.setoran_regu_id) continue;
  const member = anggotaById.get(payment.anggota_id);
  const date = payment.tanggal_bayar?.split('T')[0] || payment.created_at?.split('T')[0] || '';
  const timestamp = payment.tanggal_bayar ? Date.parse(payment.tanggal_bayar) : getLedgerTimestamp(date);
  cashMovements.push({
    id: `kas-pembayaran-${payment.id}`,
    tanggal: date,
    timestamp: Number.isNaN(timestamp) ? 0 : timestamp,
    sourceOrder: 1,
    referensi: `BYR-${payment.id.slice(0, 8).toUpperCase()}`,
    jenis: 'MASUK',
    kategori: 'Pembayaran Langsung Krama',
    pihak: member?.nama_lengkap || 'Anggota tidak ditemukan',
    keterangan: payment.keterangan || 'Pembayaran diterima langsung Bendahara',
    debit: Number(payment.nominal_bayar || 0),
    kredit: 0,
  });
}

for (const transaction of listTransaksiKas || []) {
  const isCashOpening = transaction.arah === 'SALDO_AWAL';
  const isCashIn = transaction.arah === 'MASUK' || isCashOpening;
  cashMovements.push({
    id: `kas-manual-${transaction.id}`,
    tanggal: transaction.tanggal,
    timestamp: getLedgerTimestamp(transaction.tanggal, transaction.created_at),
    sourceOrder: isCashOpening ? -1 : 2,
    referensi: `${isCashOpening ? 'SAL' : isCashIn ? 'MSK' : 'KLR'}-${transaction.id.slice(0, 8).toUpperCase()}`,
    jenis: transaction.arah,
    kategori: transaction.kategori,
    pihak: transaction.penerima,
    keterangan: transaction.keterangan,
    metode: transaction.metode_pembayaran,
    buktiUrl: transaction.bukti_url,
    debit: isCashIn ? Number(transaction.nominal || 0) : 0,
    kredit: isCashIn ? 0 : Number(transaction.nominal || 0),
  });
}

const cashOpeningMovement = cashMovements.find((movement) => movement.jenis === 'SALDO_AWAL');
const cashPeriodMovements = cashOpeningMovement
  ? cashMovements.filter((movement) => movement.timestamp >= cashOpeningMovement.timestamp)
  : cashMovements;
const cashMovementsChronological = cashPeriodMovements.sort((left, right) =>
  left.timestamp - right.timestamp || left.sourceOrder - right.sourceOrder || left.id.localeCompare(right.id),
);
let runningCashBalance = 0;
for (const movement of cashMovementsChronological) {
  runningCashBalance += movement.debit - movement.kredit;
  movement.saldo = runningCashBalance;
}
const cashLedger = [...cashMovementsChronological].sort((left, right) =>
  right.timestamp - left.timestamp || right.sourceOrder - left.sourceOrder || right.id.localeCompare(left.id),
);
const totalKasMasuk = cashPeriodMovements.filter((movement) => movement.jenis !== 'SALDO_AWAL').reduce((total, movement) => total + movement.debit, 0);
const totalKasKeluar = cashPeriodMovements.reduce((total, movement) => total + movement.kredit, 0);
const labelKategoriKas = (category: string) => ({
  BANTUAN_DUKA: 'Bantuan keluarga berduka',
  BANTUAN_PERNIKAHAN: 'Pembayaran kepada mempelai',
  OPERASIONAL: 'Operasional banjar',
  LAINNYA: 'Pengeluaran lainnya',
  PEMASUKAN_LAIN: 'Pemasukan lain',
  SUMBANGAN: 'Sumbangan',
  PENGEMBALIAN_DANA: 'Pengembalian dana',
  SALDO_AWAL_KAS: 'Saldo awal kas',
  'Pembalikan Setoran': 'Pembalikan setoran',
}[category] || category);

---

<LayoutDashboard title="Portal Bendahara - Banjar Adat" role="BENDAHARA">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <!-- Header Bendahara -->
    <div class="bg-slate-900 text-white p-6 rounded-2xl shadow-lg border border-slate-800 flex flex-col md:flex-row justify-between md:items-center gap-4">
      <div>
        <span class="text-xs font-bold px-3 py-1 bg-amber-500/20 text-amber-400 border border-amber-500/30 rounded-full">
          Portal Bendahara Keuangan Banjar
        </span>
        <h1 class="text-xl md:text-2xl font-black mt-2">Verifikasi Setoran, Denda, & Master Tarif Adat</h1>
      </div>
      <div class="text-xs text-slate-400">
        <span>Total Anggota: <strong class="text-white">{listAnggota?.length || 0} Krama</strong></span>
      </div>
      <a href="/daftar-krama" class="no-print inline-flex items-center justify-center gap-2 rounded-lg border border-amber-400/50 bg-amber-500 px-3 py-2 text-xs font-bold text-slate-950 transition hover:bg-amber-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-300">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" />
        </svg>
        Direktori Krama
      </a>
      <form action="/kepalaregu" method="GET" class="no-print flex flex-wrap items-center gap-2">
        <label for="pilih-regu-lihat" class="text-xs font-semibold text-slate-300">Lihat regu:</label>
        <select id="pilih-regu-lihat" name="regu" required class="rounded-lg border border-slate-600 bg-slate-800 px-2.5 py-2 text-xs text-white">
          <option value="">Pilih regu</option>
          {listRegu?.map((regu) => <option value={regu.id}>{regu.nama_regu}</option>)}
        </select>
        <button type="submit" class="rounded-lg bg-amber-500 px-3 py-2 text-xs font-bold text-slate-950 hover:bg-amber-400">Buka Portal Regu</button>
      </form>
    </div>

    {successMessage && (
      <div class="p-4 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold rounded-xl">
        {successMessage}
      </div>
    )}
    {errorMessage && (
      <div class="p-4 bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-bold rounded-xl">
        {errorMessage}
      </div>
    )}

    <section class="no-print space-y-3">
      <div>
        <h2 class="text-sm font-bold text-slate-900">Pencatatan Bendahara</h2>
        <p class="mt-1 text-xs text-slate-500">Pilih tindakan untuk membuka form pencatatan.</p>
      </div>
      <nav aria-label="Navigasi form Bendahara" class="grid grid-cols-2 gap-2 sm:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-7">
        <button type="button" data-open-dialog="dialog-saldo-awal" class="flex min-h-14 items-center gap-3 rounded-lg border border-blue-200 bg-white px-3 py-2 text-left text-xs font-bold text-blue-900 transition hover:bg-blue-50 focus-visible:outline-2 focus-visible:outline-blue-600">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-blue-100 text-sm" aria-hidden="true">+</span>
          <span>Posting saldo awal</span>
        </button>
        <button type="button" data-open-dialog="dialog-denda" class="flex min-h-14 items-center gap-3 rounded-lg border border-red-200 bg-white px-3 py-2 text-left text-xs font-bold text-red-900 transition hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-red-600">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-red-100 text-sm" aria-hidden="true">!</span>
          <span>Input denda manual</span>
        </button>
        <button type="button" data-open-dialog="dialog-pembayaran-numbas" class="flex min-h-14 items-center gap-3 rounded-lg border border-emerald-200 bg-white px-3 py-2 text-left text-xs font-bold text-emerald-900 transition hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-emerald-600">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-emerald-100 text-sm" aria-hidden="true">Rp</span>
          <span>Pembayaran Numbas Ayahan</span>
        </button>
        <button type="button" data-open-dialog="dialog-master-event" class="flex min-h-14 items-center gap-3 rounded-lg border border-amber-200 bg-white px-3 py-2 text-left text-xs font-bold text-amber-950 transition hover:bg-amber-50 focus-visible:outline-2 focus-visible:outline-amber-600">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-amber-100 text-sm" aria-hidden="true">&#9733;</span>
          <span>Master tarif & event</span>
        </button>
        <button type="button" data-open-dialog="dialog-pengeluaran-kas" class="col-span-2 flex min-h-14 items-center gap-3 rounded-lg border border-slate-300 bg-slate-900 px-3 py-2 text-left text-xs font-bold text-white transition hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-slate-700 sm:col-span-1">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-white/10 text-sm" aria-hidden="true">&minus;</span>
          <span>Catat pengeluaran kas</span>
        </button>
        <button type="button" data-open-dialog="dialog-pemasukan-kas" class="flex min-h-14 items-center gap-3 rounded-lg border border-emerald-200 bg-white px-3 py-2 text-left text-xs font-bold text-emerald-900 transition hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-emerald-600">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-emerald-100 text-sm" aria-hidden="true">+</span>
          <span>Pemasukan lain</span>
        </button>
        <button type="button" data-open-dialog="dialog-saldo-awal-kas" class="flex min-h-14 items-center gap-3 rounded-lg border border-slate-300 bg-white px-3 py-2 text-left text-xs font-bold text-slate-800 transition hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-slate-600">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-slate-100 text-sm" aria-hidden="true">&#8634;</span>
          <span>Saldo awal kas</span>
        </button>
      </nav>
    </section>

    <!-- SECTION 1: VERIFIKASI SETORAN KEPALA REGU -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
      <div>
        <h2 class="text-base font-bold text-slate-800">Verifikasi Setoran Tunai dari Kepala Regu</h2>
        <p class="text-xs text-slate-500 mt-0.5">Setujui setoran kas regu yang masuk untuk memperbarui saldo keuangan banjar.</p>
      </div>

      <div id="bendahara-setoran-report" class="space-y-3">
      <div class="flex justify-end">
        <PrintReportButton targetId="bendahara-setoran-report" title="Laporan Setoran dari Kepala Regu" />
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left text-slate-600">
          <thead class="bg-slate-50 text-slate-500 uppercase border-b border-slate-200">
            <tr>
              <th class="p-3">Regu / Pelapor</th>
              <th class="p-3 text-right">Nominal Tunai</th>
              <th class="p-3 text-center">Status Saat Ini</th>
              <th class="print-hide p-3 text-center">Aksi Verifikasi</th>
            </tr>
          </thead>
          <tbody id="bendahara-setoran-rows" class="divide-y divide-slate-100">
            {listSetoran && listSetoran.length > 0 ? (
              listSetoran.map((setoran) => (
                <tr class="page-row hover:bg-slate-50">
                  <td class="p-3 font-semibold text-slate-900">
                    {setoran.regu?.nama_regu || 'Regu belum ditentukan'} <span class="text-slate-400 font-normal">({setoran.anggota?.nama_lengkap || 'Kepala Regu'})</span>
                  </td>
                  <td class="p-3 text-right font-bold text-slate-900">{formatRupiah(setoran.total_nominal)}</td>
                  <td class="print-hide p-3 text-center">
                    <span class={`px-2.5 py-1 rounded-full text-[10px] font-bold ${
                      setoran.status_verifikasi === 'VERIFIED' ? 'bg-emerald-100 text-emerald-800' :
                      setoran.status_verifikasi === 'REJECTED' ? 'bg-red-100 text-red-800' : 'bg-amber-100 text-amber-800'
                    }`}>
                      {setoran.status_verifikasi || 'PENDING'}
                    </span>
                  </td>
                  <td class="p-3 text-center">
                    {setoran.status_verifikasi === 'PENDING' ? (
                      <form method="POST" class="inline-flex gap-2">
                        <input type="hidden" name="action" value="verifikasi_setoran" />
                        <input type="hidden" name="setoran_id" value={setoran.id} />
                        <button type="submit" name="status" value="VERIFIED" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg transition">
                          Setujui
                        </button>
                        <button type="submit" name="status" value="REJECTED" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-lg transition">
                          Tolak
                        </button>
                      </form>
                    ) : (
                      <span class="text-xs text-slate-400">Sudah diproses</span>
                    )}
                  </td>
                </tr>
              ))
            ) : (
              <tr>
                <td colspan="4" class="p-6 text-center text-slate-400 italic">Belum ada rekap setoran dari kepala regu.</td>
              </tr>
            )}
