          <div class="flex justify-end gap-2 border-t border-slate-100 pt-4">
            <button type="button" data-close-dialog="dialog-pemasukan-kas" class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50">Batal</button>
            <button type="submit" class="rounded-lg bg-emerald-700 px-4 py-2 text-xs font-bold text-white hover:bg-emerald-800">Posting Pemasukan</button>
