              <option value="">-- Pilih Krama dan Tagihan --</option>
              {listTagihanTahunanPasif.map((tagihan) => {
                const nominalTagihan = Number(tagihan.total_nominal ?? tagihan.nominal ?? 0);
                const sisaTagihan = Math.max(0, nominalTagihan - Number(tagihan.jumlah_dibayar || 0));
                const anggotaTahunan = Array.isArray(tagihan.anggota) ? tagihan.anggota[0] : tagihan.anggota;
                const eventTahunan = Array.isArray(tagihan.event) ? tagihan.event[0] : tagihan.event;
                return (
                  <option value={tagihan.id} data-sisa={sisaTagihan}>
                    {anggotaTahunan?.nama_lengkap || 'Krama'} — {eventTahunan?.nama_event || 'Numbas Ayahan'} (Sisa: {formatRupiah(sisaTagihan)})
                  </option>
                );
              })}
            </select>
            {listTagihanTahunanPasif.length === 0 && (
              <p class="mt-1 text-[10px] text-slate-500">Tidak ada tagihan tahunan Numbas Ayahan yang belum lunas.</p>
