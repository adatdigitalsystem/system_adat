        <form method="POST" id="numbas-ayahan-form" class="space-y-3">
          <input type="hidden" name="action" value="bayar_numbas_ayahan" />

          <div>
            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Pilih Numbas Ayahan / Tagihan Tahunan</label>
