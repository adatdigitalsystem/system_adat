        </div>
        <form method="POST" class="space-y-4" onsubmit="return confirm('Jadikan nominal ini sebagai saldo pembuka Buku Kas? Transaksi sebelum tanggal tersebut tidak akan dijumlahkan ke saldo berjalan periode ini.');">
          <input type="hidden" name="action" value="posting_saldo_awal_kas" />
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="block space-y-1">
              <span class="text-[11px] font-bold uppercase text-slate-600">Tanggal mulai buku kas</span>
              <input type="date" name="tanggal" required value={new Date().toISOString().slice(0, 10)} class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 focus:border-slate-600 focus:outline-none focus:ring-2 focus:ring-slate-100" />
            </label>
            <label class="block space-y-1">
              <span class="text-[11px] font-bold uppercase text-slate-600">Saldo kas fisik (Rp)</span>
              <input type="number" name="nominal" min="0" step="1" required placeholder="0" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 focus:border-slate-600 focus:outline-none focus:ring-2 focus:ring-slate-100" />
