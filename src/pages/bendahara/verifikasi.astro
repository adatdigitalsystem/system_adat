          </div>
          <label class="block space-y-1">
            <span class="text-[11px] font-bold uppercase text-slate-600">Sumber / keterangan saldo awal</span>
            <textarea name="sumber" rows="2" required maxlength="1000" placeholder="Contoh: Hasil pemeriksaan kas dan rekening pada awal periode" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 focus:border-slate-600 focus:outline-none focus:ring-2 focus:ring-slate-100"></textarea>
          </label>
          <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900">Transaksi sebelum tanggal saldo awal tetap tersimpan sebagai riwayat, tetapi tidak dihitung lagi ke saldo berjalan setelah tanggal pembuka.</div>
          <div class="flex justify-end gap-2 border-t border-slate-100 pt-4">
            <button type="button" data-close-dialog="dialog-saldo-awal-kas" class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50">Batal</button>
            <button type="submit" class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-bold text-white hover:bg-slate-800">Posting Saldo Pembuka</button>
          </div>
        </form>
      </div>
    </dialog>

    <dialog id="dialog-pengeluaran-kas" class="w-full max-w-xl rounded-xl border border-slate-200 p-0 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm">
      <div class="space-y-5 bg-white p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-bold uppercase text-slate-500">Buku Kas Banjar</p>
            <h2 class="mt-1 text-lg font-black text-slate-900">Catat Pengeluaran Kas</h2>
            <p class="mt-1 text-xs text-slate-500">Pengeluaran mengurangi saldo kas dan tidak mengubah kewajiban anggota.</p>
          </div>
          <button type="button" data-close-dialog="dialog-pengeluaran-kas" aria-label="Tutup form pengeluaran" class="rounded-md border border-slate-200 px-2.5 py-1.5 text-slate-500 hover:bg-slate-50">&times;</button>
        </div>
        <form method="POST" class="space-y-4" onsubmit="return confirm('Posting pengeluaran kas ini? Nominal akan mengurangi saldo buku kas banjar.');">
          <input type="hidden" name="action" value="catat_pengeluaran_kas" />
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="block space-y-1">
              <span class="text-[11px] font-bold uppercase text-slate-600">Tanggal pengeluaran</span>
              <input type="date" name="tanggal" required value={new Date().toISOString().slice(0, 10)} class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 focus:border-slate-600 focus:outline-none focus:ring-2 focus:ring-slate-100" />
            </label>
            <label class="block space-y-1">
              <span class="text-[11px] font-bold uppercase text-slate-600">Kategori</span>
              <select name="kategori" required class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-800 focus:border-slate-600 focus:outline-none focus:ring-2 focus:ring-slate-100">
                <option value="BANTUAN_DUKA">Bantuan keluarga berduka</option>
                <option value="BANTUAN_PERNIKAHAN">Pembayaran kepada mempelai</option>
                <option value="OPERASIONAL">Operasional banjar</option>
                <option value="LAINNYA">Pengeluaran lainnya</option>
              </select>
            </label>
          </div>
          <label class="block space-y-1">
            <span class="text-[11px] font-bold uppercase text-slate-600">Penerima dana</span>
            <input type="text" name="penerima" required maxlength="200" placeholder="Nama keluarga / penerima / pihak ketiga" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 focus:border-slate-600 focus:outline-none focus:ring-2 focus:ring-slate-100" />
          </label>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="block space-y-1">
              <span class="text-[11px] font-bold uppercase text-slate-600">Nominal keluar (Rp)</span>
              <input type="number" name="nominal" min="1" step="1" required placeholder="0" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 focus:border-slate-600 focus:outline-none focus:ring-2 focus:ring-slate-100" />
            </label>
            <label class="block space-y-1">
              <span class="text-[11px] font-bold uppercase text-slate-600">Metode</span>
              <select name="metode_pembayaran" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-800 focus:border-slate-600 focus:outline-none focus:ring-2 focus:ring-slate-100">
                <option value="TUNAI">Tunai</option>
                <option value="TRANSFER">Transfer</option>
                <option value="LAINNYA">Lainnya</option>
              </select>
            </label>
          </div>
          <label class="block space-y-1">
            <span class="text-[11px] font-bold uppercase text-slate-600">Keterangan / tujuan</span>
            <textarea name="keterangan" rows="2" required maxlength="1000" placeholder="Jelaskan tujuan dan dasar pengeluaran" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 focus:border-slate-600 focus:outline-none focus:ring-2 focus:ring-slate-100"></textarea>
          </label>
          <label class="block space-y-1">
            <span class="text-[11px] font-bold uppercase text-slate-600">Link bukti (opsional)</span>
            <input type="url" name="bukti_url" placeholder="https://..." class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 focus:border-slate-600 focus:outline-none focus:ring-2 focus:ring-slate-100" />
          </label>
          <div class="flex justify-end gap-2 border-t border-slate-100 pt-4">
            <button type="button" data-close-dialog="dialog-pengeluaran-kas" class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50">Batal</button>
            <button type="submit" class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-bold text-white hover:bg-slate-800">Posting Pengeluaran</button>
          </div>
        </form>
      </div>
    </dialog>

    <!-- SECTION 3: DAFTAR EVENT AKTIF -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
      <h2 class="text-base font-bold text-slate-800">Daftar Master Tarif & Event Adat Aktif</h2>
      <div id="bendahara-event-report" class="space-y-3">
      <div class="flex justify-end">
        <PrintReportButton targetId="bendahara-event-report" title="Laporan Master Tarif dan Event Adat" />
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left text-slate-600">
          <thead class="bg-slate-50 text-slate-500 uppercase border-b border-slate-200">
            <tr>
              <th class="p-3">Nama Event</th>
              <th class="p-3">Jenis</th>
              <th class="p-3">Dikenakan Kepada</th>
              <th class="p-3 text-right">Tarif Default</th>
              <th class="p-3 text-center">Tanggal Pelaksanaan</th>
            </tr>
          </thead>
          <tbody id="bendahara-event-rows" class="divide-y divide-slate-100">
            {listEvent && listEvent.length > 0 ? (
              listEvent.map((evt) => (
                <tr class="page-row hover:bg-slate-50">
                  <td class="p-3 font-semibold text-slate-900">{evt.nama_event}</td>
                  <td class="p-3"><span class="px-2 py-0.5 bg-slate-100 rounded-full font-bold text-[10px]">{evt.jenis_event}</span></td>
                  <td class="p-3">{evt.target_status_keanggotaan === 'TIDAK_AKTIF' ? labelStatusKeanggotaan('TIDAK_AKTIF') : evt.target_status_keanggotaan === 'AKTIF' ? labelStatusKeanggotaan('AKTIF') : 'Ngayah & Numbas Ayahan'}</td>
                  <td class="p-3 text-right font-bold text-slate-900">{formatRupiah(evt.tarif_default)}</td>
                  <td class="p-3 text-center">{evt.tanggal_event || '-'}</td>
                </tr>
              ))
            ) : (
              <tr>
                <td colspan="5" class="p-6 text-center text-slate-400 italic">Belum ada event adat terdaftar.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
      <div class="no-print flex flex-col gap-3 border-t border-slate-200 px-3 py-3 sm:flex-row sm:items-center sm:justify-between" data-table-pagination="bendahara-event-rows">
        <div class="flex flex-wrap items-center gap-3">
          <label class="text-xs font-semibold text-slate-600">Baris per halaman
            <select data-page-size class="ml-1 rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-xs"><option value="10">10</option><option value="20">20</option><option value="50">50</option></select>
          </label>
          <span data-page-summary class="text-xs text-slate-500" aria-live="polite"></span>
        </div>
        <div class="flex items-center justify-end gap-2">
          <button type="button" data-page-previous class="rounded-lg border border-slate-300 px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-40">&larr;</button>
          <nav data-page-links class="flex flex-wrap items-center justify-center gap-1" aria-label="Navigasi halaman event" aria-live="polite"></nav>
          <button type="button" data-page-next class="rounded-lg border border-slate-300 px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-40">&rarr;</button>
        </div>
      </div>
      </div>
    </div>

    <section id="bendahara-cash-report" class="space-y-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-bold uppercase text-slate-500">Kas Banjar</p>
          <h2 class="mt-1 text-base font-bold text-slate-900">Buku Kas Masuk & Keluar</h2>
          <p class="mt-1 text-xs text-slate-500">Setoran regu dihitung saat diverifikasi; pembayaran anggota yang masih di regu tidak dihitung sebagai kas banjar.</p>
          {cashOpeningMovement ? (
            <p class="mt-1 text-[11px] text-amber-800">Saldo dibuka sebesar {formatRupiah(cashOpeningMovement.debit)} pada {cashOpeningMovement.tanggal}; transaksi yang lebih lama tidak dihitung lagi dalam periode ini.</p>
          ) : (
            <p class="mt-1 text-[11px] text-amber-800">Saldo ini mencakup transaksi yang tercatat di sistem. Posting saldo awal kas pada tanggal cut-off agar pengeluaran dan pemasukan lama tidak membuat saldo berjalan keliru.</p>
          )}
        </div>
        <PrintReportButton targetId="bendahara-cash-report" title="Buku Kas Banjar" />
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-4">
          <p class="text-xs text-emerald-800">Total Kas Masuk</p>
          <p class="mt-1 text-lg font-black text-emerald-950">{formatRupiah(totalKasMasuk)}</p>
        </div>
        <div class="rounded-lg border border-red-200 bg-red-50 p-4">
          <p class="text-xs text-red-800">Total Kas Keluar</p>
          <p class="mt-1 text-lg font-black text-red-950">{formatRupiah(totalKasKeluar)}</p>
        </div>
        <div class="rounded-lg border border-slate-300 bg-slate-50 p-4">
          <p class="text-xs text-slate-600">{cashOpeningMovement ? 'Saldo Kas Periode Ini' : 'Saldo Kas Tercatat'}</p>
          <p class="mt-1 text-lg font-black text-slate-950">{formatRupiah(runningCashBalance)}</p>
        </div>
      </div>

      <div class="max-h-136 overflow-auto rounded-lg border border-slate-200">
        <table class="w-full min-w-240 text-left text-xs text-slate-600">
          <thead class="sticky top-0 z-10 bg-slate-50 text-[10px] uppercase text-slate-500">
            <tr>
              <th class="p-3">Tanggal</th>
              <th class="p-3">No. Bukti</th>
              <th class="p-3">Kategori / Pihak</th>
              <th class="p-3">Keterangan</th>
              <th class="p-3 text-right">Debet Kas</th>
              <th class="p-3 text-right">Kredit Kas</th>
              <th class="p-3 text-right">Saldo</th>
              <th class="p-3">Metode / Bukti</th>
            </tr>
          </thead>
          <tbody id="bendahara-cash-rows" class="divide-y divide-slate-100">
            {cashLedger.length ? cashLedger.map((movement) => (
              <tr class="page-row hover:bg-slate-50">
                <td class="whitespace-nowrap p-3">{movement.tanggal || '-'}</td>
                <td class="whitespace-nowrap p-3 font-mono text-[10px] font-semibold">{movement.referensi}</td>
                <td class="p-3">
                  <p class={`font-semibold ${movement.jenis === 'KELUAR' || movement.jenis === 'PEMBALIKAN' ? 'text-red-800' : 'text-emerald-800'}`}>{labelKategoriKas(movement.kategori)}</p>
                  <p class="mt-1 text-slate-500">{movement.pihak}</p>
                </td>
                <td class="max-w-sm whitespace-pre-wrap p-3">{movement.keterangan}</td>
                <td class="whitespace-nowrap p-3 text-right font-semibold text-emerald-800">{movement.debit > 0 ? formatRupiah(movement.debit) : '-'}</td>
                <td class="whitespace-nowrap p-3 text-right font-semibold text-red-800">{movement.kredit > 0 ? formatRupiah(movement.kredit) : '-'}</td>
                <td class={`whitespace-nowrap p-3 text-right font-bold ${movement.saldo < 0 ? 'text-red-800' : 'text-slate-900'}`}>{formatRupiah(movement.saldo)}</td>
                <td class="whitespace-nowrap p-3">
                  <span>{movement.metode || (movement.kategori === 'Setoran Regu' ? 'Setoran terverifikasi' : movement.kategori === 'Pembayaran Langsung Krama' ? 'Tunai' : movement.jenis === 'SALDO_AWAL' ? 'Saldo pembuka' : '-')}</span>
                  {movement.buktiUrl && <a href={movement.buktiUrl} target="_blank" rel="noreferrer" class="ml-2 font-semibold text-blue-700 hover:underline">Bukti</a>}
                </td>
              </tr>
            )) : (
              <tr><td colspan="8" class="p-8 text-center text-slate-400">Belum ada transaksi kas masuk atau keluar.</td></tr>
            )}
          </tbody>
        </table>
      </div>
      <div class="no-print flex flex-col gap-3 border-t border-slate-200 px-3 py-3 sm:flex-row sm:items-center sm:justify-between" data-table-pagination="bendahara-cash-rows">
        <div class="flex flex-wrap items-center gap-3">
          <label class="text-xs font-semibold text-slate-600">Baris per halaman
            <select data-page-size class="ml-1 rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-xs"><option value="10">10</option><option value="20">20</option><option value="50">50</option></select>
          </label>
          <span data-page-summary class="text-xs text-slate-500" aria-live="polite"></span>
        </div>
        <div class="flex items-center justify-end gap-2">
          <button type="button" data-page-previous class="rounded-lg border border-slate-300 px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-40">&larr;</button>
          <nav data-page-links class="flex flex-wrap items-center justify-center gap-1" aria-label="Navigasi halaman buku kas" aria-live="polite"></nav>
          <button type="button" data-page-next class="rounded-lg border border-slate-300 px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-40">&rarr;</button>
        </div>
      </div>
    </section>

    <!-- SECTION 4: RIWAYAT / HISTORY RECORD TRANSAKSI -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
      <div>
        <h2 class="text-base font-bold text-slate-800">Buku Besar Kewajiban Krama</h2>
        <p class="text-xs text-slate-500 mt-0.5">Tagihan menambah debet, pembayaran mengurangi kewajiban melalui kredit, dengan saldo berjalan per anggota.</p>
      </div>

      <div class="flex justify-end">
        <PrintReportButton targetId="bendahara-history-report" title="Buku Besar Kewajiban Krama" />
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-lg border border-blue-200 bg-blue-50 p-4">
          <p class="text-xs text-blue-800">Total Debet Tagihan</p>
          <p class="mt-1 text-lg font-black text-blue-950">{formatRupiah(totalDebetLedger)}</p>
        </div>
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-4">
          <p class="text-xs text-emerald-800">Total Kredit Pembayaran</p>
          <p class="mt-1 text-lg font-black text-emerald-950">{formatRupiah(totalKreditLedger)}</p>
        </div>
        <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
          <p class="text-xs text-amber-800">Saldo Piutang Krama</p>
          <p class="mt-1 text-lg font-black text-amber-950">{formatRupiah(totalSaldoLedger)}</p>
        </div>
      </div>
      {selisihSaldoLegacy > 0 && (
        <p class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900">
          Termasuk {formatRupiah(selisihSaldoLegacy)} saldo pembayaran lama yang tersimpan pada tagihan tetapi tidak memiliki rincian transaksi/tanggal. Ditampilkan sebagai kredit rekonsiliasi, bukan bukti pembayaran baru.
        </p>
      )}
      <div class="no-print grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,1fr)_180px_180px]">
        <label class="space-y-1">
          <span class="text-[11px] font-bold uppercase text-slate-500">Cari anggota / keterangan / bukti</span>
          <input id="history-search" type="search" placeholder="Nama, catatan, nomor bukti..." class="w-full rounded-lg border border-slate-300 px-3 py-2 text-xs text-slate-800 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100" />
        </label>
        <label class="space-y-1">
          <span class="text-[11px] font-bold uppercase text-slate-500">Dari tanggal</span>
          <input id="history-date-from" type="date" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-xs text-slate-800 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100" />
        </label>
        <label class="space-y-1">
          <span class="text-[11px] font-bold uppercase text-slate-500">Sampai tanggal</span>
          <input id="history-date-to" type="date" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-xs text-slate-800 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100" />
        </label>
      </div>
      <div id="bendahara-history-report" class="overflow-x-auto">
        <table class="w-full text-xs text-left text-slate-600">
          <thead class="bg-slate-50 text-slate-500 uppercase border-b border-slate-200">
            <tr>
              <th class="p-3" aria-sort="descending">
                <button type="button" data-history-sort="date" class="inline-flex items-center gap-1 font-bold hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-blue-600">
                  Tanggal <span data-history-sort-indicator aria-hidden="true">↓</span>
                </button>
              </th>
              <th class="p-3">No. Bukti</th>
              <th class="p-3" aria-sort="none">
                <button type="button" data-history-sort="member" class="inline-flex items-center gap-1 font-bold hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-blue-600">
                  Nama Krama <span data-history-sort-indicator aria-hidden="true">↕</span>
                </button>
              </th>
              <th class="p-3">Keterangan</th>
              <th class="p-3 text-center" aria-sort="none">
                <button type="button" data-history-sort="member-status" class="inline-flex items-center gap-1 font-bold hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-blue-600">
                  Status Krama <span data-history-sort-indicator aria-hidden="true">↕</span>
                </button>
              </th>
              <th class="print-hide p-3 text-center">Bukti</th>
              <th class="p-3 text-right" aria-sort="none">
                <button type="button" data-history-sort="debit" class="inline-flex items-center gap-1 font-bold hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-blue-600">
                  Debet <span data-history-sort-indicator aria-hidden="true">↕</span>
                </button>
              </th>
              <th class="p-3 text-right" aria-sort="none">
                <button type="button" data-history-sort="credit" class="inline-flex items-center gap-1 font-bold hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-blue-600">
                  Kredit <span data-history-sort-indicator aria-hidden="true">↕</span>
                </button>
              </th>
              <th class="p-3 text-right" aria-sort="none">
                <button type="button" data-history-sort="balance" class="inline-flex items-center gap-1 font-bold hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-blue-600">
                  Saldo <span data-history-sort-indicator aria-hidden="true">↕</span>
                </button>
              </th>
              <th class="p-3 text-center" aria-sort="none">
                <button type="button" data-history-sort="status" class="inline-flex items-center gap-1 font-bold hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-blue-600">
                  Status Pembayaran <span data-history-sort-indicator aria-hidden="true">↕</span>
                </button>
              </th>
            </tr>
          </thead>
          <tbody id="bendahara-history-rows" class="divide-y divide-slate-100">
            {riwayatDenganNama.length > 0 ? (
              riwayatDenganNama.map((item) => (
                <tr
                  class="bendahara-history-row hover:bg-slate-50"
                  data-date={item.tanggalSort}
                  data-member={item.namaAnggota}
                  data-member-status={item.statusKrama}
                  data-status={item.status_bayar || 'BELUM_LUNAS'}
                  data-debit={item.debit}
                  data-credit={item.kredit}
                  data-balance={item.saldoBerjalan}
                  data-edit-type={item.tipe === 'TAGIHAN' ? 'tagihan' : item.tipe === 'PEMBAYARAN' ? 'pembayaran' : ''}
                  data-edit-id={item.tipe === 'TAGIHAN' ? item.billId : item.paymentId}
                  data-edit-date={item.tanggalSort || ''}
                  data-edit-amount={item.tipe === 'TAGIHAN' ? item.debit : item.kredit}
                  data-edit-description={item.keteranganRiwayat || ''}
                  data-setoran-id={item.tipe === 'PEMBAYARAN' ? item.setoran_regu_id || '' : ''}
                  data-search={`${item.namaAnggota} ${item.keteranganRiwayat} ${item.noBukti} ${item.tipe}`.toLocaleLowerCase('id-ID')}
                >
                  <td class="p-3 whitespace-nowrap">{item.tanggalSort || '-'}</td>
                  <td class="whitespace-nowrap p-3 font-mono text-[10px] font-semibold text-slate-600">
                    {item.tipe === 'TAGIHAN' || item.tipe === 'PEMBAYARAN' ? (
                      <button type="button" data-open-transaction-edit class="text-blue-700 underline decoration-dotted underline-offset-2 hover:text-blue-900 focus-visible:outline-2 focus-visible:outline-blue-600" title="Klik untuk mengedit transaksi">
                        {item.noBukti}
                      </button>
                    ) : item.noBukti}
                  </td>
                  <td class="whitespace-nowrap p-3 font-semibold text-slate-900">
                    {item.namaAnggota}
                  </td>
                  <td class="min-w-64 p-3">
                    <span class={`mr-2 inline-block rounded-full px-2 py-0.5 text-[9px] font-bold ${
                      item.tipe === 'TAGIHAN' ? 'bg-blue-100 text-blue-800' : item.tipe === 'PEMBAYARAN' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-900'
                    }`}>
                      {item.tipe === 'TAGIHAN' ? 'Tagihan' : item.tipe === 'PEMBAYARAN' ? 'Pembayaran' : 'Rekonsiliasi'}
                    </span>
                    <span class="whitespace-pre-wrap font-medium text-slate-700">{item.keteranganRiwayat}</span>
                  </td>
                  <td class="p-3 text-center">
                    <span class={`inline-block rounded-full px-2.5 py-1 text-[10px] font-bold ${
                      item.statusKrama === 'TIDAK_AKTIF' ? 'bg-slate-200 text-slate-700' : item.statusKrama === 'BELUM_DILENGKAPI' ? 'bg-slate-100 text-slate-500' : 'bg-emerald-100 text-emerald-800'
                    }`}>
                      {labelStatusKeanggotaan(item.statusKrama)}
                    </span>
                  </td>
                  <td class="print-hide p-3 text-center">
                    {item.tipe === 'PEMBAYARAN' ? (
                      <PrintReportButton targetId={`bukti-bayar-${item.paymentId}`} title="Bukti Pembayaran Krama" label="Bukti" />
                    ) : <span class="text-slate-400">-</span>}
                    {item.tipe === 'PEMBAYARAN' && (
                      <section id={`bukti-bayar-${item.paymentId}`} class="hidden space-y-4 border border-slate-300 bg-white p-6 text-slate-900">
                        <div class="border-b border-slate-300 pb-4 text-center">
                          <h2 class="text-lg font-black">BUKTI PEMBAYARAN KRAMA</h2>
                          <p class="mt-1 text-xs">Banjar Adat Dharma Sadhu Dukuh</p>
                        </div>
                        <dl class="grid grid-cols-2 gap-3 text-sm">
                          <dt class="font-semibold">Nama Krama</dt><dd>{item.namaAnggota}</dd>
                          <dt class="font-semibold">Tanggal Pembayaran</dt><dd>{item.tanggalSort || '-'}</dd>
                          <dt class="font-semibold">Metode</dt><dd>{item.metode_pembayaran || 'CASH_BENDAHARA'}</dd>
                          <dt class="font-semibold">Nominal Diterima</dt><dd class="font-bold">{formatRupiah(item.kredit)}</dd>
                          <dt class="font-semibold">Keterangan / Bukti</dt><dd>{item.keteranganRiwayat}</dd>
                        </dl>
                        <div class="grid grid-cols-2 gap-12 pt-10 text-center text-xs">
                          <div class="border-t border-slate-400 pt-2">Krama / Pembayar</div>
                          <div class="border-t border-slate-400 pt-2">Bendahara Penerima</div>
                        </div>
                      </section>
                    )}
                  </td>
                  <td class="whitespace-nowrap p-3 text-right font-semibold text-slate-900">{item.debit > 0 ? formatRupiah(item.debit) : '-'}</td>
                  <td class="whitespace-nowrap p-3 text-right font-semibold text-emerald-800">{item.kredit > 0 ? formatRupiah(item.kredit) : '-'}</td>
                  <td class={`whitespace-nowrap p-3 text-right font-bold ${item.saldoBerjalan > 0 ? 'text-amber-900' : 'text-slate-700'}`}>{formatRupiah(item.saldoBerjalan)}</td>
                  <td class="p-3 text-center">
                    <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold ${
                      item.status_bayar === 'LUNAS' ? 'bg-emerald-100 text-emerald-800' : item.status_bayar === 'REKONSILIASI' ? 'bg-amber-100 text-amber-900' : 'bg-amber-100 text-amber-800'
                    }`}>
                      {item.status_bayar || 'BELUM_LUNAS'}
                    </span>
                  </td>
                  <td class="print-hide p-3 text-center">
                    {item.tipe === 'PEMBAYARAN' ? (
                      <>
                        <PrintReportButton targetId={`bukti-bayar-${item.paymentId}`} title="Bukti Pembayaran Krama" label="Bukti" />
                        <section id={`bukti-bayar-${item.paymentId}`} class="hidden space-y-4 border border-slate-300 bg-white p-6 text-slate-900">
                          <div class="border-b border-slate-300 pb-4 text-center">
                            <h2 class="text-lg font-black">BUKTI PEMBAYARAN KRAMA</h2>
                            <p class="mt-1 text-xs">Banjar Adat Dharma Sadhu Dukuh</p>
                          </div>
                          <dl class="grid grid-cols-2 gap-3 text-sm">
                            <dt class="font-semibold">Nama Krama</dt><dd>{item.namaAnggota}</dd>
                            <dt class="font-semibold">Tanggal Pembayaran</dt><dd>{item.tanggalSort || '-'}</dd>
                            <dt class="font-semibold">Metode</dt><dd>{item.metode_pembayaran || 'CASH_BENDAHARA'}</dd>
                            <dt class="font-semibold">Nominal Diterima</dt><dd class="font-bold">{formatRupiah(item.nominalRiwayat)}</dd>
                            <dt class="font-semibold">Keterangan / Bukti</dt><dd>{item.keteranganRiwayat}</dd>
                          </dl>
                          <div class="grid grid-cols-2 gap-12 pt-10 text-center text-xs">
                            <div class="border-t border-slate-400 pt-2">Krama / Pembayar</div>
                            <div class="border-t border-slate-400 pt-2">Bendahara Penerima</div>
                          </div>
                        </section>
                      </>
                    ) : <span class="text-slate-400">-</span>}
                  </td>
                </tr>
              ))
            ) : (
              <tr>
                <td colspan="10" class="p-6 text-center text-slate-400 italic">Belum ada riwayat transaksi tercatat. Gunakan form input denda/cicilan di atas untuk mencatat transaksi.</td>
              </tr>
            )}
          </tbody>
        </table>
        <div class="no-print flex flex-col gap-3 border-t border-slate-200 px-3 py-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex flex-wrap items-center gap-3">
            <label for="history-page-size" class="text-xs font-semibold text-slate-600">Baris per halaman</label>
            <select id="history-page-size" class="rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-700 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100">
              <option value="10" selected>10</option>
              <option value="20">20</option>
              <option value="50">50</option>
            </select>
            <p id="history-page-summary" class="text-xs text-slate-500" aria-live="polite"></p>
          </div>
          <div class="flex items-center justify-between gap-3 sm:justify-end">
            <button id="history-page-previous" type="button" class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">&larr; Sebelumnya</button>
            <nav id="history-page-links" class="flex flex-wrap items-center justify-center gap-1" aria-label="Navigasi halaman riwayat transaksi" aria-live="polite"></nav>
            <button id="history-page-next" type="button" class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">Berikutnya &rarr;</button>
          </div>
        </div>
      </div>
    </div>

    <dialog id="dialog-edit-transaksi" class="w-full max-w-xl rounded-xl border border-slate-200 p-0 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm">
      <div class="space-y-5 bg-white p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p id="edit-transaksi-type" class="text-xs font-bold uppercase text-blue-700">Edit Transaksi</p>
            <h2 id="edit-transaksi-title" class="mt-1 text-lg font-black text-slate-900">Perbarui catatan buku besar</h2>
            <p id="edit-transaksi-member" class="mt-1 text-xs text-slate-500"></p>
          </div>
          <button type="button" data-close-dialog="dialog-edit-transaksi" aria-label="Tutup form edit transaksi" class="rounded-md border border-slate-200 px-2.5 py-1.5 text-slate-500 hover:bg-slate-50">&times;</button>
        </div>
        <form id="edit-transaksi-form" method="POST" class="space-y-4" onsubmit="return confirm('Simpan perubahan transaksi? Saldo buku besar akan dihitung ulang.');">
          <input id="edit-transaksi-action" type="hidden" name="action" value="edit_tagihan" />
          <input id="edit-transaksi-id" type="hidden" name="tagihan_id" />
          <label class="block space-y-1">
            <span class="text-[11px] font-bold uppercase text-slate-600">Tanggal transaksi</span>
            <input id="edit-transaksi-date" type="date" name="tanggal" required class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100" />
          </label>
          <label class="block space-y-1">
            <span id="edit-transaksi-amount-label" class="text-[11px] font-bold uppercase text-slate-600">Nominal tagihan (Rp)</span>
            <input id="edit-transaksi-amount" type="number" name="nominal" min="1" step="1" required class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100" />
          </label>
          <label class="block space-y-1">
            <span class="text-[11px] font-bold uppercase text-slate-600">Keterangan</span>
            <textarea id="edit-transaksi-description" name="keterangan" rows="3" required maxlength="1000" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100"></textarea>
          </label>
          <p id="edit-transaksi-note" class="hidden rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900"></p>
          <div class="flex justify-end gap-2 border-t border-slate-100 pt-4">
            <button type="button" data-close-dialog="dialog-edit-transaksi" class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50">Batal</button>
            <button type="submit" class="rounded-lg bg-blue-700 px-4 py-2 text-xs font-bold text-white hover:bg-blue-800">Simpan Perubahan</button>
          </div>
        </form>
      </div>
    </dialog>

  </div>
</LayoutDashboard>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open-dialog]').forEach((button) => {
    button.addEventListener('click', () => {
      const dialog = document.getElementById(button.dataset.openDialog || '');
      if (dialog instanceof HTMLDialogElement && !dialog.open) dialog.showModal();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-close-dialog]').forEach((button) => {
    button.addEventListener('click', () => {
      const dialog = document.getElementById(button.dataset.closeDialog || '');
      if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('dialog').forEach((dialog) => {
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });

  const editTransactionDialog = document.querySelector<HTMLDialogElement>('#dialog-edit-transaksi');
  const editTransactionForm = document.querySelector<HTMLFormElement>('#edit-transaksi-form');
  const editTransactionType = document.querySelector<HTMLElement>('#edit-transaksi-type');
  const editTransactionTitle = document.querySelector<HTMLElement>('#edit-transaksi-title');
  const editTransactionMember = document.querySelector<HTMLElement>('#edit-transaksi-member');
  const editTransactionAction = document.querySelector<HTMLInputElement>('#edit-transaksi-action');
  const editTransactionId = document.querySelector<HTMLInputElement>('#edit-transaksi-id');
  const editTransactionDate = document.querySelector<HTMLInputElement>('#edit-transaksi-date');
  const editTransactionAmount = document.querySelector<HTMLInputElement>('#edit-transaksi-amount');
  const editTransactionAmountLabel = document.querySelector<HTMLElement>('#edit-transaksi-amount-label');
  const editTransactionDescription = document.querySelector<HTMLTextAreaElement>('#edit-transaksi-description');
  const editTransactionNote = document.querySelector<HTMLElement>('#edit-transaksi-note');

  document.querySelectorAll<HTMLButtonElement>('[data-open-transaction-edit]').forEach((button) => {
    button.addEventListener('click', () => {
      const row = button.closest<HTMLTableRowElement>('.bendahara-history-row');
      if (!row || !editTransactionDialog || !editTransactionForm) return;
      const type = row.dataset.editType;
      if (type !== 'tagihan' && type !== 'pembayaran') return;

      const transactionId = row.dataset.editId || '';
      const memberName = row.dataset.member || 'Anggota';
      const isPayment = type === 'pembayaran';
      editTransactionForm.reset();
      if (editTransactionAction) editTransactionAction.value = isPayment ? 'edit_pembayaran' : 'edit_tagihan';
      if (editTransactionId) {
        editTransactionId.name = isPayment ? 'payment_id' : 'tagihan_id';
        editTransactionId.value = transactionId;
      }
      if (editTransactionDate) editTransactionDate.value = row.dataset.editDate || '';
      if (editTransactionAmount) editTransactionAmount.value = row.dataset.editAmount || '0';
      if (editTransactionDescription) editTransactionDescription.value = row.dataset.editDescription || '';
      if (editTransactionType) editTransactionType.textContent = isPayment ? 'Pembayaran Krama' : 'Tagihan Kewajiban';
      if (editTransactionTitle) editTransactionTitle.textContent = isPayment ? 'Edit Pembayaran' : 'Edit Tagihan';
      if (editTransactionMember) editTransactionMember.textContent = `${memberName} · ${row.querySelector('td')?.textContent?.trim() || ''} · ${button.textContent?.trim() || ''}`;
      if (editTransactionAmountLabel) editTransactionAmountLabel.textContent = isPayment ? 'Nominal pembayaran (Rp)' : 'Nominal tagihan (Rp)';
      if (editTransactionNote) {
        const depositId = row.dataset.setoranId;
        const isSetoranLinked = Boolean(depositId);
        editTransactionNote.textContent = isPayment && isSetoranLinked
          ? 'Pembayaran ini tertaut ke setoran. Tolak setoran PENDING atau balikkan setoran VERIFIED terlebih dahulu.'
          : isPayment
            ? 'Menyimpan perubahan akan menghitung ulang jumlah dibayar dan status tagihan terkait.'
            : 'Jika tagihan terkait pembayaran yang tertaut setoran, perubahan akan ditolak sampai setoran dilepas.';
        editTransactionNote.classList.remove('hidden');
      }
      if (isPayment && row.dataset.setoranId) {
        const submitButton = editTransactionForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submitButton) submitButton.disabled = true;
      } else {
        const submitButton = editTransactionForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submitButton) submitButton.disabled = false;
      }
      editTransactionDialog.showModal();
    });
  });

  document.querySelectorAll<HTMLElement>('[data-table-pagination]').forEach((controls) => {
    const tableBody = document.getElementById(controls.dataset.tablePagination || '') as HTMLTableSectionElement | null;
    const pageSizeSelect = controls.querySelector<HTMLSelectElement>('[data-page-size]');
    const summary = controls.querySelector<HTMLElement>('[data-page-summary]');
    const pageLinks = controls.querySelector<HTMLElement>('[data-page-links]');
    const previousButton = controls.querySelector<HTMLButtonElement>('[data-page-previous]');
    const nextButton = controls.querySelector<HTMLButtonElement>('[data-page-next]');
    let page = 1;

    const renderPagination = () => {
      if (!tableBody || !pageSizeSelect || !pageLinks) return;
      const rows = Array.from(tableBody.querySelectorAll<HTMLTableRowElement>('.page-row'));
      const pageSize = Number(pageSizeSelect.value || 10);
      const pageCount = Math.max(1, Math.ceil(rows.length / pageSize));
      page = Math.min(Math.max(1, page), pageCount);
      const start = (page - 1) * pageSize;
      const end = Math.min(start + pageSize, rows.length);

      rows.forEach((row, index) => row.classList.toggle('hidden', index < start || index >= end));
      if (summary) summary.textContent = rows.length ? `Menampilkan ${start + 1}-${end} dari ${rows.length} baris` : 'Tidak ada data';
      if (previousButton) previousButton.disabled = page <= 1;
      if (nextButton) nextButton.disabled = page >= pageCount;

      let pages: Array<number | 'ellipsis'>;
      if (pageCount <= 7) pages = Array.from({ length: pageCount }, (_, index) => index + 1);
      else if (page <= 4) pages = [1, 2, 3, 4, 5, 'ellipsis', pageCount];
      else if (page >= pageCount - 3) pages = [1, 'ellipsis', pageCount - 4, pageCount - 3, pageCount - 2, pageCount - 1, pageCount];
      else pages = [1, 'ellipsis', page - 1, page, page + 1, 'ellipsis', pageCount];

      pageLinks.replaceChildren();
      pages.forEach((pageNumber) => {
        if (pageNumber === 'ellipsis') {
          const dots = document.createElement('span');
          dots.className = 'px-1 text-xs text-slate-400';
          dots.textContent = '…';
          pageLinks.append(dots);
          return;
        }

        const link = document.createElement('a');
        link.href = '#';
        link.textContent = String(pageNumber);
        link.setAttribute('aria-label', `Halaman ${pageNumber}`);
        link.className = pageNumber === page
          ? 'rounded-md bg-blue-700 px-2.5 py-1 text-xs font-bold text-white'
          : 'rounded-md px-2.5 py-1 text-xs font-semibold text-blue-700 hover:bg-blue-50 hover:underline';
        if (pageNumber === page) link.setAttribute('aria-current', 'page');
        link.addEventListener('click', (event) => {
          event.preventDefault();
          page = pageNumber;
          renderPagination();
        });
        pageLinks.append(link);
      });
    };

    pageSizeSelect?.addEventListener('change', () => {
      page = 1;
      renderPagination();
    });
    previousButton?.addEventListener('click', () => {
      page -= 1;
      renderPagination();
    });
    nextButton?.addEventListener('click', () => {
      page += 1;
      renderPagination();
    });
    renderPagination();
  });

  const numbasTagihanSelect = document.querySelector<HTMLSelectElement>('#numbas-tagihan');
  const numbasNominalInput = document.querySelector<HTMLInputElement>('#numbas-nominal');
  const numbasSisaText = document.querySelector<HTMLElement>('#numbas-sisa');

  numbasTagihanSelect?.addEventListener('change', () => {
    const selectedOption = numbasTagihanSelect.selectedOptions[0];
    const remaining = Number(selectedOption?.dataset.sisa || 0);
    if (numbasNominalInput) {
      numbasNominalInput.max = String(remaining);
      numbasNominalInput.value = remaining > 0 ? String(remaining) : '';
    }
    if (numbasSisaText) {
      numbasSisaText.textContent = remaining > 0
        ? `Sisa kewajiban: ${new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(remaining)}`
        : 'Pilih tagihan tahunan yang masih memiliki sisa.';
    }
  });

  const jenisEventSelect = document.querySelector<HTMLSelectElement>('#jenis-event');
  const targetStatusSelect = document.querySelector<HTMLSelectElement>('#target-status-keanggotaan');
  const targetStatusNote = document.querySelector<HTMLElement>('#target-status-note');
  const passiveOption = targetStatusSelect?.querySelector<HTMLOptionElement>('option[value="TIDAK_AKTIF"]');

  const saldoAwalAnggotaSearch = document.querySelector<HTMLInputElement>('#saldo-awal-anggota-search');
  const saldoAwalAnggotaId = document.querySelector<HTMLInputElement>('#saldo-awal-anggota-id');
  const saldoAwalAnggotaOptions = document.querySelector<HTMLUListElement>('#saldo-awal-anggota-options');
  const saldoAwalAnggotaSelected = document.querySelector<HTMLElement>('#saldo-awal-anggota-selected');
  const saldoAwalAnggotaEmpty = document.querySelector<HTMLElement>('#saldo-awal-anggota-empty');
  const saldoAwalAnggotaRows = Array.from(document.querySelectorAll<HTMLElement>('.saldo-awal-anggota-option'));
  const saldoAwalForm = saldoAwalAnggotaSearch?.closest('form');

  const hideSaldoAwalSuggestions = () => saldoAwalAnggotaOptions?.classList.add('hidden');

  saldoAwalAnggotaSearch?.addEventListener('input', () => {
    if (saldoAwalAnggotaId) saldoAwalAnggotaId.value = '';
    saldoAwalAnggotaSelected?.classList.add('hidden');
    saldoAwalAnggotaSearch.setCustomValidity('');

    const query = saldoAwalAnggotaSearch.value.trim().toLocaleLowerCase('id-ID');
    let matchCount = 0;
    saldoAwalAnggotaRows.forEach((option) => {
      const searchable = `${option.dataset.name || ''} ${option.dataset.phone || ''} ${option.dataset.regu || ''} ${option.dataset.tempekan || ''}`.toLocaleLowerCase('id-ID');
      const matches = query.length > 0 && searchable.includes(query);
      option.classList.toggle('hidden', !matches);
      option.setAttribute('aria-selected', 'false');
      if (matches) matchCount += 1;
    });

    saldoAwalAnggotaEmpty?.classList.toggle('hidden', matchCount > 0 || query.length === 0);
    saldoAwalAnggotaOptions?.classList.toggle('hidden', query.length === 0);
  });

  saldoAwalAnggotaRows.forEach((option) => {
    const selectSaldoAwalMember = () => {
      const id = option.dataset.id || '';
      const name = option.dataset.name || 'Anggota';
      const phone = option.dataset.phone || 'Tanpa nomor HP';
      const regu = option.dataset.regu || '-';
      const tempekan = option.dataset.tempekan || 'Tanpa tempekan';
      if (saldoAwalAnggotaId) saldoAwalAnggotaId.value = id;
      if (saldoAwalAnggotaSearch) {
        saldoAwalAnggotaSearch.value = name;
        saldoAwalAnggotaSearch.setCustomValidity('');
      }
      saldoAwalAnggotaRows.forEach((row) => row.setAttribute('aria-selected', String(row === option)));
      if (saldoAwalAnggotaSelected) {
        saldoAwalAnggotaSelected.textContent = `${name} · ${phone} · Regu ${regu} · ${tempekan}`;
        saldoAwalAnggotaSelected.classList.remove('hidden');
      }
      hideSaldoAwalSuggestions();
    };

    option.addEventListener('click', selectSaldoAwalMember);
    option.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        selectSaldoAwalMember();
      }
    });
  });

  saldoAwalForm?.addEventListener('submit', (event) => {
    if (!saldoAwalAnggotaId?.value) {
      event.preventDefault();
      saldoAwalAnggotaSearch?.focus();
      saldoAwalAnggotaSearch?.setCustomValidity('Cari lalu pilih anggota dari daftar hasil.');
      saldoAwalAnggotaSearch?.reportValidity();
    } else {
      saldoAwalAnggotaSearch?.setCustomValidity('');
    }
  });

  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !saldoAwalAnggotaOptions?.contains(event.target) && event.target !== saldoAwalAnggotaSearch) {
      hideSaldoAwalSuggestions();
    }
  });

  const updateEventAudienceOptions = () => {
    if (!jenisEventSelect || !targetStatusSelect || !passiveOption) return;
    const isAnnualFee = jenisEventSelect.value === 'TAHUNAN';
    passiveOption.disabled = !isAnnualFee;
    if (isAnnualFee) {
      targetStatusSelect.value = 'TIDAK_AKTIF';
      targetStatusNote && (targetStatusNote.textContent = 'Iuran tahunan hanya dikenakan kepada Numbas Ayahan.');
    } else {
      if (targetStatusSelect.value === 'TIDAK_AKTIF') targetStatusSelect.value = 'SEMUA';
      targetStatusNote && (targetStatusNote.textContent = 'Pilih Ngayah saja atau seluruh anggota Ngayah dan Numbas Ayahan.');
    }
  };

  jenisEventSelect?.addEventListener('change', updateEventAudienceOptions);
  updateEventAudienceOptions();

  const historyRowsContainer = document.querySelector<HTMLTableSectionElement>('#bendahara-history-rows');
  const historySortButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-history-sort]'));
  const historyPageSize = document.querySelector<HTMLSelectElement>('#history-page-size');
  const historyPageSummary = document.querySelector<HTMLElement>('#history-page-summary');
  const historyPageLinks = document.querySelector<HTMLElement>('#history-page-links');
  const historyPagePrevious = document.querySelector<HTMLButtonElement>('#history-page-previous');
  const historyPageNext = document.querySelector<HTMLButtonElement>('#history-page-next');
  const historySearch = document.querySelector<HTMLInputElement>('#history-search');
  const historyDateFrom = document.querySelector<HTMLInputElement>('#history-date-from');
  const historyDateTo = document.querySelector<HTMLInputElement>('#history-date-to');
  let currentHistoryPage = 1;
  let activeHistorySort = 'date';
  let activeHistoryDirection: 'asc' | 'desc' = 'desc';

  const updateHistoryPagination = () => {
    if (!historyRowsContainer) return;
    const allRows = Array.from(historyRowsContainer.querySelectorAll<HTMLTableRowElement>('.bendahara-history-row'));
    const rows = allRows.filter((row) => row.dataset.filterHidden !== 'true');
    const pageSize = Number(historyPageSize?.value || 10);
    const totalPages = Math.max(1, Math.ceil(rows.length / pageSize));
    currentHistoryPage = Math.min(Math.max(1, currentHistoryPage), totalPages);
    const startIndex = (currentHistoryPage - 1) * pageSize;
    const endIndex = Math.min(startIndex + pageSize, rows.length);

    allRows.forEach((row) => {
      const index = rows.indexOf(row);
      row.classList.toggle('hidden', index < 0 || index < startIndex || index >= endIndex);
    });

    if (historyPageSummary) {
      historyPageSummary.textContent = rows.length
        ? `Menampilkan ${startIndex + 1}-${endIndex} dari ${rows.length} baris cocok`
        : 'Tidak ada baris yang cocok';
    }
    if (historyPagePrevious) historyPagePrevious.disabled = currentHistoryPage <= 1;
    if (historyPageNext) historyPageNext.disabled = currentHistoryPage >= totalPages;

    if (historyPageLinks) {
      historyPageLinks.replaceChildren();
      let visiblePages: Array<number | 'ellipsis'>;
      if (totalPages <= 7) {
        visiblePages = Array.from({ length: totalPages }, (_, index) => index + 1);
      } else if (currentHistoryPage <= 4) {
        visiblePages = [1, 2, 3, 4, 5, 'ellipsis', totalPages];
      } else if (currentHistoryPage >= totalPages - 3) {
        visiblePages = [1, 'ellipsis', totalPages - 4, totalPages - 3, totalPages - 2, totalPages - 1, totalPages];
      } else {
        visiblePages = [1, 'ellipsis', currentHistoryPage - 1, currentHistoryPage, currentHistoryPage + 1, 'ellipsis', totalPages];
      }

      visiblePages.forEach((page) => {
        if (page === 'ellipsis') {
          const ellipsis = document.createElement('span');
          ellipsis.className = 'px-1 text-xs text-slate-400';
          ellipsis.textContent = '…';
          historyPageLinks.append(ellipsis);
          return;
        }

        const pageLink = document.createElement('a');
        pageLink.href = '#bendahara-history-report';
        pageLink.textContent = String(page);
        pageLink.setAttribute('aria-label', `Halaman ${page}`);
        pageLink.className = page === currentHistoryPage
          ? 'rounded-md bg-blue-700 px-2.5 py-1 text-xs font-bold text-white'
          : 'rounded-md px-2.5 py-1 text-xs font-semibold text-blue-700 hover:bg-blue-50 hover:underline';
        if (page === currentHistoryPage) pageLink.setAttribute('aria-current', 'page');
        pageLink.addEventListener('click', (event) => {
          event.preventDefault();
          currentHistoryPage = page;
          updateHistoryPagination();
        });
        historyPageLinks.append(pageLink);
      });
    }
  };

  const applyHistoryFilters = () => {
    if (!historyRowsContainer) return;
    const query = historySearch?.value.trim().toLocaleLowerCase('id-ID') || '';
    const dateFrom = historyDateFrom?.value || '';
    const dateTo = historyDateTo?.value || '';

    historyRowsContainer.querySelectorAll<HTMLTableRowElement>('.bendahara-history-row').forEach((row) => {
      const date = row.dataset.date || '';
      const matchesQuery = !query || (row.dataset.search || '').includes(query);
      const matchesFrom = !dateFrom || (date && date >= dateFrom);
      const matchesTo = !dateTo || (date && date <= dateTo);
      row.dataset.filterHidden = String(!(matchesQuery && matchesFrom && matchesTo));
    });

    currentHistoryPage = 1;
    updateHistoryPagination();
  };

  const sortHistory = (field: string, direction: 'asc' | 'desc') => {
    if (!historyRowsContainer) return;
    activeHistorySort = field;
    activeHistoryDirection = direction;
    currentHistoryPage = 1;
    const rows = Array.from(historyRowsContainer.querySelectorAll<HTMLTableRowElement>('.bendahara-history-row'));
    rows.sort((left, right) => {
      const dataField = field === 'member-status' ? 'memberStatus' : field;
      const leftValue = left.dataset[dataField] || '';
      const rightValue = right.dataset[dataField] || '';
      const isNumeric = ['debit', 'credit', 'balance'].includes(field);
      const comparison = isNumeric
        ? Number(leftValue) - Number(rightValue)
        : field === 'date'
          ? leftValue.localeCompare(rightValue)
          : leftValue.localeCompare(rightValue, 'id', { sensitivity: 'base', numeric: true });
      return direction === 'asc' ? comparison : -comparison;
    });
    rows.forEach((row) => historyRowsContainer.append(row));

    historySortButtons.forEach((button) => {
      const selected = button.dataset.historySort === field;
      const header = button.closest('th');
      if (header) header.setAttribute('aria-sort', selected ? (direction === 'asc' ? 'ascending' : 'descending') : 'none');
      const indicator = button.querySelector<HTMLElement>('[data-history-sort-indicator]');
      if (indicator) indicator.textContent = selected ? (direction === 'asc' ? '↑' : '↓') : '↕';
    });
    updateHistoryPagination();
  };

  historySortButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const field = button.dataset.historySort;
      if (!field) return;
      const direction = activeHistorySort === field && activeHistoryDirection === 'asc' ? 'desc' : 'asc';
      sortHistory(field, direction);
    });
  });
  sortHistory(activeHistorySort, activeHistoryDirection);

  historySearch?.addEventListener('input', applyHistoryFilters);
  historyDateFrom?.addEventListener('change', applyHistoryFilters);
  historyDateTo?.addEventListener('change', applyHistoryFilters);
  applyHistoryFilters();

  historyPageSize?.addEventListener('change', () => {
    currentHistoryPage = 1;
    updateHistoryPagination();
  });
  historyPagePrevious?.addEventListener('click', () => {
    currentHistoryPage -= 1;
    updateHistoryPagination();
  });
  historyPageNext?.addEventListener('click', () => {
    currentHistoryPage += 1;
    updateHistoryPagination();
  });

  const anggotaSearch = document.querySelector<HTMLInputElement>('#anggota-search');
  const anggotaId = document.querySelector<HTMLInputElement>('#anggota_id');
  const anggotaSuggestions = document.querySelector<HTMLUListElement>('#anggota-suggestions');
  const anggotaSelected = document.querySelector<HTMLElement>('#anggota-selected');
  const anggotaOptions = Array.from(document.querySelectorAll<HTMLElement>('.anggota-option'));
  const anggotaEmpty = document.querySelector<HTMLElement>('#anggota-empty');
  const dendaForm = anggotaSearch?.closest('form');

  const hideAnggotaSuggestions = () => anggotaSuggestions?.classList.add('hidden');

  anggotaSearch?.addEventListener('input', () => {
    if (anggotaId) anggotaId.value = '';
    anggotaSelected?.classList.add('hidden');

    const query = anggotaSearch.value.trim().toLocaleLowerCase('id-ID');
    let matchCount = 0;
    anggotaOptions.forEach((option) => {
      const searchable = `${option.dataset.name || ''} ${option.dataset.phone || ''} ${option.dataset.regu || ''}`.toLocaleLowerCase('id-ID');
      const matches = query.length > 0 && searchable.includes(query);
      option.classList.toggle('hidden', !matches);
      if (matches) matchCount += 1;
    });

    anggotaEmpty?.classList.toggle('hidden', matchCount > 0 || query.length === 0);
    anggotaSuggestions?.classList.toggle('hidden', query.length === 0);
  });

  anggotaOptions.forEach((option) => {
    option.addEventListener('click', () => {
      const id = option.dataset.id || '';
      const name = option.dataset.name || 'Anggota';
      const phone = option.dataset.phone || 'Tanpa nomor HP';
      const regu = option.dataset.regu || '-';
      if (anggotaId) anggotaId.value = id;
      if (anggotaSearch) anggotaSearch.value = name;
      if (anggotaSelected) {
        anggotaSelected.textContent = `${name} · ${phone} · Regu ${regu}`;
        anggotaSelected.classList.remove('hidden');
      }
      hideAnggotaSuggestions();
    });
  });

  dendaForm?.addEventListener('submit', (event) => {
    if (!anggotaId?.value) {
      event.preventDefault();
      anggotaSearch?.focus();
      anggotaSearch?.setCustomValidity('Cari lalu pilih anggota dari daftar saran.');
      anggotaSearch?.reportValidity();
    } else {
      anggotaSearch?.setCustomValidity('');
      dendaForm.querySelectorAll<HTMLButtonElement>('button[type="submit"]').forEach((button) => {
        button.disabled = true;
      });
    }
  });

  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !anggotaSuggestions?.contains(event.target) && event.target !== anggotaSearch) {
      hideAnggotaSuggestions();
    }
  });
</script>