  <!-- Script untuk Modal Edit (Menggunakan data-attribute agar aman dari Unterminated String Error) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const memberRowsContainer = document.getElementById('admin-member-rows');
      const sortButtons = Array.from(document.querySelectorAll('[data-admin-sort]'));
      const memberSearch = document.getElementById('admin-member-search');
      const memberCount = document.getElementById('admin-member-count');
      const noResultsRow = document.getElementById('admin-member-no-results');
      const memberPageSize = document.getElementById('admin-member-page-size');
      const memberPageLinks = document.getElementById('admin-member-page-links');
      const memberPagePrevious = document.getElementById('admin-member-page-previous');
      const memberPageNext = document.getElementById('admin-member-page-next');
      let activeSort = 'name';
      let activeDirection = 'asc';
      let memberPage = 1;

      const filterMembers = () => {
        if (!memberRowsContainer) return;
        const query = memberSearch?.value.trim().toLocaleLowerCase('id-ID') || '';
        const rows = Array.from(memberRowsContainer.querySelectorAll('.admin-member-row'));
        const matches = rows.filter((row) => (row.dataset.search || '').includes(query));
        const pageSize = Number(memberPageSize?.value || 10);
        const pageCount = Math.max(1, Math.ceil(matches.length / pageSize));
        memberPage = Math.min(Math.max(1, memberPage), pageCount);
        const start = (memberPage - 1) * pageSize;
        const end = Math.min(start + pageSize, matches.length);
        const pageRows = new Set(matches.slice(start, end));

        rows.forEach((row) => row.classList.toggle('hidden', !pageRows.has(row)));

        if (memberCount) {
          memberCount.textContent = matches.length
            ? `Menampilkan ${start + 1}-${end} dari ${matches.length} anggota`
            : rows.length ? 'Tidak ada anggota yang cocok dengan pencarian' : 'Belum ada anggota';
        }
        noResultsRow?.classList.toggle('hidden', matches.length > 0 || rows.length === 0);
        if (memberPagePrevious) memberPagePrevious.disabled = memberPage <= 1;
        if (memberPageNext) memberPageNext.disabled = memberPage >= pageCount;

        if (memberPageLinks) {
          memberPageLinks.replaceChildren();
          let pages;
          if (pageCount <= 7) pages = Array.from({ length: pageCount }, (_, index) => index + 1);
          else if (memberPage <= 4) pages = [1, 2, 3, 4, 5, '…', pageCount];
          else if (memberPage >= pageCount - 3) pages = [1, '…', pageCount - 4, pageCount - 3, pageCount - 2, pageCount - 1, pageCount];
          else pages = [1, '…', memberPage - 1, memberPage, memberPage + 1, '…', pageCount];

          pages.forEach((pageNumber) => {
            if (pageNumber === '…') {
              const ellipsis = document.createElement('span');
              ellipsis.className = 'px-1 text-xs text-slate-400';
              ellipsis.textContent = '…';
              memberPageLinks.append(ellipsis);
              return;
            }
            const link = document.createElement('a');
            link.href = '#admin-anggota-report';
            link.textContent = String(pageNumber);
            link.className = pageNumber === memberPage
              ? 'rounded-md bg-blue-700 px-2.5 py-1 text-xs font-bold text-white'
              : 'rounded-md px-2.5 py-1 text-xs font-semibold text-blue-700 hover:bg-blue-50';
            if (pageNumber === memberPage) link.setAttribute('aria-current', 'page');
            link.addEventListener('click', (event) => {
              event.preventDefault();
              memberPage = pageNumber;
              filterMembers();
            });
            memberPageLinks.append(link);
          });
        }
      };

      const sortMembers = (field, direction) => {
        if (!memberRowsContainer) return;
        activeSort = field;
        activeDirection = direction;

        const rows = Array.from(memberRowsContainer.querySelectorAll('.admin-member-row'));
        rows.sort((left, right) => {
          let leftValue = left.dataset[field] || '';
          let rightValue = right.dataset[field] || '';

          if (field === 'regu') {
            const reguOrder = (Number(leftValue) || Number.MAX_SAFE_INTEGER) - (Number(rightValue) || Number.MAX_SAFE_INTEGER);
            if (reguOrder !== 0) return direction === 'asc' ? reguOrder : -reguOrder;
            leftValue = `${left.dataset.tempekan || ''} ${left.dataset.address || ''}`;
            rightValue = `${right.dataset.tempekan || ''} ${right.dataset.address || ''}`;
          }

          const comparison = leftValue.localeCompare(rightValue, 'id', { sensitivity: 'base', numeric: true });
          return direction === 'asc' ? comparison : -comparison;
        });

        const emptyRow = memberRowsContainer.querySelector(':scope > tr:not(.admin-member-row)');
        rows.forEach((row) => memberRowsContainer.insertBefore(row, emptyRow));
        memberPage = 1;

        sortButtons.forEach((button) => {
          const selected = button.dataset.adminSort === field;
          const header = button.closest('th');
          if (header) header.setAttribute('aria-sort', selected ? (direction === 'asc' ? 'ascending' : 'descending') : 'none');
          const indicator = button.querySelector('[data-admin-sort-indicator]');
          if (indicator) indicator.textContent = selected ? (direction === 'asc' ? '↑' : '↓') : '↕';
        });
        filterMembers();
      };

      sortButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const field = button.dataset.adminSort;
          if (!field) return;
          const direction = activeSort === field && activeDirection === 'asc' ? 'desc' : 'asc';
          sortMembers(field, direction);
        });
      });
      sortMembers(activeSort, activeDirection);
      memberSearch?.addEventListener('input', () => {
        memberPage = 1;
        filterMembers();
      });
      memberPageSize?.addEventListener('change', () => {
        memberPage = 1;
        filterMembers();
      });
      memberPagePrevious?.addEventListener('click', () => {
        memberPage -= 1;
        filterMembers();
      });
      memberPageNext?.addEventListener('click', () => {
        memberPage += 1;
        filterMembers();
      });

      document.querySelectorAll('[data-admin-pagination]').forEach((pagination) => {
        const bodyId = pagination.dataset.adminPagination;
        const body = bodyId ? document.getElementById(bodyId) : null;
        const section = pagination.closest('section');
        const search = section?.querySelector('[data-admin-table-search]');
        const pageSizeSelect = pagination.querySelector('[data-admin-page-size]');
        const pageSummary = pagination.querySelector('[data-admin-page-summary]');
        const pageLinks = pagination.querySelector('[data-admin-page-links]');
        const previousButton = pagination.querySelector('[data-admin-page-previous]');
        const nextButton = pagination.querySelector('[data-admin-page-next]');
        const tableSortButtons = Array.from(section?.querySelectorAll('[data-admin-table-sort]') || []);
        if (!body || !pageSizeSelect || !pageLinks) return;

        let currentPage = 1;
        const initialSortButton = tableSortButtons.find((button) => button.closest('th')?.getAttribute('aria-sort') !== 'none') || tableSortButtons[0];
        let activeSortField = initialSortButton?.dataset.adminTableSort || '';
        let activeSortDirection = initialSortButton?.closest('th')?.getAttribute('aria-sort') === 'descending' ? 'desc' : 'asc';

        const updateTable = () => {
          const allRows = Array.from(body.querySelectorAll('.admin-page-row'));
          const query = search?.value.trim().toLocaleLowerCase('id-ID') || '';
          const matchingRows = allRows.filter((row) => (row.dataset.adminSearch || '').includes(query));
          const pageSize = Number(pageSizeSelect.value || 10);
          const totalPages = Math.max(1, Math.ceil(matchingRows.length / pageSize));
          currentPage = Math.min(Math.max(1, currentPage), totalPages);
          const start = (currentPage - 1) * pageSize;
          const end = Math.min(start + pageSize, matchingRows.length);
          const visibleRows = new Set(matchingRows.slice(start, end));
          allRows.forEach((row) => row.classList.toggle('hidden', !visibleRows.has(row)));

          let emptyRow = body.querySelector('[data-admin-no-results]');
          if (!emptyRow) {
            emptyRow = document.createElement('tr');
            emptyRow.dataset.adminNoResults = 'true';
            emptyRow.className = 'hidden';
            const cell = document.createElement('td');
            cell.colSpan = section?.querySelectorAll('thead th').length || 1;
            cell.className = 'p-6 text-center text-slate-400';
            cell.textContent = 'Tidak ada data yang cocok dengan pencarian.';
            emptyRow.append(cell);
            body.append(emptyRow);
          }
          emptyRow.classList.toggle('hidden', matchingRows.length > 0 || allRows.length === 0);
          if (pageSummary) pageSummary.textContent = matchingRows.length
            ? `Menampilkan ${start + 1}-${end} dari ${matchingRows.length} baris`
            : allRows.length ? 'Tidak ada hasil yang cocok' : 'Tidak ada data';
          if (previousButton) previousButton.disabled = currentPage <= 1;
          if (nextButton) nextButton.disabled = currentPage >= totalPages;

          let pages;
          if (totalPages <= 7) pages = Array.from({ length: totalPages }, (_, index) => index + 1);
          else if (currentPage <= 4) pages = [1, 2, 3, 4, 5, '…', totalPages];
          else if (currentPage >= totalPages - 3) pages = [1, '…', totalPages - 4, totalPages - 3, totalPages - 2, totalPages - 1, totalPages];
          else pages = [1, '…', currentPage - 1, currentPage, currentPage + 1, '…', totalPages];

          pageLinks.replaceChildren();
          pages.forEach((pageNumber) => {
            if (pageNumber === '…') {
              const ellipsis = document.createElement('span');
              ellipsis.className = 'px-1 text-xs text-slate-400';
              ellipsis.textContent = '…';
              pageLinks.append(ellipsis);
              return;
            }
            const link = document.createElement('a');
            link.href = '#';
            link.textContent = String(pageNumber);
            link.setAttribute('aria-label', `Halaman ${pageNumber}`);
            link.className = pageNumber === currentPage
              ? 'rounded-md bg-blue-700 px-2.5 py-1 text-xs font-bold text-white'
              : 'rounded-md px-2.5 py-1 text-xs font-semibold text-blue-700 hover:bg-blue-50';
            if (pageNumber === currentPage) link.setAttribute('aria-current', 'page');
            link.addEventListener('click', (event) => {
              event.preventDefault();
              currentPage = pageNumber;
              updateTable();
            });
            pageLinks.append(link);
          });
        };

        tableSortButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const field = button.dataset.adminTableSort;
            if (!field) return;
            const nextDirection = activeSortField === field && activeSortDirection === 'asc' ? 'desc' : 'asc';
            const dataKey = field.replace(/-([a-z])/g, (_, letter) => letter.toUpperCase());
            const rows = Array.from(body.querySelectorAll('.admin-page-row'));
            const isNumeric = field.endsWith('amount');
            rows.sort((left, right) => {
              const leftValue = left.dataset[dataKey] || '';
              const rightValue = right.dataset[dataKey] || '';
              const compare = isNumeric
                ? Number(leftValue) - Number(rightValue)
                : leftValue.localeCompare(rightValue, 'id', { sensitivity: 'base', numeric: true });
              return nextDirection === 'asc' ? compare : -compare;
            });
            const empty = body.querySelector('[data-admin-no-results]');
            rows.forEach((row) => body.insertBefore(row, empty));
            activeSortField = field;
            activeSortDirection = nextDirection;
            currentPage = 1;
            tableSortButtons.forEach((sortButton) => {
              const isActive = sortButton.dataset.adminTableSort === field;
              const heading = sortButton.closest('th');
              if (heading) heading.setAttribute('aria-sort', isActive ? (nextDirection === 'asc' ? 'ascending' : 'descending') : 'none');
              const indicator = sortButton.querySelector('[data-admin-table-sort-indicator]');
              if (indicator) indicator.textContent = isActive ? (nextDirection === 'asc' ? '↑' : '↓') : '↕';
            });
            updateTable();
          });
        });

        search?.addEventListener('input', () => {
          currentPage = 1;
          updateTable();
        });
        pageSizeSelect.addEventListener('change', () => {
          currentPage = 1;
          updateTable();
        });
        previousButton?.addEventListener('click', () => {
          currentPage -= 1;
          updateTable();
        });
        nextButton?.addEventListener('click', () => {
          currentPage += 1;
          updateTable();
        });
        if (activeSortField) {
          const dataKey = activeSortField.replace(/-([a-z])/g, (_, letter) => letter.toUpperCase());
          const rows = Array.from(body.querySelectorAll('.admin-page-row'));
          rows.sort((left, right) => {
            const leftValue = left.dataset[dataKey] || '';
            const rightValue = right.dataset[dataKey] || '';
            const isNumeric = activeSortField.endsWith('amount');
            const compare = isNumeric
              ? Number(leftValue) - Number(rightValue)
              : leftValue.localeCompare(rightValue, 'id', { sensitivity: 'base', numeric: true });
            return activeSortDirection === 'asc' ? compare : -compare;
          });
          rows.forEach((row) => body.append(row));
        }
        updateTable();
      });

      document.querySelectorAll('.btn-edit').forEach(button => {
        button.addEventListener('click', () => {
          try {
            const krama = JSON.parse(button.getAttribute('data-krama'));
            
            document.getElementById('edit_id').value = krama.id || '';
            document.getElementById('edit_user_id').value = krama.user_id || '';
            document.getElementById('edit_foto_url').value = krama.foto_url || '';
            document.getElementById('edit_nama_lengkap').value = krama.nama_lengkap || '';
            document.getElementById('edit_no_hp').value = krama.no_hp || '';
            document.getElementById('edit_email').value = krama.email || '';
            document.getElementById('edit_role').value = krama.role || 'KRAMA';
            document.getElementById('edit_no_regu').value = krama.no_regu || '';
            document.getElementById('edit_tempekan').value = krama.tempekan || '';
            document.getElementById('edit_tanggal_lahir').value = krama.tanggal_lahir ? krama.tanggal_lahir.slice(0, 10) : '';
            document.getElementById('edit_status_perkawinan').value = krama.status_perkawinan || '';
            document.getElementById('edit_alamat').value = krama.alamat || '';
            document.getElementById('edit_status_aktif').value = krama.status_aktif || 'AKTIF';
            
            document.getElementById('editModal').classList.remove('hidden');
            document.getElementById('editModal').classList.add('flex');
          } catch (e) {
            console.error("Gagal memuat data edit krama:", e);
          }
        });
      });
    });

    function closeEditModal() {
      document.getElementById('editModal').classList.add('hidden');
      document.getElementById('editModal').classList.remove('flex');
    }
  </script>
</LayoutDashboard>