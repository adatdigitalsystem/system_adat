---
import LayoutDashboard from '../../layouts/LayoutDashboard.astro';
import { supabase } from '../../lib/supabase';
import { formatRupiah, labelStatusKeanggotaan } from '../../lib/utils';

// Handle Add / Edit Krama
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const id = formData.get('id') as string;
  const nik_no_krama = formData.get('nik_no_krama') as string;
  const nama_lengkap = formData.get('nama_lengkap') as string;
  const no_hp = formData.get('no_hp') as string;
  const status_krama = formData.get('status_krama') as string;
  const saldo_awal_tunggakan = parseFloat(formData.get('saldo_awal_tunggakan') as string || '0');

  const payload = { nik_no_krama, nama_lengkap, no_hp, status_krama, saldo_awal_tunggakan };

  if (id) {
    await supabase.from('anggota').update(payload).eq('id', id);
  } else {
    await supabase.from('anggota').insert([payload]);
  }
}

// Fetch Master Krama
const { data: listKrama } = await supabase.from('anggota').select('*').order('nama_lengkap', { ascending: true });
---

<LayoutDashboard title="Manajemen Data Krama - Banjar Adat Dharma Sadhu Dukuh">
  <div class="max-w-6xl mx-auto p-4 space-y-6">
    <div class="bg-white p-6 rounded-xl shadow-md border border-slate-100">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-slate-800">Master Data Krama Banjar</h2>
      </div>

      <!-- Tabel List Krama -->
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left text-slate-600">
          <thead class="bg-slate-100 text-xs text-slate-700 uppercase">
            <tr>
              <th class="p-3">No. Krama</th>
              <th class="p-3">Nama Lengkap</th>
              <th class="p-3">No. HP (WhatsApp)</th>
              <th class="p-3 text-center">Status</th>
              <th class="p-3 text-right">Saldo Awal Tunggakan</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            {listKrama?.map((krama) => (
              <tr class="hover:bg-slate-50">
                <td class="p-3 font-medium">{krama.nik_no_krama || '-'}</td>
                <td class="p-3 font-semibold text-slate-800">{krama.nama_lengkap}</td>
                <td class="p-3">{krama.no_hp}</td>
                <td class="p-3 text-center">
                  <span class={`px-2 py-1 text-xs font-bold rounded-full ${
                    krama.status_krama === 'AKTIF' ? 'bg-blue-100 text-blue-800' : 'bg-purple-100 text-purple-800'
                  }`}>
                    {labelStatusKeanggotaan(krama.status_krama)}
                  </span>
                </td>
                <td class="p-3 text-right font-bold text-slate-700">{formatRupiah(krama.saldo_awal_tunggakan)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</LayoutDashboard>