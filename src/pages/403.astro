---
import LayoutMain from '../layouts/LayoutMain.astro';
---

<LayoutMain title="Akses Ditolak - 403">
  <div class="min-h-screen bg-slate-900 text-white flex flex-col items-center justify-center p-4 text-center">
    <div class="w-20 h-20 bg-red-500/10 border border-red-500/30 rounded-full flex items-center justify-center text-red-500 text-3xl mb-4">
      🚫
    </div>
    <h1 class="text-4xl font-black text-white mb-2">403 - Akses Ditolak</h1>
    <p class="text-sm text-slate-400 max-w-md mb-6">
      Akun Anda tidak memiliki hak akses (*role*) yang cukup untuk membuka halaman portal ini.
    </p>
    <div class="flex space-x-3">
      <a href="/" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white text-sm font-semibold rounded-xl transition">
        Beranda
      </a>
      <a href="/login" class="px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-slate-950 text-sm font-bold rounded-xl transition">
        Ganti Akun
      </a>
    </div>
  </div>
</LayoutMain>