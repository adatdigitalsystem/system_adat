---
import LayoutDashboard from '../../layouts/LayoutDashboard.astro';
import { supabase } from '../../lib/supabase';
import { createSupabaseAdminClient } from '../../lib/supabaseAdmin';
import { getGoogleDriveImageUrl } from '../../lib/googleDrivePublic';
import { labelStatusKeanggotaan } from '../../lib/utils';
import PrintReportButton from '../../components/common/PrintReportButton.astro';
import ProfilePhoto from '../../components/common/ProfilePhoto.astro';

let notice = Astro.url.searchParams.get('sukses')?.slice(0, 300) || '';
let noticeIsError = false;
const formatRupiah = (val: number) =>
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val || 0);

const accessToken = Astro.cookies.get('sb-access-token')?.value;
let kepalaProfile: { id: string; no_regu: string | null; regu_id: string | null; tempekan: string | null; nama_lengkap: string; role: string | null } | null = null;

if (accessToken) {
  const { data: { user } } = await supabase.auth.getUser(accessToken);
  if (user) {
    const { data } = await supabase
      .from('anggota')
      .select('id, no_regu, regu_id, tempekan, nama_lengkap, role')
      .eq('user_id', user.id)
      .maybeSingle();
    kepalaProfile = data;
  }
}

const dataClient = kepalaProfile ? createSupabaseAdminClient() : supabase;
const kepalaRole = (kepalaProfile?.role || '').toUpperCase().replace(/[\s_-]/g, '');
const isKepalaRegu = kepalaRole === 'SINOMAN';
const isReadOnlyReguViewer = ['ADMIN', 'BENDAHARA'].includes(kepalaRole);
const isBendahara = kepalaRole === 'BENDAHARA';

const { data: anggotaDenganTempekan } = await dataClient.from('anggota').select('tempekan');
const daftarTempekan = [...new Set((anggotaDenganTempekan || [])
  .map((anggota) => anggota.tempekan?.trim())
  .filter((tempekan): tempekan is string => Boolean(tempekan)))]
  .sort((left, right) => left.localeCompare(right, 'id', { numeric: true, sensitivity: 'base' }))
  .map((tempekan) => ({ value: tempekan, nama_regu: tempekan }));

const requestedTempekan = Astro.url.searchParams.get('tempekan');
const assignedTempekan = kepalaProfile?.tempekan?.trim() || null;
const selectedRegu = isKepalaRegu
  ? (assignedTempekan ? { value: assignedTempekan, nama_regu: assignedTempekan } : null)
  : isReadOnlyReguViewer
    ? daftarTempekan.find((tempekan) => tempekan.value === requestedTempekan) || null
    : null;
const selectedTempekan = selectedRegu?.value || null;
const selectedReguValue = selectedTempekan;
const reguKepala = selectedRegu?.nama_regu || null;
const namaKepala = isBendahara ? `${kepalaProfile?.nama_lengkap || 'Bendahara'} (Bendahara)` : isReadOnlyReguViewer ? `${kepalaProfile?.nama_lengkap || 'Admin'} (Admin)` : kepalaProfile?.nama_lengkap || 'Sinoman';

let anggotaRegu: any[] = [];
if (selectedTempekan) {
  const { data } = await dataClient
    .from('anggota')
    .select('*')
    .eq('tempekan', selectedTempekan)
    .order('nama_lengkap', { ascending: true });
  anggotaRegu = data || [];
}

// Sinoman bekerja pada tempekannya sendiri; Bendahara/Admin dapat bertindak untuk tempekan yang dipilih.
const canCollectPayments = Boolean(kepalaProfile) && (isKepalaRegu || (isReadOnlyReguViewer && Boolean(selectedRegu)));
const anggotaReguIds = new Set(anggotaRegu.map((anggota) => anggota.id));
const kepalaReguIds = isReadOnlyReguViewer
  ? anggotaRegu.filter((anggota) => (anggota.role || '').toUpperCase().replace(/[\s_-]/g, '') === 'SINOMAN').map((anggota) => anggota.id)
  : kepalaProfile?.id ? [kepalaProfile.id] : [];
// Penerima kas yang sah untuk tempekan ini: Sinoman terkait, ditambah Bendahara/Admin bila ia yang bertindak.
const penerimaKasIds = [...new Set([...kepalaReguIds, ...(isReadOnlyReguViewer && kepalaProfile ? [kepalaProfile.id] : [])])];

if (Astro.request.method === 'POST') {
  try {
    if (!accessToken || !kepalaProfile) throw new Error('Sesi tidak valid. Silakan login kembali.');
    if (isReadOnlyReguViewer && !selectedRegu) throw new Error('Pilih tempekan terlebih dahulu sebelum menerima pembayaran atau menyetor.');
    if (!canCollectPayments) {
      throw new Error('Aksi pungutan dan setoran hanya dapat dilakukan oleh Sinoman, Bendahara, atau Admin.');
    }
    const formData = await Astro.request.formData();
    const action = formData.get('action_type')?.toString();

    if (action === 'KUMPULKAN_TAGIHAN') {
      const tagihanId = formData.get('tagihan_id')?.toString();
      const nominalBayar = Number(formData.get('nominal_bayar'));
      if (!tagihanId || !Number.isFinite(nominalBayar) || nominalBayar <= 0) {
        throw new Error('Pilih tagihan dan masukkan nominal pembayaran yang valid.');
      }

      const { data: tagihan, error: tagihanError } = await dataClient
        .from('tagihan_krama')
        .select('id, anggota_id, total_nominal, nominal, jumlah_dibayar, status_bayar, keterangan, event_adat_id')
        .eq('id', tagihanId)
        .maybeSingle();
      if (tagihanError) throw tagihanError;
      if (!tagihan) throw new Error('Tagihan tidak ditemukan.');

      if (!anggotaReguIds.has(tagihan.anggota_id)) {
        throw new Error('Anda hanya dapat menerima pembayaran dari anggota tempekan yang sedang dikelola.');
      }
      const anggota = { id: tagihan.anggota_id };

      const totalNominal = Number(tagihan.total_nominal ?? tagihan.nominal ?? 0);
      const jumlahDibayar = Number(tagihan.jumlah_dibayar || 0);
      const sisaTagihan = Math.max(0, totalNominal - jumlahDibayar);
      if (nominalBayar > sisaTagihan) {
        throw new Error('Nominal pembayaran melebihi sisa kewajiban.');
      }
      if (['LUNAS', 'COLLECTED_BY_REGU'].includes((tagihan.status_bayar || '').toUpperCase()) || sisaTagihan <= 0) {
        throw new Error('Tagihan ini sudah lunas atau menunggu penyetoran ke Bendahara.');
      }

      const { data: previousPayments, error: previousPaymentsError } = await dataClient
        .from('riwayat_pembayaran_cicilan')
        .select('setoran_regu_id')
        .eq('tagihan_krama_id', tagihan.id)
        .not('setoran_regu_id', 'is', null);
      if (previousPaymentsError) throw previousPaymentsError;

      const submittedDepositIds = [...new Set((previousPayments || [])
        .map((payment) => payment.setoran_regu_id)
        .filter((id): id is string => Boolean(id)))];
      if (submittedDepositIds.length) {
        const { data: pendingDeposit, error: pendingDepositError } = await dataClient
          .from('setoran_regu')
          .select('id')
          .in('id', submittedDepositIds)
          .eq('status_verifikasi', 'PENDING')
          .limit(1)
          .maybeSingle();
        if (pendingDepositError) throw pendingDepositError;
        if (pendingDeposit) throw new Error('Pembayaran untuk tagihan ini sedang menunggu verifikasi Bendahara.');
      }

      const { data: payment, error: paymentError } = await dataClient.from('riwayat_pembayaran_cicilan').insert({
        tagihan_krama_id: tagihan.id,
        anggota_id: anggota.id,
        diterima_oleh: kepalaProfile.id,
        nominal_bayar: nominalBayar,
        metode_pembayaran: 'CASH_REGU',
        keterangan: isReadOnlyReguViewer ? `Pembayaran tunai diterima ${isBendahara ? 'Bendahara' : 'Admin'} atas nama tempekan` : 'Pembayaran tunai diterima Sinoman',
      }).select('id').single();
      if (paymentError) throw paymentError;

      const totalBaru = jumlahDibayar + nominalBayar;
      const statusBaru = totalBaru >= totalNominal ? 'COLLECTED_BY_REGU' : 'PARTIAL';
      const { error: updateError } = await dataClient
        .from('tagihan_krama')
        .update({ jumlah_dibayar: totalBaru, status_bayar: statusBaru, updated_at: new Date().toISOString() })
        .eq('id', tagihan.id);
      if (updateError) {
        if (payment?.id) await dataClient.from('riwayat_pembayaran_cicilan').delete().eq('id', payment.id);
        throw updateError;
      }

      notice = `Pembayaran ${formatRupiah(nominalBayar)} berhasil dicatat.`;
    } else if (action === 'AJUKAN_SETORAN') {
      if (!kepalaProfile.id) throw new Error('ID Sinoman tidak ditemukan.');

      const { data: payments, error: paymentsError } = await dataClient
        .from('riwayat_pembayaran_cicilan')
        .select('id, nominal_bayar')
        .in('diterima_oleh', penerimaKasIds)
        .in('anggota_id', [...anggotaReguIds].length ? [...anggotaReguIds] : ['00000000-0000-0000-0000-000000000000'])
        .is('setoran_regu_id', null);
      if (paymentsError) throw paymentsError;

      const totalSetoran = (payments || []).reduce((total, payment) => total + Number(payment.nominal_bayar || 0), 0);
      if (!payments?.length || totalSetoran <= 0) throw new Error('Belum ada uang terkumpul yang dapat diajukan.');

      const { data: setoran, error: depositError } = await dataClient
        .from('setoran_regu')
        .insert({
          regu_id: kepalaProfile.regu_id || null,
          kepala_regu_id: kepalaProfile.id,
          total_nominal: totalSetoran,
          status_verifikasi: 'PENDING',
          keterangan: `Penyetoran ${payments.length} transaksi pembayaran anggota Tempekan ${reguKepala || '-'}${isReadOnlyReguViewer ? ` (diajukan oleh ${isBendahara ? 'Bendahara' : 'Admin'})` : ''}`,
        })
        .select('id')
        .single();
      if (depositError) throw depositError;

      const { error: linkError } = await dataClient
        .from('riwayat_pembayaran_cicilan')
        .update({ setoran_regu_id: setoran.id })
        .in('id', payments.map((payment) => payment.id));
      if (linkError) {
        await dataClient.from('setoran_regu').delete().eq('id', setoran.id);
        throw linkError;
      }

      notice = `Pengajuan setoran ${formatRupiah(totalSetoran)} (${payments.length} transaksi) berhasil dikirim ke Bendahara.`;
    } else {
      throw new Error('Aksi tidak dikenali.');
    }
  } catch (err: any) {
    notice = err?.message || 'Gagal memproses pembayaran atau setoran.';
    noticeIsError = true;
  }

  // Post/Redirect/Get: muat ulang halaman tidak mengirim ulang form dan menggandakan transaksi.
  if (notice && !noticeIsError) {
    const target = new URL(Astro.url);
    target.searchParams.set('sukses', notice);
    return Astro.redirect(`${target.pathname}${target.search}`, 303);
  }
}

// Ambil daftar event adat dan tagihan kewajiban anggota pada tempekan terpilih
const { data: listEvent } = await dataClient
  .from('event_adat')
  .select('*')
  .order('tanggal_event', { ascending: false });

const anggotaIds = anggotaRegu?.map(a => a.id) || [];
  let tagihanQuery = dataClient
  .from('tagihan_krama')
  .select('*, event_adat(nama_event), anggota(nama_lengkap)')
    .in('status_bayar', ['BELUM_LUNAS', 'BELUM_BAYAR', 'UNPAID', 'PARTIAL', 'COLLECTED_BY_REGU']);
  if (anggotaIds.length) tagihanQuery = tagihanQuery.in('anggota_id', anggotaIds);
  const { data: listTagihan } = anggotaIds.length ? await tagihanQuery : { data: [] };

const { data: paymentsBelumDisetor } = await dataClient
  .from('riwayat_pembayaran_cicilan')
  .select('nominal_bayar')
  .in('diterima_oleh', penerimaKasIds.length ? penerimaKasIds : ['00000000-0000-0000-0000-000000000000'])
  .in('anggota_id', anggotaReguIds.size ? [...anggotaReguIds] : ['00000000-0000-0000-0000-000000000000'])
  .is('setoran_regu_id', null);
const totalBelumDisetor = (paymentsBelumDisetor || []).reduce((total, payment) => total + Number(payment.nominal_bayar || 0), 0);

---

<LayoutDashboard title="Portal Sinoman - Banjar Adat" role={kepalaProfile?.role || 'SINOMAN'}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">

    {notice && (
      <div class={`rounded-xl border p-4 text-sm font-semibold ${noticeIsError ? 'border-red-200 bg-red-50 text-red-800' : 'border-emerald-200 bg-emerald-50 text-emerald-800'}`} role="status">
        {notice}
      </div>
    )}
    
    <!-- Header Portal Sinoman -->
    <div class="bg-slate-900 text-white p-6 rounded-2xl shadow-lg border border-slate-800 flex flex-col md:flex-row justify-between md:items-center gap-4">
      <div>
        <span class="text-xs font-bold px-3 py-1 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-full">
          {isReadOnlyReguViewer ? `Mode ${isBendahara ? 'Bendahara' : 'Admin'} - Bertindak untuk Tempekan` : 'Portal Sinoman'} {reguKepala ? `- ${reguKepala}` : ''}
        </span>
        <h1 class="text-xl md:text-2xl font-black mt-2">{isReadOnlyReguViewer ? 'Pemantauan Anggota & Kewajiban Tempekan' : 'Pengelolaan Anggota & Kewajiban Tempekan'}</h1>
      </div>
      <div class="text-xs text-slate-400">
        <span>{isReadOnlyReguViewer ? 'Diakses oleh' : 'Sinoman'}: <strong class="text-white">{namaKepala}</strong></span>
      </div>
    </div>

    {isReadOnlyReguViewer && (
      <form action="/sinoman" method="GET" class="no-print flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-4 sm:flex-row sm:items-end">
        <label class="flex-1 space-y-1">
          <span class="block text-[11px] font-bold uppercase text-slate-600">Pilih Tempekan untuk Dipantau</span>
          <select name="tempekan" required class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800">
            <option value="">Pilih tempekan</option>
            {daftarTempekan.map((tempekan) => <option value={tempekan.value} selected={tempekan.value === selectedReguValue}>{tempekan.nama_regu}</option>)}
          </select>
        </label>
        <button type="submit" class="rounded-lg bg-amber-500 px-4 py-2 text-sm font-bold text-slate-950 hover:bg-amber-600">Tampilkan Tempekan</button>
      </form>
    )}

    {isReadOnlyReguViewer && !selectedRegu && (
      <div class="rounded-xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-900">
        Pilih tempekan di atas untuk melihat anggota, kewajiban event, dan kas yang belum disetorkan. Setelah memilih tempekan, Anda dapat menerima pembayaran dan mengajukan setoran seperti Sinoman.
      </div>
    )}

    <!-- Grid Utama: Daftar Anggota Tempekan & Kewajiban Event -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Kolom 1 & 2: Daftar Anggota Tempekan (Tanpa No Telp, Nama sebagai Hyperlink) -->
      <div id="sinoman-anggota-report" class="lg:col-span-2 bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
        <div class="flex justify-between items-center">
          <h2 class="text-base font-bold text-slate-800">Daftar Anggota Krama di Tempekan Anda (Tempekan {reguKepala || '-'})</h2>
          <div class="flex items-center gap-3">
            <span class="text-xs text-slate-500">Total: {anggotaRegu?.length || 0} Orang</span>
            <PrintReportButton targetId="sinoman-anggota-report" title={`Daftar Anggota Tempekan ${reguKepala || ''}`} />
          </div>
        </div>

        <label class="block max-w-md space-y-1">
          <span class="text-[11px] font-bold uppercase text-slate-500">Cari nama anggota</span>
          <input
            id="anggota-search"
            type="search"
            placeholder="Ketik nama anggota..."
            class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-800 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
            autocomplete="off"
          />
        </label>

        <div class="overflow-x-auto">
          <table class="w-full text-xs text-left text-slate-600">
            <thead class="bg-slate-50 text-slate-500 uppercase border-b border-slate-200">
              <tr>
                <th class="p-3">Nama Anggota (Detail)</th>
                <th class="p-3">Tempekan</th>
                <th class="p-3">Status</th>
                <th class="p-3 text-center">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {anggotaRegu && anggotaRegu.length > 0 ? (
                anggotaRegu.map((item) => (
                  <tr class="hover:bg-slate-50" data-member-row data-member-name={item.nama_lengkap || ''}>
                    <td class="p-3 font-semibold text-slate-900">
                      <!-- Nama sebagai Hyperlink ke Detail Anggota -->
                      <a href={`/krama/detail?id=${item.id}`} class="text-blue-600 hover:underline flex items-center gap-2">
                        <ProfilePhoto
                          src={getGoogleDriveImageUrl(item.foto_url || item.foto || item.foto_drive_id)}
                          alt={`Foto ${item.nama_lengkap}`}
                          fallbackText={item.nama_lengkap?.trim().charAt(0).toLocaleUpperCase('id-ID') || '?'}
                          className="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-full bg-amber-100"
                          imageClass="h-full w-full object-cover"
                          fallbackClass="flex h-full w-full items-center justify-center rounded-full text-sm font-black text-amber-900"
                        />
                        <span>{item.nama_lengkap}</span>
                      </a>
                    </td>
                    <td class="p-3">{item.tempekan || '-'}</td>
                    <td class="p-3">
                      <span class={`px-2 py-0.5 rounded-full text-[10px] font-bold ${
                        item.status_aktif === 'TIDAK_AKTIF' ? 'bg-red-100 text-red-800' : 'bg-emerald-100 text-emerald-800'
                      }`}>
                        {labelStatusKeanggotaan(item.status_aktif)}
                      </span>
                    </td>
                    <td class="p-3 text-center">
                      <a href={`/krama/detail?id=${item.id}`} class="px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-lg transition">
                        Lihat Profil
                      </a>
                    </td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colspan="4" class="p-6 text-center text-slate-400 italic">Tidak ada anggota terdaftar dalam tempekan ini.</td>
                </tr>
              )}
              <tr id="anggota-search-empty" hidden>
                <td colspan="4" class="p-6 text-center text-slate-400 italic">Tidak ada anggota yang cocok dengan nama tersebut.</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div id="anggota-pagination" class="no-print flex items-center justify-between gap-3 text-xs text-slate-600" hidden>
          <span id="anggota-page-info"></span>
          <div class="flex flex-wrap items-center gap-1" id="anggota-pages">
            <button type="button" id="anggota-prev" aria-label="Halaman sebelumnya" class="rounded-lg border border-slate-300 px-3 py-1.5 font-bold hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">&lt;</button>
            <span id="anggota-numbers" class="hidden flex-wrap items-center gap-1 sm:flex"></span>
            <button type="button" id="anggota-next" aria-label="Halaman berikutnya" class="rounded-lg border border-slate-300 px-3 py-1.5 font-bold hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">&gt;</button>
          </div>
        </div>
      </div>

      <!-- Kolom 3: Ringkasan Status Tempekan -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
        <h2 class="text-base font-bold text-slate-800">Ringkasan Tempekan</h2>
        <div class="space-y-3">
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-100">
            <p class="text-xs text-slate-500">Total Krama Tempekan</p>
            <p class="text-xl font-black text-slate-900 mt-1">{anggotaRegu?.length || 0} Anggota</p>
          </div>
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-100">
            <p class="text-xs text-slate-500">Total Tagihan Belum Lunas (Tempekan)</p>
            <p class="text-xl font-black text-amber-600 mt-1">{listTagihan?.length || 0} Tagihan</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Bagian Bawah: Daftar Kewajiban Anggota Dikelompokkan Berdasarkan Event -->
    <div id="sinoman-kewajiban-report" class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-6">
      <div>
        <h2 class="text-base font-bold text-slate-800">Daftar Kewajiban Anggota (Belum Disetor ke Bendahara)</h2>
        <p class="text-xs text-slate-500 mt-0.5">Catat uang yang diterima dari anggota. Tagihan lunas akan menunggu pengajuan setoran ke Bendahara.</p>
        <div class="mt-3">
          <PrintReportButton targetId="sinoman-kewajiban-report" title={`Laporan Kewajiban Tempekan ${reguKepala || ''}`} />
        </div>
      </div>

      {listEvent && listEvent.length > 0 ? (
        <div class="space-y-6">
          {listEvent.map((evt) => {
            // Saring tagihan yang sesuai dengan event ini dan anggota tempekan
            const tagihanEvent = listTagihan?.filter(t => t.event_adat_id === evt.id) || [];
            
            if (tagihanEvent.length === 0) return null; // Sembunyikan event jika tidak ada kewajiban

            return (
              <div data-obligation-event class="border border-slate-200 rounded-2xl p-4 space-y-3 bg-slate-50/50">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-slate-200 pb-3">
                  <div>
                    <span class="text-[10px] font-bold px-2.5 py-0.5 bg-amber-100 text-amber-800 rounded-full">{evt.jenis_event}</span>
                    <h3 class="text-sm font-black text-slate-900 mt-1">{evt.nama_event}</h3>
                  </div>
                  <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:items-center">
                    <label class="no-print">
                      <span class="sr-only">Cari nama krama untuk event {evt.nama_event}</span>
                      <input
                        type="search"
                        data-obligation-search
                        placeholder="Cari nama krama..."
                        class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-700 placeholder:text-slate-400 sm:w-56"
                      />
                    </label>
                    <span class="text-xs text-slate-500 font-medium">Tanggal: {evt.tanggal_event || '-'}</span>
                  </div>
                </div>

                <div class="overflow-x-auto">
                  <table class="w-full text-xs text-left text-slate-600">
                    <thead class="text-slate-400 uppercase border-b border-slate-200">
                      <tr>
                        <th class="py-2">Nama Krama</th>
                        <th class="py-2">Keterangan</th>
                        <th class="py-2 text-right">Nominal Kewajiban</th>
                        <th class="py-2 text-right">Sudah Dikumpulkan</th>
                        <th class="py-2 text-right">Sisa</th>
                        <th class="py-2 text-center">Aksi</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                      {tagihanEvent.map((tagih) => (
                        <tr data-obligation-row data-member-name={(tagih.anggota?.nama_lengkap || 'Krama').toLocaleLowerCase('id')}>
                          <td class="py-2.5 font-semibold text-slate-900">
                            <a href={`/krama/detail?id=${tagih.anggota_id}`} class="text-blue-600 hover:underline">
                              {tagih.anggota?.nama_lengkap || 'Krama'}
                            </a>
                          </td>
                          <td class="py-2.5">{tagih.keterangan || 'Iuran Event'}</td>
                          <td class="py-2.5 text-right font-bold text-slate-900">{formatRupiah(Number(tagih.total_nominal ?? tagih.nominal ?? 0))}</td>
                          <td class="py-2.5 text-right">{formatRupiah(Number(tagih.jumlah_dibayar || 0))}</td>
                          <td class="py-2.5 text-right font-semibold">{formatRupiah(Math.max(0, Number(tagih.total_nominal ?? tagih.nominal ?? 0) - Number(tagih.jumlah_dibayar || 0)))}</td>
                          <td class="py-2.5 text-center">
                            {!canCollectPayments ? (
                              <span class="inline-block rounded-full bg-slate-100 px-2 py-1 text-[10px] font-bold text-slate-600">Mode lihat</span>
                            ) : tagih.status_bayar === 'COLLECTED_BY_REGU' ? (
                              <span class="inline-block rounded-full bg-blue-100 px-2 py-1 text-[10px] font-bold text-blue-800">Terkumpul</span>
                            ) : (
                              <form method="POST" class="flex min-w-36 items-center justify-center gap-1">
                                <input type="hidden" name="action_type" value="KUMPULKAN_TAGIHAN" />
                                <input type="hidden" name="tagihan_id" value={tagih.id} />
                                <input
                                  type="number"
                                  name="nominal_bayar"
                                  min="1"
                                  max={Math.max(0, Number(tagih.total_nominal ?? tagih.nominal ?? 0) - Number(tagih.jumlah_dibayar || 0))}
                                  step="1"
                                  required
                                  value={Math.max(0, Number(tagih.total_nominal ?? tagih.nominal ?? 0) - Number(tagih.jumlah_dibayar || 0))}
                                  aria-label={`Nominal pembayaran ${tagih.anggota?.nama_lengkap || 'anggota'}`}
                                  class="w-24 rounded border border-slate-300 px-2 py-1 text-right text-[11px]"
                                />
                                <button type="submit" class="whitespace-nowrap rounded bg-emerald-600 px-2 py-1 font-bold text-white hover:bg-emerald-700">Terima</button>
                              </form>
                            )}
                          </td>
                        </tr>
                      ))}
                      <tr data-obligation-empty hidden>
                        <td colspan="6" class="py-4 text-center text-slate-400 italic">Nama krama tidak ditemukan pada event ini.</td>
                      </tr>
                    </tbody>
                    <tfoot class="border-t-2 border-slate-300 bg-slate-50 font-bold text-slate-900">
                      {(() => {
                        const subtotalKewajiban = tagihanEvent.reduce((sum, t) => sum + Number(t.total_nominal ?? t.nominal ?? 0), 0);
                        const subtotalDikumpulkan = tagihanEvent.reduce((sum, t) => sum + Number(t.jumlah_dibayar || 0), 0);
                        return (
                          <tr>
                            <td class="py-2.5" colspan="2">Subtotal</td>
                            <td class="py-2.5 text-right">{formatRupiah(subtotalKewajiban)}</td>
                            <td class="py-2.5 text-right">{formatRupiah(subtotalDikumpulkan)}</td>
                            <td class="py-2.5 text-right">{formatRupiah(Math.max(0, subtotalKewajiban - subtotalDikumpulkan))}</td>
                            <td></td>
                          </tr>
                        );
                      })()}
                    </tfoot>
                  </table>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-8 text-slate-400 italic text-xs">
          Belum ada event atau kewajiban aktif saat ini.
        </div>
      )}
    </div>

    <section id="sinoman-setoran-report" class="flex flex-col gap-4 rounded-xl border border-slate-800 bg-slate-900 p-5 text-white sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-sm font-bold text-amber-300">Setorkan Kas Terkumpul ke Bendahara</h2>
        <p class="mt-1 text-xs text-slate-300">Pembayaran yang belum pernah diajukan akan dimasukkan ke satu pengajuan setoran.</p>
        <p class="mt-2 text-xl font-black text-amber-300">{formatRupiah(totalBelumDisetor)}</p>
      </div>
      <div class="no-print flex flex-wrap items-center gap-2">
      <PrintReportButton targetId="sinoman-setoran-report" title={`Rekap Kas Terkumpul Tempekan ${reguKepala || ''}`} />
      {canCollectPayments && <form method="POST">
        <input type="hidden" name="action_type" value="AJUKAN_SETORAN" />
        <button type="submit" disabled={totalBelumDisetor <= 0} class="rounded-lg bg-amber-500 px-4 py-2.5 text-xs font-bold text-slate-950 hover:bg-amber-600 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400">
          Ajukan Setoran ke Bendahara
        </button>
      </form>}
      </div>
    </section>

  </div>
</LayoutDashboard>

<style is:global>
  @media print {
    tr[data-member-row] { display: table-row !important; }
    tr[data-obligation-row] { display: table-row !important; }
  }
</style>

<script>
  const PAGE_SIZE = 10;
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-member-row]'));
  const nav = document.getElementById('anggota-pagination');
  const info = document.getElementById('anggota-page-info');
  const prev = document.getElementById('anggota-prev') as HTMLButtonElement | null;
  const next = document.getElementById('anggota-next') as HTMLButtonElement | null;
  const numbers = document.getElementById('anggota-numbers');
  const search = document.getElementById('anggota-search') as HTMLInputElement | null;
  const emptyState = document.getElementById('anggota-search-empty');
  let filteredRows = rows;
  let page = 1;

  function render() {
    const totalPages = Math.max(1, Math.ceil(filteredRows.length / PAGE_SIZE));
    rows.forEach((row) => {
      row.style.display = 'none';
    });
    filteredRows.forEach((row, index) => {
      row.style.display = Math.floor(index / PAGE_SIZE) + 1 === page ? '' : 'none';
    });
    if (emptyState) emptyState.hidden = filteredRows.length > 0 || !search?.value.trim();
    if (info) info.textContent = `Halaman ${page} dari ${totalPages} (${filteredRows.length} anggota)`;
    if (prev) prev.disabled = page <= 1;
    if (next) next.disabled = page >= totalPages;
    if (nav) nav.hidden = filteredRows.length <= PAGE_SIZE;
    if (numbers) {
      numbers.replaceChildren(...Array.from({ length: totalPages }, (_, i) => {
        const number = i + 1;
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = String(number);
        button.className = number === page
          ? 'rounded-lg border border-blue-600 bg-blue-600 px-3 py-1.5 font-bold text-white'
          : 'rounded-lg border border-slate-300 px-3 py-1.5 font-bold hover:bg-slate-50';
        if (number === page) button.setAttribute('aria-current', 'page');
        button.addEventListener('click', () => { page = number; render(); });
        return button;
      }));
    }
  }

  search?.addEventListener('input', () => {
    const query = search.value.trim().toLocaleLowerCase('id');
    filteredRows = rows.filter((row) => (row.dataset.memberName || '').toLocaleLowerCase('id').includes(query));
    page = 1;
    render();
  });
  prev?.addEventListener('click', () => { page = Math.max(1, page - 1); render(); });
  next?.addEventListener('click', () => {
    page = Math.min(Math.ceil(filteredRows.length / PAGE_SIZE), page + 1);
    render();
  });
  render();

  document.querySelectorAll<HTMLElement>('[data-obligation-event]').forEach((eventTable) => {
    const search = eventTable.querySelector<HTMLInputElement>('[data-obligation-search]');
    const obligationRows = Array.from(eventTable.querySelectorAll<HTMLTableRowElement>('[data-obligation-row]'));
    const emptyState = eventTable.querySelector<HTMLTableRowElement>('[data-obligation-empty]');

    search?.addEventListener('input', () => {
      const query = search.value.trim().toLocaleLowerCase('id');
      let visibleRows = 0;

      obligationRows.forEach((row) => {
        const matches = (row.dataset.memberName || '').includes(query);
        row.hidden = !matches;
        if (matches) visibleRows += 1;
      });

      if (emptyState) emptyState.hidden = visibleRows > 0;
    });
  });
</script>
