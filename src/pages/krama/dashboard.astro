---
import LayoutDashboard from '../../layouts/LayoutDashboard.astro';
import { supabase } from '../../lib/supabase';
import { createSupabaseAdminClient } from '../../lib/supabaseAdmin';
import { getGoogleDriveImageUrl } from '../../lib/googleDrivePublic';
import { labelStatusKeanggotaan } from '../../lib/utils';
import PrintReportButton from '../../components/common/PrintReportButton.astro';
import ProfilePhoto from '../../components/common/ProfilePhoto.astro';

const accessToken = Astro.cookies.get('sb-access-token')?.value;
let profile: any = null;
let listTagihan: any[] = [];
let totalTunggakan = 0;
let ledgerRows: any[] = [];
let anggotaRegu: any[] = [];
let anggotaReguError = '';

if (accessToken) {
  const { data: { user } } = await supabase.auth.getUser(accessToken);
  if (user) {
    const { data: profileData } = await supabase
      .from('anggota')
      .select('*')
      .eq('user_id', user.id)
      .maybeSingle();

    profile = profileData;

    if (profile) {
      if (profile.no_regu?.trim()) {
        const { data: anggotaReguData, error: anggotaReguQueryError } = await createSupabaseAdminClient()
          .from('anggota')
          .select('id, nama_lengkap, no_regu, no_hp, alamat, role, foto_url, foto, foto_drive_id')
          .eq('no_regu', profile.no_regu.trim())
          .order('nama_lengkap', { ascending: true });

        anggotaRegu = anggotaReguData || [];
        anggotaReguError = anggotaReguQueryError?.message || '';
      }

      const { data: tagihanData } = await supabase
        .from('tagihan_krama')
        .select('*, event_adat(nama_event)')
        .eq('anggota_id', profile.id)
        .order('created_at', { ascending: false });

      listTagihan = tagihanData || [];
      const statusBelumLunas = new Set(['BELUM_LUNAS', 'BELUM_BAYAR', 'UNPAID', 'PARTIAL']);
      totalTunggakan = listTagihan
        .filter((tagihan) => statusBelumLunas.has((tagihan.status_bayar || '').toUpperCase()))
        .reduce((sum, item) => {
          const totalNominal = Number(item.total_nominal ?? item.nominal ?? 0);
          return sum + Math.max(0, totalNominal - Number(item.jumlah_dibayar || 0));
        }, 0);

      // Dibatasi ke anggota yang sedang login; klien server dipakai agar riwayat pembayaran sendiri selalu terbaca.
      const { data: paymentData } = await createSupabaseAdminClient()
        .from('riwayat_pembayaran_cicilan')
        .select('id, tagihan_krama_id, nominal_bayar, tanggal_bayar, metode_pembayaran, keterangan, created_at')
        .eq('anggota_id', profile.id);

      const payments = paymentData || [];
      const paidByBill = new Map<string, number>();
      for (const payment of payments) {
        if (!payment.tagihan_krama_id) continue;
        paidByBill.set(payment.tagihan_krama_id, (paidByBill.get(payment.tagihan_krama_id) || 0) + Number(payment.nominal_bayar || 0));
      }

      const toTimestamp = (date: string) => {
        const value = Date.parse(`${date}T12:00:00`);
        return Number.isNaN(value) ? 0 : value;
      };
      const entries: any[] = [];
      for (const bill of listTagihan) {
        const date = bill.tanggal_kejadian || bill.created_at?.split('T')[0] || '';
        const ts = toTimestamp(date);
        const nominal = Number(bill.total_nominal ?? bill.nominal ?? 0);
        entries.push({
          id: `tagihan-${bill.id}`,
          tanggal: date,
          timestamp: ts,
          order: 0,
          noBukti: `TAG-${bill.id.slice(0, 8).toUpperCase()}`,
          keterangan: bill.keterangan || bill.jenis_tagihan || bill.event_adat?.nama_event || 'Tagihan kewajiban',
          debit: nominal,
          kredit: 0,
        });
        const unitemized = Math.max(0, Number(bill.jumlah_dibayar || 0) - (paidByBill.get(bill.id) || 0));
        if (unitemized > 0) {
          entries.push({
            id: `rekonsiliasi-${bill.id}`,
            tanggal: date,
            timestamp: ts,
            order: 1,
            noBukti: `SALDO-${bill.id.slice(0, 8).toUpperCase()}`,
            keterangan: `Saldo pembayaran lama; rincian transaksi tidak tersedia (${bill.keterangan || 'tagihan'})`,
            debit: 0,
            kredit: unitemized,
          });
        }
      }
      for (const payment of payments) {
        const date = payment.tanggal_bayar?.split('T')[0] || payment.created_at?.split('T')[0] || '';
        const parsed = payment.tanggal_bayar ? Date.parse(payment.tanggal_bayar) : toTimestamp(date);
        entries.push({
          id: `pembayaran-${payment.id}`,
          tanggal: date,
          timestamp: Number.isNaN(parsed) ? 0 : parsed,
          order: 2,
          noBukti: `BYR-${payment.id.slice(0, 8).toUpperCase()}`,
          keterangan: payment.keterangan || `Pembayaran ${payment.metode_pembayaran || 'diterima'}`,
          debit: 0,
          kredit: Number(payment.nominal_bayar || 0),
        });
      }
      entries.sort((a, b) => a.timestamp - b.timestamp || a.order - b.order || a.id.localeCompare(b.id));
      let runningBalance = 0;
      for (const entry of entries) {
        runningBalance += entry.debit - entry.kredit;
        entry.saldo = runningBalance;
      }
      ledgerRows = entries;
    }
  }
}

// Fungsi hitung umur dari tanggal lahir
const hitungUmur = (tanggalLahir: string) => {
  if (!tanggalLahir) return '-';
  const lahir = new Date(tanggalLahir);
  const sekarang = new Date();
  let umur = sekarang.getFullYear() - lahir.getFullYear();
  const m = sekarang.getMonth() - lahir.getMonth();
  if (m < 0 || (m === 0 && sekarang.getDate() < lahir.getDate())) {
    umur--;
  }
  return `${umur} Tahun`;
};

const formatRupiah = (val: number) => 
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);
---

<LayoutDashboard title="Dashboard Krama - Banjar Adat Dharma Sadhu Dukuh">
  <div id="krama-dashboard-report" class="max-w-5xl mx-auto p-4 space-y-6">
    <div class="flex justify-end">
      <PrintReportButton targetId="krama-dashboard-report" title="Kartu Kewajiban Krama" label="Cetak Kartu Kewajiban" />
    </div>
    
    <!-- Header Ringkasan Krama dengan Foto, Tempekan, No Telp, dan Umur -->
    <div class="bg-slate-900 text-white p-6 rounded-2xl shadow-lg border border-slate-800 flex flex-col md:flex-row justify-between md:items-center gap-6">
      <div class="flex items-center gap-4">
        <!-- Foto Profil -->
        <ProfilePhoto
          src={getGoogleDriveImageUrl(profile?.foto_url || profile?.foto || profile?.foto_drive_id)}
          alt={`Foto ${profile?.nama_lengkap || 'Krama'}`}
          fallbackText={profile?.nama_lengkap?.trim().charAt(0).toLocaleUpperCase('id-ID') || '?'}
          className="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full border-2 border-amber-500 bg-slate-800"
          imageClass="h-full w-full object-cover"
          fallbackClass="flex h-full w-full items-center justify-center rounded-full bg-slate-700 text-xl font-bold text-slate-200"
          loading="eager"
        />

        <div>
          <span class={`text-xs font-semibold px-3 py-1 border rounded-full ${profile?.status_aktif === 'TIDAK_AKTIF' ? 'bg-slate-700/70 text-slate-200 border-slate-500' : 'bg-amber-500/20 text-amber-400 border-amber-500/30'}`}>
            {labelStatusKeanggotaan(profile?.status_aktif)}
          </span>
          <h1 class="text-xl sm:text-2xl font-black mt-2">{profile?.nama_lengkap || 'Krama Adat'}</h1>
          <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-400 mt-1">
            <span>Tempekan: <strong class="text-slate-200">{profile?.tempekan || '-'}</strong></span>
            <span>Regu: <strong class="text-slate-200">{profile?.no_regu || '-'}</strong></span>
            <span>No. Telp / WA: <strong class="text-slate-200">{profile?.no_hp || '-'}</strong></span>
            <span>Umur: <strong class="text-slate-200">{hitungUmur(profile?.tanggal_lahir)}</strong></span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 text-right min-w-40">
          <p class="text-xs text-slate-400">Total Tunggakan Adat</p>
          <p class="text-xl sm:text-2xl font-extrabold text-amber-400">{formatRupiah(totalTunggakan)}</p>
        </div>
      </div>
    </div>

    <!-- Buku Besar Kewajiban -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
      <h2 class="text-base font-bold text-slate-800 mb-1">Rincian Tagihan & Denda</h2>
      <p class="mb-4 text-xs text-slate-500">Debet menambah kewajiban, kredit adalah pembayaran, saldo adalah sisa kewajiban berjalan.</p>
      <div class="overflow-x-auto">
        <table id="krama-ledger-table" class="w-full text-sm text-left text-slate-600">
          <thead class="bg-slate-50 text-xs text-slate-500 uppercase border-b border-slate-200">
            <tr>
              <th class="p-3">Tanggal</th>
              <th class="hidden p-3 sm:table-cell">No. Bukti</th>
              <th class="p-3">Keterangan</th>
              <th class="p-3 text-right">Debet</th>
              <th class="p-3 text-right">Kredit</th>
              <th class="p-3 text-right">Saldo</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {ledgerRows.length > 0 ? (
              ledgerRows.map((row) => (
                <tr class="krama-ledger-row hover:bg-slate-50">
                  <td class="whitespace-nowrap p-3">{row.tanggal || '-'}</td>
                  <td class="hidden whitespace-nowrap p-3 font-mono text-xs font-semibold sm:table-cell">{row.noBukti}</td>
                  <td class="max-w-sm whitespace-pre-wrap p-3 text-slate-800">{row.keterangan}</td>
                  <td class="whitespace-nowrap p-3 text-right font-semibold text-red-800">{row.debit > 0 ? formatRupiah(row.debit) : '-'}</td>
                  <td class="whitespace-nowrap p-3 text-right font-semibold text-emerald-800">{row.kredit > 0 ? formatRupiah(row.kredit) : '-'}</td>
                  <td class="whitespace-nowrap p-3 text-right font-bold text-slate-900">{formatRupiah(row.saldo)}</td>
                </tr>
              ))
            ) : (
              <tr>
                <td colspan="6" class="p-6 text-center text-slate-400 italic">Belum ada catatan tagihan.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
      {ledgerRows.length > 0 && (
        <div id="krama-ledger-pagination" class="mt-4 flex flex-col gap-3 border-t border-slate-100 pt-4 sm:flex-row sm:items-center sm:justify-between">
          <p id="krama-ledger-summary" class="text-xs text-slate-500"></p>
          <div class="flex items-center justify-between gap-2 sm:justify-end">
            <button id="krama-ledger-prev" type="button" aria-label="Halaman sebelumnya" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">
              <span aria-hidden="true" class="sm:hidden">←</span>
              <span class="hidden sm:inline">Sebelumnya</span>
            </button>
            <div id="krama-ledger-pages" class="flex items-center gap-1"></div>
            <button id="krama-ledger-next" type="button" aria-label="Halaman berikutnya" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">
              <span aria-hidden="true" class="sm:hidden">→</span>
              <span class="hidden sm:inline">Berikutnya</span>
            </button>
          </div>
        </div>
      )}
    </div>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="mb-5">
        <p class="text-xs font-bold uppercase text-blue-700">Direktori Regu</p>
        <h2 class="mt-1 text-base font-bold text-slate-900">
          Anggota Regu {profile?.no_regu?.trim() ? profile.no_regu : '-'}
        </h2>
        <p class="mt-1 text-xs text-slate-500">Daftar anggota dengan nomor regu yang sama dengan Anda.</p>
      </div>

      {anggotaReguError && (
        <p role="alert" class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800">
          Gagal memuat daftar anggota regu: {anggotaReguError}
        </p>
      )}

      {!profile?.no_regu?.trim() ? (
        <p class="rounded-lg bg-slate-50 px-4 py-6 text-center text-sm text-slate-500">
          Nomor regu Anda belum tercatat.
        </p>
      ) : anggotaReguError ? null : anggotaRegu.length ? (
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
          {anggotaRegu.map((item) => (
            <li class="flex gap-4 rounded-lg border border-slate-200 p-4">
              <ProfilePhoto
                src={getGoogleDriveImageUrl(item.foto_url || item.foto || item.foto_drive_id)}
                alt={`Foto ${item.nama_lengkap}`}
                fallbackText={item.nama_lengkap?.trim().charAt(0).toLocaleUpperCase('id-ID') || '?'}
                className="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full bg-amber-100"
                imageClass="h-full w-full object-cover"
                fallbackClass="flex h-full w-full items-center justify-center rounded-full text-xl font-black text-amber-900"
              />
              <dl class="min-w-0 space-y-2 text-sm">
                <div>
                  <dt class="sr-only">Nama</dt>
                  <dd class="break-words font-bold text-slate-900">{item.nama_lengkap || '-'}</dd>
                </div>
                <div>
                  <dt class="text-[10px] font-bold uppercase text-slate-500">Kontak</dt>
                  <dd class="break-words text-slate-700">{item.no_hp || '-'}</dd>
                </div>
                <div>
                  <dt class="text-[10px] font-bold uppercase text-slate-500">Alamat</dt>
                  <dd class="whitespace-pre-wrap break-words text-slate-700">{item.alamat || '-'}</dd>
                </div>
                <div>
                  <dt class="text-[10px] font-bold uppercase text-slate-500">Role</dt>
                  <dd class="text-slate-700">{item.role || 'KRAMA'}</dd>
                </div>
              </dl>
            </li>
          ))}
        </ul>
      ) : (
        <p class="rounded-lg bg-slate-50 px-4 py-6 text-center text-sm text-slate-500">
          Belum ada anggota lain yang terdaftar pada regu ini.
        </p>
      )}
    </section>

  </div>

  <script>
    const ledgerTable = document.getElementById('krama-ledger-table') as HTMLTableElement | null;
    const pagination = document.getElementById('krama-ledger-pagination');

    if (ledgerTable && pagination) {
      const rows = Array.from(ledgerTable.querySelectorAll<HTMLTableRowElement>('tbody .krama-ledger-row'));
      const summary = document.getElementById('krama-ledger-summary');
      const pageLinks = document.getElementById('krama-ledger-pages');
      const previousButton = document.getElementById('krama-ledger-prev') as HTMLButtonElement | null;
      const nextButton = document.getElementById('krama-ledger-next') as HTMLButtonElement | null;
      const pageSize = 10;
      let currentPage = 1;

      const renderPagination = () => {
        const pageCount = Math.max(1, Math.ceil(rows.length / pageSize));
        currentPage = Math.min(Math.max(currentPage, 1), pageCount);
        const start = (currentPage - 1) * pageSize;
        const end = Math.min(start + pageSize, rows.length);

        rows.forEach((row, index) => {
          row.classList.toggle('hidden', index < start || index >= end);
        });

        if (summary) {
          summary.textContent = rows.length > 0
            ? `Menampilkan ${start + 1}-${end} dari ${rows.length} rincian`
            : 'Tidak ada rincian';
        }
        if (previousButton) previousButton.disabled = currentPage <= 1;
        if (nextButton) nextButton.disabled = currentPage >= pageCount;

        if (pageLinks) {
          pageLinks.replaceChildren();
          const first = Math.max(1, currentPage - 2);
          const last = Math.min(pageCount, first + 4);
          for (let page = first; page <= last; page += 1) {
            const button = document.createElement('button');
            button.type = 'button';
            button.textContent = String(page);
            button.className = page === currentPage
              ? 'min-w-8 rounded-lg bg-slate-900 px-2 py-2 text-xs font-bold text-white'
              : 'min-w-8 rounded-lg border border-slate-200 px-2 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50';
            button.setAttribute('aria-current', page === currentPage ? 'page' : 'false');
            button.addEventListener('click', () => {
              currentPage = page;
              renderPagination();
            });
            pageLinks.append(button);
          }
        }
      };

      previousButton?.addEventListener('click', () => {
        currentPage -= 1;
        renderPagination();
      });
      nextButton?.addEventListener('click', () => {
        currentPage += 1;
        renderPagination();
      });
      renderPagination();
    }
  </script>
</LayoutDashboard>
