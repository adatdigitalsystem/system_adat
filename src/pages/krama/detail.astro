---
import LayoutDashboard from '../../layouts/LayoutDashboard.astro';
import { supabase } from '../../lib/supabase';
import { createSupabaseAdminClient } from '../../lib/supabaseAdmin';
import { getGoogleDriveImageUrl } from '../../lib/googleDrivePublic';
import { labelStatusKeanggotaan } from '../../lib/utils';
import PrintReportButton from '../../components/common/PrintReportButton.astro';
import ProfilePhoto from '../../components/common/ProfilePhoto.astro';

const accessToken = Astro.cookies.get('sb-access-token')?.value;
if (!accessToken) return Astro.redirect('/login');

const { data: { user } } = await supabase.auth.getUser(accessToken);
if (!user) return Astro.redirect('/login');

const memberId = Astro.url.searchParams.get('id');
if (!memberId) return Astro.redirect('/krama/dashboard');

const { data: viewer } = await supabase
  .from('anggota')
  .select('id, role, no_regu, tempekan')
  .eq('user_id', user.id)
  .maybeSingle();

if (!viewer) return Astro.redirect('/login');

const viewerRole = (viewer.role || 'KRAMA').toUpperCase().replace(/[\\s_-]/g, '');
const isAdmin = viewerRole === 'ADMIN';
const isStaff = ['ADMIN', 'PENGURUS', 'BENDAHARA'].includes(viewerRole);
const isSinoman = viewerRole === 'SINOMAN';
const isKepalaRegu = ['KEPALAREGU', 'KEPALAREGM', 'KEPALAREGUTEMPEKAN'].includes(viewerRole);

const { data: anggota, error } = await supabase
  .from('anggota')
  .select('*')
  .eq('id', memberId)
  .maybeSingle();

if (error || !anggota) return Astro.redirect('/krama/dashboard');

const mayView = isStaff
  || (isKepalaRegu && anggota.no_regu === viewer.no_regu)
  || (isSinoman && anggota.tempekan && anggota.tempekan === viewer.tempekan)
  || (!isKepalaRegu && !isStaff && anggota.id === viewer.id);

if (!mayView) return Astro.redirect('/krama/dashboard');

const returnPath = isKepalaRegu
  ? '/kepalaregu'
  : isSinoman
    ? '/sinoman'
    : isAdmin
    ? '/admin/dashboard'
    : viewerRole === 'PENGURUS'
      ? '/pengurus/dashboard'
      : '/krama/dashboard';
const profilePhoto = getGoogleDriveImageUrl(anggota.foto_url || anggota.foto || anggota.foto_drive_id);

const { data: tagihanSemua } = await supabase
  .from('tagihan_krama')
  .select('*, event_adat(nama_event)')
  .eq('anggota_id', anggota.id)
  .order('created_at', { ascending: false });
const statusBelumLunas = new Set(['BELUM_LUNAS', 'BELUM_BAYAR', 'UNPAID', 'PARTIAL']);
const daftarTunggakan = (tagihanSemua || [])
  .filter((tagihan) => statusBelumLunas.has((tagihan.status_bayar || '').toUpperCase()))
  .map((tagihan) => {
    const total = Number(tagihan.total_nominal ?? tagihan.nominal ?? 0);
    const dibayar = Number(tagihan.jumlah_dibayar || 0);
    const jenis = tagihan.jenis_tagihan || tagihan.event_adat?.nama_event || (tagihan.keterangan?.match(/^\[([^\]]+)\]/)?.[1]) || 'Iuran';
    return { ...tagihan, jenis, sisa: Math.max(0, total - dibayar) };
  });
// Akses sudah divalidasi lewat mayView; klien server dipakai agar riwayat pembayaran terbaca.
const { data: paymentData } = await createSupabaseAdminClient()
  .from('riwayat_pembayaran_cicilan')
  .select('id, tagihan_krama_id, nominal_bayar, tanggal_bayar, metode_pembayaran, keterangan, created_at')
  .eq('anggota_id', anggota.id);
const payments = paymentData || [];
const paidByBill = new Map<string, number>();
for (const payment of payments) {
  if (!payment.tagihan_krama_id) continue;
  paidByBill.set(payment.tagihan_krama_id, (paidByBill.get(payment.tagihan_krama_id) || 0) + Number(payment.nominal_bayar || 0));
}
const toTimestamp = (date: string) => {
  const value = Date.parse(`${date}T12:00:00`);
  return Number.isNaN(value) ? 0 : value;
};
const ledgerRows: any[] = [];
for (const bill of tagihanSemua || []) {
  const date = bill.tanggal_kejadian || bill.created_at?.split('T')[0] || '';
  const ts = toTimestamp(date);
  ledgerRows.push({
    id: `tagihan-${bill.id}`,
    tanggal: date,
    timestamp: ts,
    order: 0,
    noBukti: `TAG-${bill.id.slice(0, 8).toUpperCase()}`,
    keterangan: bill.keterangan || bill.jenis_tagihan || bill.event_adat?.nama_event || 'Tagihan kewajiban',
    debit: Number(bill.total_nominal ?? bill.nominal ?? 0),
    kredit: 0,
  });
  const unitemized = Math.max(0, Number(bill.jumlah_dibayar || 0) - (paidByBill.get(bill.id) || 0));
  if (unitemized > 0) {
    ledgerRows.push({
      id: `rekonsiliasi-${bill.id}`,
      tanggal: date,
      timestamp: ts,
      order: 1,
      noBukti: `SALDO-${bill.id.slice(0, 8).toUpperCase()}`,
      keterangan: `Saldo pembayaran lama; rincian transaksi tidak tersedia (${bill.keterangan || 'tagihan'})`,
      debit: 0,
      kredit: unitemized,
    });
  }
}
for (const payment of payments) {
  const date = payment.tanggal_bayar?.split('T')[0] || payment.created_at?.split('T')[0] || '';
  const parsed = payment.tanggal_bayar ? Date.parse(payment.tanggal_bayar) : toTimestamp(date);
  ledgerRows.push({
    id: `pembayaran-${payment.id}`,
    tanggal: date,
    timestamp: Number.isNaN(parsed) ? 0 : parsed,
    order: 2,
    noBukti: `BYR-${payment.id.slice(0, 8).toUpperCase()}`,
    keterangan: payment.keterangan || `Pembayaran ${payment.metode_pembayaran || 'diterima'}`,
    debit: 0,
    kredit: Number(payment.nominal_bayar || 0),
  });
}
ledgerRows.sort((a, b) => a.timestamp - b.timestamp || a.order - b.order || a.id.localeCompare(b.id));
let runningBalance = 0;
for (const row of ledgerRows) {
  runningBalance += row.debit - row.kredit;
  row.saldo = runningBalance;
}
const totalTunggakan = Math.max(0, runningBalance);
const totalDenda = daftarTunggakan
  .filter((tagihan) => /denda/i.test(`${tagihan.jenis} ${tagihan.keterangan || ''}`))
  .reduce((total, tagihan) => total + tagihan.sisa, 0);

const formatRupiah = (value: number) => new Intl.NumberFormat('id-ID', {
  style: 'currency',
  currency: 'IDR',
  maximumFractionDigits: 0,
}).format(value);

const hitungUmur = (tanggalLahir: string | null | undefined) => {
  if (!tanggalLahir) return '-';
  const lahir = new Date(`${tanggalLahir}T00:00:00`);
  if (Number.isNaN(lahir.getTime()) || lahir > new Date()) return '-';

  const sekarang = new Date();
  let umur = sekarang.getFullYear() - lahir.getFullYear();
  if (
    sekarang.getMonth() < lahir.getMonth()
    || (sekarang.getMonth() === lahir.getMonth() && sekarang.getDate() < lahir.getDate())
  ) {
    umur -= 1;
  }
  return `${umur} tahun`;
};

const formatTanggal = (value: string | null | undefined) => {
  if (!value) return '-';
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? value : date.toLocaleDateString('id-ID');
};
---

<LayoutDashboard title={`Profil ${anggota.nama_lengkap} - Banjar Adat`} role={viewer.role || 'KRAMA'}>
  <main id="krama-detail-report" class="max-w-4xl mx-auto space-y-6 px-4 sm:px-6 lg:px-8">
    <div class="no-print flex flex-wrap items-center justify-between gap-3">
    <a href={returnPath} class="inline-flex items-center gap-2 text-sm font-semibold text-blue-700 hover:text-blue-900">
      <span aria-hidden="true">&larr;</span> Kembali
    </a>
    <PrintReportButton targetId="krama-detail-report" title={`Profil dan Kewajiban ${anggota.nama_lengkap}`} label="Cetak Profil & Kewajiban" />
    </div>

    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <header class="flex flex-col gap-5 border-b border-slate-200 bg-slate-900 p-6 text-white sm:flex-row sm:items-center">
        <ProfilePhoto
          src={profilePhoto}
          alt={`Foto ${anggota.nama_lengkap}`}
          fallbackText={anggota.nama_lengkap?.trim().charAt(0).toLocaleUpperCase('id-ID') || '?'}
          className="flex h-24 w-24 shrink-0 items-center justify-center overflow-hidden rounded-full border-2 border-white/30 bg-amber-500"
          imageClass="h-full w-full object-cover"
          fallbackClass="flex h-full w-full items-center justify-center rounded-full text-3xl font-black text-slate-950"
        />
        <div>
          <p class="text-xs font-bold uppercase text-amber-300">Profil Anggota Regu {anggota.no_regu || '-'}</p>
          <h1 class="mt-1 text-2xl font-black">{anggota.nama_lengkap || 'Profil Anggota'}</h1>
          <p class="mt-2 text-sm text-slate-300">{anggota.tempekan || 'Tempekan belum diisi'}</p>
        </div>
      </header>

      <dl class="grid grid-cols-1 gap-x-8 sm:grid-cols-2">
        <div class="border-b border-slate-100 p-5">
          <dt class="text-xs font-bold uppercase text-slate-500">Status Keanggotaan</dt>
          <dd class="mt-1 text-sm font-semibold text-slate-900">{labelStatusKeanggotaan(anggota.status_aktif)}</dd>
        </div>
        <div class="border-b border-slate-100 p-5">
          <dt class="text-xs font-bold uppercase text-slate-500">Role</dt>
          <dd class="mt-1 text-sm font-semibold text-slate-900">{anggota.role || 'KRAMA'}</dd>
        </div>
        <div class="border-b border-slate-100 p-5">
          <dt class="text-xs font-bold uppercase text-slate-500">Nomor HP</dt>
          <dd class="mt-1 text-sm text-slate-900">{anggota.no_hp || '-'}</dd>
        </div>
        <div class="border-b border-slate-100 p-5">
          <dt class="text-xs font-bold uppercase text-slate-500">Tempekan</dt>
          <dd class="mt-1 text-sm text-slate-900">{anggota.tempekan || '-'}</dd>
        </div>
        <div class="border-b border-slate-100 p-5 sm:col-span-2">
          <dt class="text-xs font-bold uppercase text-slate-500">Alamat</dt>
          <dd class="mt-1 whitespace-pre-wrap text-sm text-slate-900">{anggota.alamat || '-'}</dd>
        </div>
        <div class="p-5">
          <dt class="text-xs font-bold uppercase text-slate-500">Umur</dt>
          <dd class="mt-1 text-sm text-slate-900">{hitungUmur(anggota.tanggal_lahir)}</dd>
        </div>
      </dl>
    </section>

    <section class="space-y-4">
      <div>
        <h2 class="text-lg font-bold text-slate-900">Kewajiban & Tunggakan</h2>
        <p class="mt-1 text-sm text-slate-500">Rincian kewajiban yang belum lunas, termasuk denda dan sisa pembayaran.</p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-5">
          <p class="text-xs font-bold uppercase text-amber-800">Total Sisa Tunggakan</p>
          <p class="mt-2 text-2xl font-black text-amber-950">{formatRupiah(totalTunggakan)}</p>
        </div>
        <div class="rounded-xl border border-red-200 bg-red-50 p-5">
          <p class="text-xs font-bold uppercase text-red-800">Sisa Denda</p>
          <p class="mt-2 text-2xl font-black text-red-950">{formatRupiah(totalDenda)}</p>
        </div>
      </div>

      <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
          <table id="krama-detail-ledger-table" class="w-full text-left text-sm text-slate-700">
            <thead class="bg-slate-50 text-xs uppercase text-slate-500">
              <tr>
                <th class="p-3">Tanggal</th>
                <th class="hidden p-3 sm:table-cell">No. Bukti</th>
                <th class="p-3">Keterangan</th>
                <th class="p-3 text-right">Debet</th>
                <th class="p-3 text-right">Kredit</th>
                <th class="p-3 text-right">Saldo</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {ledgerRows.length ? ledgerRows.map((row) => (
                <tr class="krama-detail-ledger-row">
                  <td class="whitespace-nowrap p-3">{row.tanggal || '-'}</td>
                  <td class="hidden whitespace-nowrap p-3 font-mono text-xs font-semibold sm:table-cell">{row.noBukti}</td>
                  <td class="max-w-sm whitespace-pre-wrap p-3">{row.keterangan}</td>
                  <td class="whitespace-nowrap p-3 text-right font-semibold text-red-800">{row.debit > 0 ? formatRupiah(row.debit) : '-'}</td>
                  <td class="whitespace-nowrap p-3 text-right font-semibold text-emerald-800">{row.kredit > 0 ? formatRupiah(row.kredit) : '-'}</td>
                  <td class="whitespace-nowrap p-3 text-right font-bold">{formatRupiah(row.saldo)}</td>
                </tr>
              )) : (
                <tr>
                  <td colspan="6" class="p-8 text-center text-slate-500">Belum ada catatan tagihan.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
        {ledgerRows.length > 0 && (
          <div id="krama-detail-pagination" class="mt-4 flex flex-col gap-3 border-t border-slate-100 px-4 pb-4 pt-4 sm:flex-row sm:items-center sm:justify-between">
            <p id="krama-detail-summary" class="text-xs text-slate-500"></p>
            <div class="flex items-center justify-between gap-2 sm:justify-end">
              <button id="krama-detail-prev" type="button" aria-label="Halaman sebelumnya" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">
                <span aria-hidden="true" class="sm:hidden">←</span>
                <span class="hidden sm:inline">Sebelumnya</span>
              </button>
              <div id="krama-detail-pages" class="flex items-center gap-1"></div>
              <button id="krama-detail-next" type="button" aria-label="Halaman berikutnya" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">
                <span aria-hidden="true" class="sm:hidden">→</span>
                <span class="hidden sm:inline">Berikutnya</span>
              </button>
            </div>
          </div>
        )}
      </div>
    </section>
  </main>

  <button
    id="krama-detail-scroll-top"
    type="button"
    aria-label="Kembali ke atas"
    title="Kembali ke atas"
    class="fixed bottom-5 right-4 z-50 flex h-11 w-11 translate-y-4 items-center justify-center rounded-full bg-slate-900 text-xl font-bold text-white opacity-0 shadow-lg transition-all duration-300 hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-amber-400 sm:bottom-6 sm:right-6 sm:h-12 sm:w-12 pointer-events-none"
  >↑</button>

  <script>
    const detailTable = document.getElementById('krama-detail-ledger-table');
    const detailPagination = document.getElementById('krama-detail-pagination');

    if (detailTable && detailPagination) {
      const detailRows = Array.from(detailTable.querySelectorAll<HTMLTableRowElement>('tbody .krama-detail-ledger-row'));
      const detailSummary = document.getElementById('krama-detail-summary');
      const detailPages = document.getElementById('krama-detail-pages');
      const detailPrevious = document.getElementById('krama-detail-prev') as HTMLButtonElement | null;
      const detailNext = document.getElementById('krama-detail-next') as HTMLButtonElement | null;
      const pageSize = 10;
      let currentPage = 1;

      const renderDetailPagination = () => {
        const pageCount = Math.max(1, Math.ceil(detailRows.length / pageSize));
        currentPage = Math.min(Math.max(currentPage, 1), pageCount);
        const start = (currentPage - 1) * pageSize;
        const end = Math.min(start + pageSize, detailRows.length);
        detailRows.forEach((row, index) => row.classList.toggle('hidden', index < start || index >= end));

        if (detailSummary) detailSummary.textContent = `Menampilkan ${start + 1}-${end} dari ${detailRows.length} rincian`;
        if (detailPrevious) detailPrevious.disabled = currentPage <= 1;
        if (detailNext) detailNext.disabled = currentPage >= pageCount;

        if (detailPages) {
          detailPages.replaceChildren();
          const first = Math.max(1, currentPage - 2);
          const last = Math.min(pageCount, first + 4);
          for (let page = first; page <= last; page += 1) {
            const button = document.createElement('button');
            button.type = 'button';
            button.textContent = String(page);
            button.className = page === currentPage
              ? 'min-w-8 rounded-lg bg-slate-900 px-2 py-2 text-xs font-bold text-white'
              : 'min-w-8 rounded-lg border border-slate-200 px-2 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50';
            button.setAttribute('aria-current', page === currentPage ? 'page' : 'false');
            button.addEventListener('click', () => {
              currentPage = page;
              renderDetailPagination();
            });
            detailPages.append(button);
          }
        }
      };

      detailPrevious?.addEventListener('click', () => { currentPage -= 1; renderDetailPagination(); });
      detailNext?.addEventListener('click', () => { currentPage += 1; renderDetailPagination(); });
      renderDetailPagination();
    }

    const detailScrollTop = document.getElementById('krama-detail-scroll-top');
    if (detailScrollTop) {
      const updateDetailScrollTop = () => {
        const shouldShow = window.scrollY > 300;
        detailScrollTop.classList.toggle('opacity-0', !shouldShow);
        detailScrollTop.classList.toggle('pointer-events-none', !shouldShow);
        detailScrollTop.classList.toggle('translate-y-4', !shouldShow);
        detailScrollTop.classList.toggle('opacity-100', shouldShow);
        detailScrollTop.classList.toggle('translate-y-0', shouldShow);
      };
      window.addEventListener('scroll', updateDetailScrollTop, { passive: true });
      detailScrollTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      updateDetailScrollTop();
    }
  </script>
</LayoutDashboard>
