---
import LayoutDashboard from '../../layouts/LayoutDashboard.astro';
import ProfilePhoto from '../../components/common/ProfilePhoto.astro';
import { getGoogleDriveImageUrl } from '../../lib/googleDrivePublic';
import { supabase } from '../../lib/supabase';
import { createSupabaseAdminClient } from '../../lib/supabaseAdmin';

const accessToken = Astro.cookies.get('sb-access-token')?.value;
const { data: { user } } = accessToken
  ? await supabase.auth.getUser(accessToken)
  : { data: { user: null } };
const { data: viewer } = user
  ? await supabase.from('anggota').select('role').eq('user_id', user.id).maybeSingle()
  : { data: null };

const dataClient = createSupabaseAdminClient();
const { data: anggotaList, error } = await dataClient
  .from('anggota')
  .select('id, nama_lengkap, no_regu, no_hp, alamat, role, foto_url, foto, foto_drive_id')
  .order('nama_lengkap', { ascending: true });

const anggota = anggotaList || [];
const nomorRegu = [...new Set(anggota.map((item) => item.no_regu?.trim()).filter((value): value is string => Boolean(value)))]
  .sort((left, right) => left.localeCompare(right, 'id', { numeric: true, sensitivity: 'base' }));
const requestedRegu = Astro.url.searchParams.get('regu')?.trim() || '';
const selectedRegu = nomorRegu.includes(requestedRegu) ? requestedRegu : '';
const anggotaRegu = selectedRegu
  ? anggota.filter((item) => item.no_regu?.trim() === selectedRegu)
  : [];
---

<LayoutDashboard title="Direktori Regu - Banjar Adat" role={viewer?.role || 'PENGURUS'}>
  <main class="mx-auto max-w-7xl space-y-6 px-4 sm:px-6 lg:px-8">
    <header class="flex flex-col gap-4 rounded-xl border border-slate-800 bg-slate-900 p-6 text-white sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase text-amber-400">Direktori Banjar</p>
        <h1 class="mt-1 text-2xl font-black">Direktori Regu</h1>
        <p class="mt-2 text-sm text-slate-300">Pilih nomor regu untuk melihat daftar anggotanya.</p>
      </div>
      <a href="/pengurus/dashboard" class="inline-flex items-center justify-center gap-2 self-start rounded-lg border border-slate-600 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-slate-800 sm:self-auto">
        <span aria-hidden="true">&larr;</span> Kembali ke Dashboard
      </a>
    </header>

    {error && (
      <p role="alert" class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800">
        Gagal memuat direktori regu: {error.message}
      </p>
    )}

    <section class="space-y-5 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <form method="GET" class="max-w-sm space-y-2">
        <label for="regu" class="block text-xs font-bold uppercase text-slate-600">Nomor regu</label>
        <select
          id="regu"
          name="regu"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-800 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
          onchange="this.form.requestSubmit()"
        >
          <option value="">Pilih nomor regu</option>
          {nomorRegu.map((nomor) => <option value={nomor} selected={selectedRegu === nomor}>Regu {nomor}</option>)}
        </select>
      </form>

      {selectedRegu ? (
        <>
          <div class="border-t border-slate-100 pt-4">
            <h2 class="text-lg font-black text-slate-900">Regu {selectedRegu}</h2>
            <p class="mt-1 text-sm text-slate-500">{anggotaRegu.length} anggota</p>
          </div>
          {anggotaRegu.length ? (
            <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
              {anggotaRegu.map((item) => (
                <li class="flex gap-4 rounded-lg border border-slate-200 p-4">
                  <ProfilePhoto
                    src={getGoogleDriveImageUrl(item.foto_url || item.foto || item.foto_drive_id)}
                    alt={`Foto ${item.nama_lengkap}`}
                    fallbackText={item.nama_lengkap?.trim().charAt(0).toLocaleUpperCase('id-ID') || '?'}
                    className="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full bg-amber-100"
                    imageClass="h-full w-full object-cover"
                    fallbackClass="flex h-full w-full items-center justify-center rounded-full text-xl font-black text-amber-900"
                  />
                  <dl class="min-w-0 space-y-2 text-sm">
                    <div>
                      <dt class="sr-only">Nama</dt>
                      <dd class="break-words font-bold text-slate-900">{item.nama_lengkap || '-'}</dd>
                    </div>
                    <div>
                      <dt class="text-[10px] font-bold uppercase text-slate-500">Kontak</dt>
                      <dd class="break-words text-slate-700">
                        {item.no_hp
                          ? <a href={`tel:${item.no_hp}`} class="hover:text-blue-700 hover:underline">{item.no_hp}</a>
                          : '-'}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-[10px] font-bold uppercase text-slate-500">Alamat</dt>
                      <dd class="whitespace-pre-wrap break-words text-slate-700">{item.alamat || '-'}</dd>
                    </div>
                    <div>
                      <dt class="text-[10px] font-bold uppercase text-slate-500">Role</dt>
                      <dd class="text-slate-700">{item.role || 'KRAMA'}</dd>
                    </div>
                  </dl>
                </li>
              ))}
            </ul>
          ) : (
            <p class="rounded-lg bg-slate-50 px-4 py-6 text-center text-sm text-slate-500">Belum ada anggota pada regu ini.</p>
          )}
        </>
      ) : (
        <p class="rounded-lg bg-slate-50 px-4 py-6 text-center text-sm text-slate-500">
          {nomorRegu.length ? 'Pilih nomor regu untuk menampilkan anggotanya.' : 'Belum ada nomor regu yang terdaftar.'}
        </p>
      )}
    </section>
  </main>
</LayoutDashboard>
