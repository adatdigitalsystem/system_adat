---
import LayoutDashboard from '../../layouts/LayoutDashboard.astro';
import { supabase } from '../../lib/supabase';

// Ambil data setoran masuk dari kepala regu
const { data: setoranList } = await supabase
  .from('setoran_regu')
  .select('*, anggota(nama_lengkap)')
  .order('created_at', { ascending: false });

// Ambil data event adat aktif
const { data: eventList } = await supabase
  .from('event_adat')
  .select('*')
  .order('tanggal_event', { ascending: false });

const formatRupiah = (val: number) => 
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);
---

<LayoutDashboard title="Portal Pengurus & Admin - Banjar Adat">
  <div class="max-w-7xl mx-auto p-6 space-y-8">
    
    <!-- Header Admin/Pengurus -->
    <div class="bg-slate-900 text-white p-6 rounded-2xl shadow flex justify-between items-center">
      <div>
        <span class="text-xs font-bold px-3 py-1 bg-blue-500/20 text-blue-400 border border-blue-500/30 rounded-full">
          Portal Pengurus & Bendahara
        </span>
        <h1 class="text-xl font-black mt-2">Verifikasi Keuangan & Manajemen Event Adat</h1>
      </div>
      <form action="/api/auth/logout" method="POST" class="m-0">
        <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-xl transition">
          Keluar
        </button>
      </form>
    </div>

    <!-- Bagian 1: Verifikasi Setoran Kepala Regu -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
      <h2 class="text-base font-bold text-slate-800">Verifikasi Setoran Kepala Regu (One-Click Approve)</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left text-slate-600">
          <thead class="bg-slate-50 text-slate-500 uppercase border-b border-slate-200">
            <tr>
              <th class="p-3">Regu</th>
              <th class="p-3">Kepala Regu</th>
              <th class="p-3 text-right">Total Nominal Tunai</th>
              <th class="p-3 text-center">Status</th>
              <th class="p-3 text-center">Aksi Verifikasi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {setoranList && setoranList.length > 0 ? (
              setoranList.map((setoran) => (
                <tr class="hover:bg-slate-50">
                  <td class="p-3 font-semibold text-slate-900">Regu {setoran.no_regu}</td>
                  <td class="p-3">{setoran.anggota?.nama_lengkap || '-'}</td>
                  <td class="p-3 text-right font-bold text-slate-900">{formatRupiah(setoran.total_nominal)}</td>
                  <td class="p-3 text-center">
                    <span class={`px-2.5 py-1 font-bold rounded-full text-[10px] ${
                      setoran.status_verifikasi === 'VERIFIED' ? 'bg-emerald-100 text-emerald-800' : setoran.status_verifikasi === 'REJECTED' ? 'bg-red-100 text-red-800' : 'bg-amber-100 text-amber-800'
                    }`}>
                      {setoran.status_verifikasi}
                    </span>
                  </td>
                  <td class="p-3 text-center">
                    {setoran.status_verifikasi === 'PENDING' ? (
                      <button class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg text-xs transition">
                        Approve Terima Tunai
                      </button>
                    ) : (
                      <span class="text-slate-400 italic">Sudah Diterima</span>
                    )}
                  </td>
                </tr>
              ))
            ) : (
              <tr>
                <td colspan="5" class="p-6 text-center text-slate-400 italic">Belum ada rekap setoran dari kepala regu.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Bagian 2: Manajemen Event Adat & Master Data Tarif -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Form Tambah Event Adat -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
        <h2 class="text-sm font-bold text-slate-800">Buat Event Adat Baru</h2>
        <form class="space-y-3">
          <div>
            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Nama Event</label>
            <input type="text" placeholder="Contoh: Piodalan Pura Desa" class="w-full text-xs p-2.5 rounded-xl border border-slate-200 bg-slate-50" />
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Jenis Event</label>
            <select class="w-full text-xs p-2.5 rounded-xl border border-slate-200 bg-slate-50">
              <option value="PIODALAN">Piodalan</option>
              <option value="KEMATIAN">Kematian (Sumbangan Wajib)</option>
              <option value="PERNIKAHAN">Pernikahan</option>
              <option value="LAINNYA">Lainnya</option>
            </select>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Tarif Default Per Krama (Rp)</label>
            <input type="number" placeholder="50000" class="w-full text-xs p-2.5 rounded-xl border border-slate-200 bg-slate-50" />
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Tanggal Event</label>
            <input type="date" class="w-full text-xs p-2.5 rounded-xl border border-slate-200 bg-slate-50" />
          </div>
          <button type="submit" class="w-full py-2.5 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs rounded-xl transition">
            Generate Tagihan ke Seluruh Krama
          </button>
        </form>
      </div>

      <!-- Daftar Event Aktif -->
      <div class="lg:col-span-2 bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
        <h2 class="text-sm font-bold text-slate-800">Daftar Event Adat & Tarif Berjalan</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-xs text-left text-slate-600">
            <thead class="bg-slate-50 text-slate-500 uppercase border-b border-slate-200">
              <tr>
                <th class="p-3">Nama Event</th>
                <th class="p-3">Jenis</th>
                <th class="p-3 text-right">Tarif Default</th>
                <th class="p-3 text-center">Tanggal</th>
                <th class="p-3 text-center">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {eventList && eventList.length > 0 ? (
                eventList.map((evt) => (
                  <tr class="hover:bg-slate-50">
                    <td class="p-3 font-semibold text-slate-900">{evt.nama_event}</td>
                    <td class="p-3">{evt.jenis_event}</td>
                    <td class="p-3 text-right font-bold text-slate-900">{formatRupiah(evt.tarif_default)}</td>
                    <td class="p-3 text-center">{evt.tanggal_event}</td>
                    <td class="p-3 text-center">
                      <span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 font-bold rounded-full text-[10px]">
                        {evt.status}
                      </span>
                    </td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colspan="5" class="p-6 text-center text-slate-400 italic">Belum ada event adat yang terdaftar.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

    </div>

  </div>
</LayoutDashboard>